# Nombres de variable, nunca valores.
#
# Este archivo SÍ se commitea (.gitignore lo exceptúa con !.env.example).
# El .env real NO. Para llenarlo:
#
#     ./scripts/set-keys.sh            local
#     ./scripts/set-keys.sh --remote   local + Cloudflare
#
# Nunca pegues una llave en la línea de comandos, en un commit ni en un chat:
# queda en el historial. Si eso pasa, la llave está quemada — se ROTA, no se
# borra. Un secreto commiteado sigue en el historial de git para siempre.

# Arte de Larry y de la Sabana. Herramienta oficial: mantiene la continuidad
# del avatar, que se generó ahí (CLAUDE.md § Imágenes).
RECRAFT_API_KEY=

# Piezas complejas de interfaz (Gemini / Nano Banana).
GOOGLE_AI_API_KEY=

# Larry Profe: explicaciones del tutor (D-015) y moderación de prendas (D-029).
# En producción va por AI Gateway, para caché, tope de gasto y ruteo de modelo.
ANTHROPIC_API_KEY=
