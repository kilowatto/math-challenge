#!/usr/bin/env bash
# Gancho pre-commit — la flota de auditores.
#
# Sustituye a CI. D-032 dice que los deterministas "bloquean por defecto", y sin
# algo que los ejecute solo corren cuando alguien se acuerda — que es justo
# cuando no hacen falta.
#
# Se activa una vez por clon:   git config core.hooksPath .githooks
# Para saltarlo en una emergencia:  git commit --no-verify
# (y entonces D-032 pide escribir por qué en el cuerpo del commit)

set -euo pipefail

echo "── auditores deterministas (D-032)"

if ! node audits/run.mjs; then
  echo
  echo "✗ commit bloqueado por un auditor."
  echo "  Anularlo exige --no-verify Y escribir la razón en el commit (D-032)."
  exit 1
fi
