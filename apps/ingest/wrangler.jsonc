{
  "$schema": "../../node_modules/wrangler/config-schema.json",

  // Prefijo obligatorio (CLAUDE.md § Cloudflare). El auditor cf-prefix lo cruza
  // contra el inventario de docs/infrastructure.md.
  "name": "math-challenge-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",

  "observability": { "enabled": true },

  // Sin `routes`: este Worker NO se expone a internet. Solo se alcanza por RPC
  // desde math-challenge-web a través del service binding. Un Worker de ingesta
  // con URL pública es una superficie de ataque que no necesitamos.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "math-challenge-db",
      "database_id": "25276cac-2d48-4771-87c1-f58bc8722b4e",
      "migrations_dir": "../../migrations"
    }
  ],

  // Los intentos crudos van aquí, no a D1 (mc-32 riesgo #1).
  "analytics_engine_datasets": [
    { "binding": "ATTEMPTS_AE", "dataset": "math-challenge-attempts-ae" }
  ],

  // Una sesión de reto = una instancia. NUNCA una global: un Durable Object es
  // de un solo hilo, así que uno global pondría todos los retos del producto
  // detrás de una cola (mc-32). `audits/do-por-entidad.mjs` lo hace cumplir.
  "durable_objects": {
    "bindings": [
      { "name": "SESION_RETO_DO", "class_name": "SesionReto" }
    ]
  },

  // ─── El cierre semanal de ligas (F7 #241) ─────────────────────────────────
  //
  // Lunes 00:10 UTC: la semana de liga es UTC y cierra al empezar el lunes
  // (`semanaDe` en packages/motor/src/liga.ts); diez minutos después este cron
  // crea la instancia del Workflow. El margen no es superstición: un cron a las
  // 00:00 en punto puede adelantarse unos segundos y cerrar la semana que aún
  // no termina.
  "triggers": { "crons": ["10 0 * * MON"] },

  // El Workflow hace el cierre cohorte por cohorte, con reintentos por paso —
  // un cron desnudo que muere a medias deja cohortes en estado inconsistente
  // (#241, criterio literal). La clase vive en src/ciclo-liga.ts y sale por el
  // módulo de entrada. Nombre con prefijo, como todo objeto de la cuenta.
  "workflows": [
    {
      "name": "math-challenge-league-cycle-workflow",
      "binding": "LEAGUE_CYCLE_WORKFLOW",
      "class_name": "CicloLigaSemanal"
    }
  ],

  // SQLite y no el almacenamiento clásico de clave-valor: es el que Cloudflare
  // recomienda para objetos nuevos y el único con `new_sqlite_classes`.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SesionReto"] }
  ]
}
