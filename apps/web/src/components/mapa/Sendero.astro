---
/**
 * KINDER — el sendero de la Sabana. #232, D-019, D-152.
 *
 * ─── Envoltura, no un mapa nuevo ───────────────────────────────────────────
 *
 * Los 14 lugares y sus ~30 piezas de arte son presupuesto cerrado de D-019/F5.
 * F7 no autora ni un lugar ni una pieza: pinta el estado de los que ya existen.
 * Primer criterio de #232, y por eso este archivo no encarga nada.
 *
 * ─── Enrutado (D-152): un toque en el lugar lleva al reto ──────────────────
 *
 * El mapa es el catálogo visual de niveles, estilo mapa de Angry Birds: el
 * lugar en curso y los terminados son **un enlace de verdad** (`<a>`, no un div
 * con un gesto encima), y los completados se pueden rejugar siempre — nada se
 * bloquea hacia atrás. Los lugares por visitar SE VEN y no se pisan: no es un
 * candado visual de castigo (guía de estilo § mapa), es sencillamente
 * no-enlace.
 *
 * Quien decide el destino es la PÁGINA, que lo recibe de `lib/mapa-kids.ts`
 * (probado en `mapa-kids.prueba.mjs`). Sin la propiedad `destinoDe`, este
 * componente pinta exactamente lo que pintaba antes: círculos que se miran.
 *
 * La dificultad la sigue eligiendo el motor (D-017): el enlace lleva el id del
 * lugar y nada más. El mapa presenta lugares; no pregunta niveles.
 *
 * ─── Ni un número. Ni una palabra que el niño tenga que leer ──────────────
 *
 * El usuario tiene cuatro años y **no lee** (D-019). Lo que distingue un lugar
 * de otro aquí es el DIBUJO del lugar, el relleno y el borde, no texto — la
 * Sabana no habla, y el arte se autora una vez para los siete locales.
 *
 * La garantía no vive en este archivo: `construirSendero()` devuelve un modelo
 * de vista **sin un solo campo numérico** (`packages/motor/src/mapa.ts`), así
 * que no hay un porcentaje que una plantilla pueda pintar por descuido. Es lo
 * que `mapa.prueba.mjs` recorre a cualquier profundidad buscando un `number`.
 *
 * Lo que sí lleva texto es el **nombre accesible** de cada lugar: es para el
 * lector de pantalla y para el adulto que mira por encima del hombro, no para
 * el niño — y no contiene ninguna cifra, que es lo que
 * `audits/mapa-sin-numero-de-nivel.mjs` comprueba.
 *
 * ─── El arte por lugar ─────────────────────────────────────────────────────
 *
 * `arte-lugares.json` lo escribe `scripts/gen-mapa.mjs` (Recraft, AVIF + WebP,
 * `mc-47` §5). Donde el arte existe, el lugar se pinta con su imagen; donde no,
 * se queda el círculo de siempre — un hueco que se ve es un hueco que se
 * llena. La imagen es decorativa (`alt=""`): el nombre accesible ya lo da el
 * `aria-label`, y anunciar «imagen» dos veces sobra.
 *
 * ─── Un lugar sin visitar no es un fracaso ─────────────────────────────────
 *
 * Nada se tacha, nada se apaga a gris muerto, y perder una racha no regresa el
 * sendero (`mc-43` implicación 7: *streak loss never erases or visually
 * regresses the progress map*). Un lugar por visitar es un círculo vacío.
 */
import { t, type Locale } from "../../i18n";
import Companero from "./Companero.astro";
import ARTE from "./arte-lugares.json";
import type { LugarDelSendero, Sendero } from "../../../../../packages/motor/src/mapa.ts";

interface Props {
  locale: Locale;
  sendero: Sendero;
  /** Si el compañero se pinta. En KINDER Larry camina: es el mapa (D-080). */
  companeroVisible: boolean;
  accesorios?: readonly string[];
  /**
   * El destino de cada lugar, o `null` si no se pisa (D-152). Sin esta
   * propiedad el sendero se pinta sin enlaces, como siempre — la decisión de
   * enrutar es de la página, no de la pieza.
   */
  destinoDe?: (lugar: LugarDelSendero) => string | null;
}

const { locale, sendero, companeroVisible, accesorios = [], destinoDe } = Astro.props;
const m = t(locale);

/**
 * El nombre accesible de cada estado. Tres cadenas, ninguna con una cifra.
 *
 * Se resuelve aquí y no en el motor porque el motor no habla: `mapa.ts` guarda
 * claves y estados, y el texto vive en los siete locales (misma regla que
 * `cosmeticos.ts` con las claves i18n).
 */
const NOMBRE: Record<string, string> = {
  terminado: m.mapaLugarTerminado,
  en_curso: m.mapaLugarEnCurso,
  por_visitar: m.mapaLugarPorVisitar,
};

/** Qué lugares tienen arte generado. Lo escribe `scripts/gen-mapa.mjs`. */
const CON_ARTE: Record<string, boolean> = ARTE;
---

<ol class="sendero" aria-label={m.mapaSenderoNombre}>
  {
    sendero.lugares.map((l) => {
      const destino = destinoDe?.(l) ?? null;
      const nombre = l.aqui ? `${NOMBRE[l.estado]} — ${m.mapaAqui}` : NOMBRE[l.estado];
      const contenido = (
        <Fragment>
          {CON_ARTE[l.lugar] === true && (
            <picture>
              <source srcset={`/mapa/${l.lugar}.avif`} type="image/avif" />
              <img
                class="sendero__arte"
                src={`/mapa/${l.lugar}.webp`}
                alt=""
                width="512"
                height="512"
                loading="lazy"
                decoding="async"
              />
            </picture>
          )}
          {l.aqui && (
            <Companero locale={locale} visible={companeroVisible} forma="caminando" accesorios={accesorios} />
          )}
        </Fragment>
      );
      return (
        <li
          class="sendero__lugar"
          data-estado={l.estado}
          data-aqui={l.aqui ? "si" : "no"}
          aria-label={destino === null ? nombre : undefined}
        >
          {destino !== null ? (
            <a class="sendero__enlace" href={destino} aria-label={nombre}>
              {contenido}
            </a>
          ) : (
            contenido
          )}
        </li>
      );
    })
  }
</ol>
