---
/**
 * La pantalla de un reto. UNA sola, para el niño y para el adulto.
 *
 * ─── Por qué es un componente y no dos páginas ─────────────────────────────
 *
 * Existía solo dentro de `/app/kids/jugar/`, detrás de: tener un hijo creado,
 * haber marcado el aparato como de la casa, elegir una cara y teclear un PIN de
 * imágenes. Cinco puertas, todas del modo FAMILIA.
 *
 * Y Math Challenge no es un producto para padres: es para cualquiera que quiera
 * hacer retos, **incluido el contenido de kinder**, que no es «de niños» sino el
 * principio de la escalera y hoy lo único que el banco tiene. Alguien sin hijos
 * no podía jugar nada, y el dueño lo dijo más de una vez.
 *
 * El motor NUNCA fue el problema: `/api/jugar` ya acepta una sesión de adulto y
 * usa `userId` como identidad del modelo, separada de la de cualquier hijo.
 * Comprobado en producción antes de escribir esta línea — devolvió un ítem real
 * («¿Cuántos patitos viste?», formato flash) a un adulto sin un solo hijo.
 *
 * Lo único que faltaba era la pantalla. Copiarla habría dejado dos, y la
 * segunda se queda sin los arreglos de la primera; así que se extrajo esta y
 * las dos páginas la usan.
 *
 * ─── Lo único que cambia entre las dos ─────────────────────────────────────
 *
 * `salirA`. Un niño vuelve a la reja de caras; un adulto vuelve a su casa. Nada
 * más difiere: mismo motor, mismos formatos, mismo CSS, misma retroalimentación
 * de Larry. Un adulto que practica no es un caso especial del producto.
 */
/*
 * ─── Las hojas van AQUÍ, no en cada página ─────────────────────────────────
 *
 * `reto.css` define la maquetación del reto y `--tap-kinder`, pero **ni un solo
 * color**: `--color-surface`, `--color-text`, `--color-border` y
 * `--color-accent` viven en `tokens.css`, y la pantalla del niño no lo
 * importaba. Medido sobre el HTML servido: `--color-surface:` aparecía **cero**
 * veces mientras el CSS lo usaba.
 *
 * Un `var()` sin definir no es un color por defecto: la declaración entera
 * queda inválida en tiempo de cómputo. Los bordes de 3px de los botones de
 * respuesta desaparecían, el fondo dejaba de ser la superficie de marca, y la
 * pantalla donde el niño contesta se veía como HTML sin diseñar — igual que
 * pasó con el layout privado, dos veces.
 *
 * Y `fonts.css`, porque `reto.css` pide `var(--font-sistema)` para los
 * controles (D-036) y esa variable también vive fuera de este archivo.
 *
 * Van en el componente y no en las dos páginas a propósito: dos copias es cómo
 * una se queda sin el arreglo de la otra.
 */
import "../../styles/fonts.css";
import "../../styles/tokens.css";
import "../../styles/reto.css";

interface Props {
  locale: string;
  /** Los rótulos ya resueltos por locale. Los arma la página. */
  rotulos: Record<string, string>;
  /** A dónde lleva «terminar»: la reja de caras, o la casa. */
  salirA: string;
}
const { locale, rotulos, salirA } = Astro.props as Props;
---

  <main class="reto" data-locale={locale}>
    <h1 class="visualmente-oculto">{rotulos.mirar}</h1>

    {/*
      `aria-live="polite"` y no `assertive`: un lector de pantalla debe
      anunciar el ítem nuevo cuando termine lo que está diciendo, no cortarlo
      a media frase. A un niño que depende del lector, cortarlo es perder el
      enunciado entero.
    */}
    <p id="enunciado" class="enunciado" aria-live="polite">{rotulos.cargando}</p>

    <div id="escena" class="escena"></div>

    <div id="opciones" class="opciones" role="group" aria-labelledby="enunciado"></div>

    <p id="veredicto" class="veredicto" hidden></p>

    <div class="acciones">
      <button type="button" id="siguiente" class="opcion accion" hidden>{rotulos.siguiente}</button>
      <a href={salirA} class="opcion accion salir">{rotulos.salir}</a>
    </div>
  </main>

  <style>
    /*
      Sin `Base.astro` a propósito, igual que la rejilla de caras: la barra de
      navegación de adulto no aparece en una superficie de niño.
    */
    .jugar-body {
      margin: 0;
      min-height: 100dvh;
      background: var(--color-surface);
      padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom)
        env(safe-area-inset-left);
    }
    /*
      Sin `overflow: hidden`: `clip-path` ya lo esconde, y la pareja
      alto-fijo + overflow es justo la forma que `audits/espaciado-tolerante.mjs`
      prohíbe —el texto se corta en vez de crecer cuando alguien sube el
      espaciado (WCAG 1.4.12)—. El auditor lo marcó aquí y tenía razón aunque
      el destino de este texto sea no verse: un lector de pantalla sí lo lee.
    */
    .visualmente-oculto {
      position: absolute;
      width: 1px;
      height: 1px;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .enunciado {
      font-family: var(--font-marca);
      font-size: clamp(1.35rem, 5vw, 2rem);
      line-height: 1.4;
      text-align: center;
      margin: 0 0 1.25rem;
      color: var(--color-text);
    }
    .escena {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.75rem;
      margin-block-end: 1.5rem;
      min-height: 96px;
    }
    /*
      88px es el piso de mc-20 §201 y `audits/touch-targets.mjs` lo mide contra
      el marcador `@banda KINDER` de este archivo. No se baja aquí ni «solo
      para que quepan cuatro opciones»: si no caben, caben menos opciones.
    */
    .acciones {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
      justify-content: center;
      margin-block-start: 1.75rem;
    }
    .accion {
      min-height: 88px;
      min-width: 88px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding-inline: 1.5rem;
      text-decoration: none;
    }
    .grupo { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; align-items: center; }
    .separador { font-size: 2rem; color: var(--color-text-muted); }
    .pato.chico { font-size: 2rem; }
    .figura { font-size: 2.4rem; line-height: 1; }
    .figura.hueco { color: var(--color-text-muted); }
    .marco-diez { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.3rem; }
    .recta { display: flex; flex-wrap: wrap; gap: 0.25rem; justify-content: center; }
    .casilla { width: 40px; height: 40px; border: 2px solid var(--color-border);
               border-radius: 6px; display: inline-flex; align-items: center; justify-content: center;
               font-family: var(--font-sistema); font-size: 1rem; color: var(--color-text); }
    .casilla.llena { background: var(--color-accent); border-color: transparent; }
    .casilla.hueco { border-style: dashed; color: var(--color-text-muted); }
    /* Las cuatro disposiciones del destello (K01/K02). */
    .escena[data-disposicion="dado"] { display: grid; grid-template-columns: repeat(3, 44px); justify-content: center; }
    .escena[data-disposicion="linea"] { flex-wrap: nowrap; }
    .escena[data-disposicion="par"] { display: grid; grid-template-columns: repeat(2, 44px); justify-content: center; }
    .punto {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-accent);
    }
    .pato {
      font-size: 3rem;
      line-height: 1;
      /* Decorativo: el enunciado ya dice cuántos hay y qué se pregunta. */
      user-select: none;
    }
    @media (prefers-reduced-motion: no-preference) {
      .escena > * { animation: aparece 220ms ease-out both; }
      @keyframes aparece { from { opacity: 0; transform: scale(0.85); } }
    }
  </style>

  <script define:vars={{ locale, rotulos, salirA }}>
    /**
     * El bucle. Pide, pinta, manda, repite.
     *
     * No hay estado del modelo aquí: el servidor lo tiene. Lo único que este
     * script recuerda es qué ítem está en pantalla, y eso solo para poder
     * decir a qué se está respondiendo.
     */
    const $enunciado = document.getElementById("enunciado");
    const $escena = document.getElementById("escena");
    const $opciones = document.getElementById("opciones");
    const $veredicto = document.getElementById("veredicto");
    const $siguiente = document.getElementById("siguiente");

    let actual = null;
    let respondiendo = false;
    /*
      El último ítem contestado. Viaja al servidor como PISTA para no repetirlo
      seguido; la garantía de no repetir en toda la sesión es del servidor y
      todavía no está (ver el encabezado de `/api/jugar`). Aquí no se guarda
      ninguna otra cosa: el modelo es del servidor.
    */
    let ultimoItemId = null;

    const pedir = async (accion, cuerpo) => {
      const r = await fetch(`/api/jugar?accion=${accion}`, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ locale, ...cuerpo }),
      });
      if (r.status === 401) {
        // La sesión de niño dura 12 horas y pudo caducar mientras jugaba. Se
        // vuelve a la rejilla de caras, que es donde sabe volver a entrar —
        // NUNCA a un formulario, que es superficie de adulto (línea roja #2).
        location.href = salirA;
        return null;
      }
      return r.ok ? r.json() : null;
    };

    /** Dibuja la escena de cada formato. Todo decorativo: el texto ya lo dice. */
    /**
     * Dibuja lo que el enunciado pregunta.
     *
     * ─── Por qué esto no es decoración ─────────────────────────────────
     *
     * La primera versión solo dibujaba `flash` y `toca_para_contar`, y con el
     * banco de F5 completo eso dejó **ítems incontestables**: «¿de qué lado
     * hay más?» sin ver los dos lados, «¿cuántas casillas están llenas?» sin
     * ver el marco, «¿cuál no va con los demás?» sin ver las figuras. Un niño
     * de cuatro años no puede decir que la pantalla está incompleta: toca al
     * azar y el motor registra un fallo que no cometió.
     *
     * Se descubrió jugando 30 ítems seguidos contra producción y leyendo lo
     * que salía, no revisando el código — el código estaba bien, le faltaba la
     * mitad del banco.
     */
    const cajita = (clase, texto) => {
      const e = document.createElement("span");
      e.className = clase;
      if (texto) e.textContent = texto;
      return e;
    };

    /** Un grupo de N figuras iguales. */
    function grupo(n, glifo, clase) {
      const g = document.createElement("div");
      g.className = "grupo";
      for (let i = 0; i < n; i++) g.append(cajita(clase, glifo));
      return g;
    }

    const FIGURAS = ["●", "▲", "■", "★"];

    function pintarEscena(item) {
      $escena.replaceChildren();
      const v = item.vars ?? {};
      const num = (k) => Number(v[k] ?? 0);

      switch (item.formato) {
        case "flash": {
          const n = num("n");
          /*
            La DISPOSICIÓN es el eje de esta habilidad: cuatro puntos en patrón
            de dado se reconocen de un vistazo y los mismos cuatro dispersos
            obligan a contar. Si todas se dibujaran igual, el banco tendría
            cuatro veces el mismo ítem con cuatro ids distintos.
          */
          $escena.dataset.disposicion = String(v.disposicion ?? "linea");
          for (let i = 0; i < n; i++) $escena.append(cajita("punto"));
          // Se ve y se esconde. NO es un cronómetro: no cuenta hacia atrás, no
          // se muestra y no penaliza. Es la exposición breve que define
          // subitizar.
          setTimeout(() => { $escena.replaceChildren(); }, 900);
          break;
        }
        case "toca_para_contar": {
          const n = num("n");
          for (let i = 0; i < n; i++) $escena.append(cajita("pato", "🦆"));
          break;
        }
        case "arma_el_numero": {
          // El marco de diez (K09) y la descomposición (K10). Diez casillas,
          // las llenas marcadas. Se lee de un vistazo —una fila y dos más— y
          // esa lectura es lo que enseña el diez como referencia.
          const llenas = v.llenas !== undefined ? num("llenas") : num("parte");
          const total = v.llenas !== undefined ? 10 : num("total");
          const marco = document.createElement("div");
          marco.className = "marco-diez";
          for (let i = 0; i < total; i++) {
            marco.append(cajita(i < llenas ? "casilla llena" : "casilla"));
          }
          $escena.append(marco);
          break;
        }
        case "cual_sobra": {
          // K13: tres de una familia y un intruso. El intruso NO va siempre
          // al final — con la posición fija se acierta sin mirar.
          const fam = FIGURAS[num("familia") % FIGURAS.length];
          const intruso = FIGURAS[num("intruso") % FIGURAS.length];
          const donde = (num("familia") + num("intruso")) % 4;
          for (let i = 0; i < 4; i++) {
            $escena.append(cajita("figura", i === donde ? intruso : fam));
          }
          break;
        }
        default: {
          // `toca_la_respuesta` cubre varias habilidades y cada una necesita
          // ver algo distinto.
          if (v.izq !== undefined) {
            // K07: dos montones. El enunciado pregunta de qué lado hay más, y
            // sin los montones la pregunta no existe.
            $escena.append(grupo(num("izq"), "🦆", "pato chico"));
            $escena.append(cajita("separador", "·"));
            $escena.append(grupo(num("der"), "🦆", "pato chico"));
          } else if (v.patos !== undefined) {
            // K05: patos arriba, gorros abajo, para poder emparejar de vista.
            $escena.append(grupo(num("patos"), "🦆", "pato chico"));
            $escena.append(grupo(num("gorros"), "🎩", "pato chico"));
          } else if (v.largo !== undefined) {
            // K14: el patrón, con el hueco al final.
            const ciclo = num("ciclo") || 2;
            const primero = num("primero");
            const fila = document.createElement("div");
            fila.className = "grupo";
            for (let i = 0; i < num("largo"); i++) {
              fila.append(cajita("figura", FIGURAS[(primero + i) % ciclo]));
            }
            fila.append(cajita("figura hueco", "?"));
            $escena.append(fila);
          } else if (v.antes !== undefined || v.despues !== undefined) {
            // K08: la recta del 0 al 10 con un hueco.
            const falta = v.antes !== undefined ? num("antes") + 1 : num("despues") - 1;
            const recta = document.createElement("div");
            recta.className = "recta";
            for (let i = 0; i <= 10; i++) {
              recta.append(cajita(i === falta ? "casilla hueco" : "casilla numero",
                                  i === falta ? "?" : String(i)));
            }
            $escena.append(recta);
          }
          break;
        }
      }
      // Decorativo: el enunciado ya dice qué se pregunta, y un lector de
      // pantalla que enumere veinte casillas no ayuda a nadie.
      $escena.setAttribute("aria-hidden", "true");
    }

    function pintarOpciones(item) {
      $opciones.replaceChildren();
      for (const o of item.opciones) {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "opcion";
        b.textContent = o.texto;
        b.addEventListener("click", () => responder(o.valor));
        $opciones.append(b);
      }
    }

    async function siguiente() {
      respondiendo = false;
      $veredicto.hidden = true;
      $siguiente.hidden = true;
      $enunciado.textContent = rotulos.cargando;
      $escena.replaceChildren();
      $opciones.replaceChildren();

      const r = await pedir("siguiente", { ultimoItemId });
      if (!r?.ok) {
        $enunciado.textContent = rotulos.cargando;
        return;
      }
      actual = r.item;
      $enunciado.textContent = actual.enunciado;
      pintarEscena(actual);
      pintarOpciones(actual);
    }

    async function responder(valor) {
      // Un toque doble no manda dos intentos. Sin esto, el servidor recibe
      // dos respuestas y el modelo cuenta dos veces lo mismo.
      if (respondiendo || !actual) return;
      respondiendo = true;
      for (const b of $opciones.querySelectorAll("button")) b.disabled = true;

      const r = await pedir("responder", { itemId: actual.id, eleccion: valor });
      if (!r) { respondiendo = false; return; }
      ultimoItemId = actual.id;

      /*
       * Lo que se dice, y lo que NO.
       *
       * `r.causa` trae el error con nombre y aquí no se pinta: es material de
       * Larry (F6). Decirle a un niño de cuatro «contaste uno dos veces» sin
       * la voz y el dibujo que lo acompañan es señalarle el error y ya
       * (línea roja #7). Tampoco se pinta `r.nivel` ni `r.etapa`: el niño no
       * ve en qué escalón está (criterio #100).
       */
      $veredicto.textContent = r.correcto ? rotulos.bien : rotulos.otra;
      $veredicto.dataset.acierto = r.correcto ? "1" : "0";
      $veredicto.hidden = false;
      $siguiente.hidden = false;
      $siguiente.focus();
    }

    $siguiente.addEventListener("click", siguiente);
    siguiente();
  </script>
