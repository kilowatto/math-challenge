---
import Rum from "../components/Rum.astro";
/**
 * Layout base del sitio abierto.
 *
 * Hace cumplir de S0:
 *   · hreflang recíproco entre los 7 locales + x-default (mc-48 §3)
 *   · JSON-LD con inLanguage por versión y estructura idéntica entre idiomas
 *   · el esquema COINCIDE con lo visible en la página — si difiere, Google
 *     puede ignorar todo el marcado (mc-48 §3, regla dura)
 *   · atribución en dos mitades verificables: proyecto de Ignia, sobre
 *     Cloudflare (D-033)
 */
import { LOCALES, DEFAULT_LOCALE, t, type Locale } from "../i18n";
import { plataformaDe, navegacionAbajo } from "../lib/plataforma";
import Instalar from "../components/Instalar.astro";
import { ruta, type Seccion } from "../i18n/rutas";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/plataformas.css";

interface Props {
  locale: Locale;
  /** Se pasa explícito para que el JSON-LD no pueda desincronizarse del <title>. */
  title: string;
  description: string;
  /**
   * Qué sección es esta página, o `null` para la portada.
   *
   * **Es una CLAVE, no una ruta**, y ese es el punto entero desde D-049. Antes
   * este prop era `path`, una cadena como `"investigacion/"` que se pegaba igual
   * en los siete locales:
   *
   *     <link rel="alternate" hreflang="de-DE" href="…/de-DE/investigacion/" />
   *
   * Con segmentos traducidos esa línea declara una URL que **no existe** — la
   * alemana es `/de-DE/forschung/`. Un grupo de hreflang que apunta a un 404 se
   * descarta entero, y con él las siete variantes (mc-48 §3). No rompe ninguna
   * página: rompe la indexación, en silencio, meses después.
   *
   * Por eso el layout ya no recibe la ruta armada. Recibe la clave y arma las
   * siete con `ruta()`, que lee la única tabla de segmentos que existe.
   */
  seccion?: Seccion | null;
  /** Slug del documento, para las páginas de artículo del corpus. */
  slug?: string;
}

const { locale, title, description, seccion = null, slug } = Astro.props;
const m = t(locale);
const site = "https://math.kilowatto.com";

/** La ruta de esta página en un locale dado. La portada es solo el prefijo. */
const rutaEn = (l: Locale) => (seccion ? ruta(l, seccion, slug) : `/${l}/`);

const canonical = `${site}${rutaEn(locale)}`;

/**
 * Navegación del sitio abierto, en los 7 locales.
 *
 * Los enlaces se calculan con `ruta()`: en `de-DE` esta barra apunta a
 * `/de-DE/forschung/` y en `fr-FR` a `/fr-FR/recherche/`. Cablearlos aquí sería
 * el segundo lugar donde vive un segmento, y el que se olvidaría de actualizar.
 */
/**
 * La plataforma, resuelta EN EL SERVIDOR. D-031.
 *
 * `docs/guia-de-estilo.md` lo dice sin matiz: «No se detecta la plataforma en
 * JavaScript. Una detección en JS fallaría justo en la primera pintura, que es
 * donde importa.» Un tema aplicado después del primer render es el destello que
 * ve alguien en un Android de gama baja sobre 4G lento.
 *
 * Va en el `<html>` para que el CSS pueda leerlo desde el primer byte, igual que
 * `data-band` en la superficie del niño.
 */
/**
 * ─── MEDIDO: en una página prerenderizada esto SIEMPRE da "otro" ────────────
 *
 * `astro.config.mjs` tiene `output: "static"`, así que la mayoría del sitio se
 * genera en el build — y ahí `Astro.request.headers` no son las cabeceras de
 * nadie. La primera versión resolvía la plataforma aquí y horneaba `otro` en el
 * HTML. Comprobado contra producción con tres cabeceras distintas:
 *
 *     Sec-CH-UA-Platform: "Android"  → data-platform="otro"
 *     User-Agent de iPhone           → data-platform="otro"
 *     Sec-CH-UA-Platform: "macOS"    → data-platform="otro"
 *
 * Se queda para las rutas BAJO DEMANDA —`/app/**`, que sí ven cabeceras— y como
 * valor inicial. Lo corrige el script de abajo, que corre en el `<head>`.
 */
const plataforma = plataformaDe(Astro.request.headers);
const abajo = navegacionAbajo(plataforma);

const NAV: Array<{ seccion: Seccion | null; label: string }> = [
  { seccion: null, label: m.navHome },
  { seccion: "origen", label: m.navOrigin },
  { seccion: "niveles", label: m.navLevels },
  { seccion: "investigacion", label: m.navResearch },
  { seccion: "arquitectura", label: m.navArchitecture },
  { seccion: "codigo-abierto", label: m.navOpen },
];

/**
 * El enlace de registro va APARTE de `NAV`, y no es capricho.
 *
 * Se descubrió mirando el sitio en un teléfono: existían tres puertas de
 * registro desplegadas en siete idiomas y **nada del sitio enlazaba a ninguna**.
 * Había que saberse la URL. Un producto con registro invisible no tiene
 * registro.
 *
 * Va fuera de la lista de secciones porque no es una sección de contenido: es la
 * acción principal, y se pinta como tal —a la derecha, con peso— en vez de como
 * el séptimo enlace de una fila que ya se parte en dos líneas en un móvil.
 */
const REGISTRO: Seccion = "registro-padre";
const ENTRAR: Seccion = "entrar";

/**
 * Una sola navegación primaria a la vez. D-064, `mc-49`.
 *
 * Nació de una captura real de un iPhone: la barra de arriba y la de abajo se
 * pintaban juntas, y en una pestaña de Safari eso son TRES navegaciones
 * apiladas con la del propio navegador. La salida no es una detección de
 * plataforma más fina — ya existe, es `data-platform` — es una segunda señal
 * que hoy falta: si la página corre INSTALADA o en una pestaña. Esa señal es
 * `display-mode`, y por la misma razón que `data-platform` nunca se detecta
 * en JavaScript (`docs/guia-de-estilo.md`), esta tampoco: los cuatro bloques
 * de abajo se pintan siempre, y el CSS decide cuál se ve, sin script y sin
 * destello. Es el mismo mecanismo que ya usa `Instalar.astro`.
 *
 * Los cuatro bloques, y quién los enseña:
 *   1. `.sitio`      — escritorio (macOS/Windows/otro), sin cambio.
 *   2. `.compacto`   — móvil, pestaña de navegador (`display-mode: browser`).
 *   3. `.barra-inferior` + `.mas-instalada` — móvil, instalada, ancho de
 *      teléfono. 5 destinos de un toque en la barra (HIG/M3 no permiten más),
 *      el resto en un `<details>` sin JavaScript.
 *   4. `.riel`       — iPad instalado en horizontal completo (D-041,
 *      1024-1366px). Material 3 documenta que el patrón cambia a un riel
 *      lateral a partir de ahí, no una barra inferior estirada.
 */
const SECCIONES_MAS: Array<{ seccion: Seccion; label: string }> = [
  { seccion: "origen", label: m.navOrigin },
  { seccion: "arquitectura", label: m.navArchitecture },
  { seccion: "codigo-abierto", label: m.navOpen },
];

/** Los 5 de la barra instalada — HIG/M3: 3-5, nunca más. El dueño pidió
    Entrar de un toque, así que no queda slot para una 6ª pestaña "Más". */
const CINCO: Array<{ seccion: Seccion | null; label: string; icono: "inicio" | "niveles" | "investigacion" | "entrar" | "crear-cuenta" }> = [
  { seccion: null, label: m.navHome, icono: "inicio" },
  { seccion: "niveles", label: m.navLevels, icono: "niveles" },
  { seccion: "investigacion", label: m.navResearch, icono: "investigacion" },
  { seccion: ENTRAR, label: m.navSignin, icono: "entrar" },
  { seccion: REGISTRO, label: m.navSignup, icono: "crear-cuenta" },
];

/** Glifos de línea simple, SVG inline con `currentColor` — no son arte de
    Recraft ni pieza de Gemini/Nano Banana (CLAUDE.md § Imágenes): un glifo de
    navegación no es ilustración de marca, y SVG inline no pesa una petición
    HTTP ni entra en la regla de AVIF/WebP, que es para fotografía. */
const GLIFOS: Record<string, string> = {
  inicio: '<path d="M4 11.5 12 4l8 7.5"/><path d="M6 10v9a1 1 0 0 0 1 1h3v-6h4v6h3a1 1 0 0 0 1-1v-9"/>',
  niveles: '<path d="M12 4 3 8.5 12 13l9-4.5Z"/><path d="M6 11.5 3 13l9 4.5 9-4.5-3-1.5"/><path d="M6 15 3 16.5 12 21l9-4.5-3-1.5"/>',
  investigacion: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="m20 20-4.8-4.8"/>',
  entrar: '<path d="M10 17v1a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-6a2 2 0 0 0-2 2v1"/><path d="M3 12h12"/><path d="m11 8 4 4-4 4"/>',
  "crear-cuenta": '<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M18 8v6"/><path d="M15 11h6"/>',
};

// JSON-LD. `name` y `description` vienen de las MISMAS variables que renderiza
// el <body>, no de constantes paralelas: es la única forma de que la regla de
// coincidencia esquema-página no se rompa al editar una sola de las dos.
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${site}/#website`,
      url: site,
      name: title,
      description,
      inLanguage: locale,
      publisher: { "@id": `${site}/#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${site}/#organization`,
      name: "Ignia Cloud",
      url: "https://ignia.cloud",
      description: "Ignia Cloud — proveedor de nube. Math Challenge es un proyecto de Ignia.",
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: title,
      description,
      inLanguage: locale,
      isPartOf: { "@id": `${site}/#website` },
    },
  ],
};
---

<!doctype html>
<html lang={m.htmlLang} data-platform={plataforma}>
  <head>
    {/*
      ─── La plataforma, antes de la primera pintura ───────────────────────
      `docs/guia-de-estilo.md` dice que una detección en JavaScript «fallaría
      justo en la primera pintura». Eso es cierto de un script diferido o de uno
      al final del cuerpo — **no de un script BLOQUEANTE en el `<head>`**, que
      corre antes de que el navegador construya una sola caja. Es el mismo
      patrón con el que se evita el destello al elegir tema.

      Hace falta porque las páginas están prerenderizadas: en el build no hay
      cabeceras de nadie, así que el servidor no puede saber la plataforma. En
      las rutas bajo demanda sí la sabe, y este script confirma lo mismo.

      `is:inline` a propósito: si Astro lo empaquetara, dejaría de ser
      bloqueante y volvería el destello que este bloque existe para evitar.
    */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var ua = navigator.userAgent;
        var uad = navigator.userAgentData;
        var p = "otro";
        var plat = uad && uad.platform ? String(uad.platform).toLowerCase() : "";
        var movil = uad ? !!uad.mobile : /\bMobile\b/.test(ua);
        if (plat) {
          p = plat === "android" ? "android"
            : plat === "ios" ? "ios"
            : plat === "windows" ? "windows"
            // Un «macOS» con marca de móvil es un iPad: desde iPadOS 13 Safari
            // se anuncia como Macintosh, y D-041 lo trata como primera clase.
            : plat === "macos" ? (movil ? "ios" : "macos")
            : "otro";
        } else if (/\bAndroid\b/i.test(ua)) p = "android";
        else if (/\b(iPhone|iPad|iPod)\b/i.test(ua)) p = "ios";
        else if (/\bMacintosh\b/i.test(ua)) p = (navigator.maxTouchPoints > 1) ? "ios" : "macos";
        else if (/\bWindows\b/i.test(ua)) p = "windows";
        d.setAttribute("data-platform", p);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* hreflang recíproco: cada página apunta a TODAS, incluida a sí misma.
        Sin la auto-referencia el ciclo no cierra y Google ignora el grupo. */}
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={l} href={`${site}${rutaEn(l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${site}${rutaEn(DEFAULT_LOCALE)}`} />

    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F36B1C" />
    <link rel="icon" href="/icons/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />

    {/* Raleway autohospedada — ni una petición a un tercero. Ver
        src/styles/fonts.css para el porqué (rendimiento y privacidad).
        Se precarga solo el subconjunto latin: cubre el cuerpo en los siete
        locales, y latin-ext llega después solo si la página tiene acentos. */}
    <link
      rel="preload"
      href="/fonts/raleway-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={locale.replace("-", "_")} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {/* Registro del service worker. Va tras `load` para no competir con el
        primer render — en Android de gama baja, registrar durante el parseo
        roba hilo principal justo cuando INP se está midiendo (mc-47 §4). */}
    <script is:inline>
      if ("serviceWorker" in navigator) {
        addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {
            /* Sin service worker el sitio funciona igual: es mejora, no
               requisito. Chrome ya no lo exige para instalabilidad (mc-33). */
          });
        });
      }
    </script>
  </head>

  <body>
    <a class="skip" href="#main">{m.skipToContent}</a>

    {/* ─── 1. Escritorio (macOS/Windows/otro) — sin cambio de contenido ──────
        D-036: la marca en `--font-marca`, los controles y la navegación en
        `--font-sistema`. Sin JavaScript: cinco enlaces. Oculta en ios/android
        vía CSS (plataformas.css) — ahí viven los bloques 2-4 de abajo. */}
    <nav class="sitio" aria-label={m.navLabel}>
      <ul>
        {NAV.map((item) => (
          <li>
            {item.seccion === seccion && !slug
              ? <span aria-current="page">{item.label}</span>
              : <a href={item.seccion ? ruta(locale, item.seccion) : `/${locale}/`}>{item.label}</a>}
          </li>
        ))}
      </ul>
      <div class="acciones">
        {seccion === ENTRAR
          ? <span class="entrar" aria-current="page">{m.navSignin}</span>
          : <a class="entrar" href={ruta(locale, ENTRAR)}>{m.navSignin}</a>}
        {seccion === REGISTRO
          ? <span class="registro" aria-current="page">{m.navSignup}</span>
          : <a class="registro" href={ruta(locale, REGISTRO)}>{m.navSignup}</a>}
      </div>
    </nav>

    {/* ─── 2. Móvil, pestaña de navegador — `display-mode: browser` ─────────
        Lo que ve la mayoría de las visitas nuevas: la vista que produjo la
        captura que originó D-064. Encabezado compacto: marca + Entrar/Crear
        cuenta SIEMPRE visibles (mismo criterio de un toque que el bloque 3) +
        un <details> que despliega las 6 secciones empujando el contenido —
        nunca un overlay: `mc-49` documenta que los overlays de pantalla
        completa no cierran con el gesto de deslizar en iOS Safari. */}
    <header class="compacto">
      <div class="fila">
        <a class="marca" href={`/${locale}/`}>Math Challenge</a>
        <div class="acciones-compactas">
          {seccion === ENTRAR
            ? <span class="entrar" aria-current="page">{m.navSignin}</span>
            : <a class="entrar" href={ruta(locale, ENTRAR)}>{m.navSignin}</a>}
          {seccion === REGISTRO
            ? <span class="registro" aria-current="page">{m.navSignup}</span>
            : <a class="registro" href={ruta(locale, REGISTRO)}>{m.navSignup}</a>}
        </div>
        <details class="menu">
          <summary aria-label={m.navMenu}>{m.navMenu}</summary>
          <ul>
            {NAV.map((item) => (
              <li>
                {item.seccion === seccion && !slug
                  ? <span aria-current="page">{item.label}</span>
                  : <a href={item.seccion ? ruta(locale, item.seccion) : `/${locale}/`}>{item.label}</a>}
              </li>
            ))}
          </ul>
        </details>
      </div>
    </header>

    {/* ─── 3. Móvil, instalada, ancho de teléfono — `display-mode: standalone` ───
        D-064: 5 destinos, todos de un toque (HIG/M3: 3-5, nunca más). Origen,
        Arquitectura y Código abierto no caben — van en el <details> "Más" de
        la franja superior, con el mismo mecanismo sin JavaScript que el menú
        del bloque 2. Oculto además a partir de 1024px (bloque 4, el riel de
        iPad se hace cargo ahí).

        Va ANTES de <main>, junto a header.compacto, no después: son
        mutuamente excluyentes (nunca los dos instalados a la vez) y los dos
        necesitan la misma franja superior persistente — no solo describirlo
        en el comentario, que es donde se quedó la primera vez. */}
    <div class="mas-instalada">
      <details>
        <summary>{m.navMore}</summary>
        <ul>
          {SECCIONES_MAS.map((item) => (
            <li>
              {item.seccion === seccion && !slug
                ? <span aria-current="page">{item.label}</span>
                : <a href={ruta(locale, item.seccion)}>{item.label}</a>}
            </li>
          ))}
        </ul>
      </details>
    </div>

    <main id="main">
      <slot />
      {/*
        El aviso de instalación va al FINAL del contenido, no arriba: sin
        instalar, el modo avión de D-047 no se sostiene —el navegador expulsa el
        almacenamiento a los siete días—, pero interrumpir la primera lectura
        con una petición es cómo se aprende a ignorarla.

        Nunca en una superficie de niño: este layout no lo es. `app/kids` usa su
        propio árbol, y hay un auditor que lo vigila.
      */}
      <Instalar locale={locale} plataforma={plataforma} />
    </main>

    <nav class="barra-inferior" aria-label={m.navLabel}>
      {CINCO.map((item) =>
        item.seccion === seccion && !slug
          ? <span aria-current="page"><span class="icono" data-svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLIFOS[item.icono]}></svg></span><span class="etiqueta">{item.label}</span></span>
          : <a href={item.seccion ? ruta(locale, item.seccion) : `/${locale}/`}><span class="icono" data-svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLIFOS[item.icono]}></svg></span><span class="etiqueta">{item.label}</span></a>,
      )}
    </nav>

    {/* ─── 4. iPad instalado, horizontal completo (1024-1366px, D-041) ──────
        Material 3 documenta que el patrón cambia de barra inferior a riel
        lateral a partir de ancho "medium" — no una barra estirada. Cabe todo:
        los 5 con ícono más los 3 de "Más", sin necesitar un segundo nivel.
        Fuera de este ancho (Split View, vertical) el iPad usa el bloque 3,
        igual que hoy — D-041 ya lo trata como iOS. Alcance de esta ronda:
        solo iOS/iPad; una tableta Android ancha se queda con el bloque 3. */}
    <nav class="riel" aria-label={m.navLabel}>
      <ul>
        {CINCO.map((item) => (
          <li>
            {item.seccion === seccion && !slug
              ? <span aria-current="page"><span class="icono" data-svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLIFOS[item.icono]}></svg></span><span class="etiqueta">{item.label}</span></span>
              : <a href={item.seccion ? ruta(locale, item.seccion) : `/${locale}/`}><span class="icono" data-svg><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={GLIFOS[item.icono]}></svg></span><span class="etiqueta">{item.label}</span></a>}
          </li>
        ))}
        <li class="separador" role="separator"></li>
        {SECCIONES_MAS.map((item) => (
          <li>
            {item.seccion === seccion && !slug
              ? <span aria-current="page" class="etiqueta">{item.label}</span>
              : <a href={ruta(locale, item.seccion)} class="etiqueta">{item.label}</a>}
          </li>
        ))}
      </ul>
    </nav>

    <footer>
      <nav aria-label={m.languageLabel}>
        <span class="muted">{m.languageLabel}:</span>
        <ul>
          {LOCALES.map((l) => (
            <li>
              {l === locale
                ? <span aria-current="true">{t(l).localeName}</span>
                : <a href={rutaEn(l)} hreflang={l} lang={l}>{t(l).localeName}</a>}
            </li>
          ))}
        </ul>
      </nav>
      {/* El enlace al repositorio, en TODAS las páginas — criterio de S0.
          Va en el pie del layout y no en cada página porque así no puede
          faltar: estaba en 350 de 372, y las 22 que no lo tenían eran las
          portadas, arquitectura y niveles de cada locale. Un criterio que dice
          "en cada página" se cumple en un solo sitio o no se cumple. */}
      <p class="muted">
        {m.sponsor}{" · "}
        <a href="https://github.com/kilowatto/math-challenge" rel="noopener">{m.repoLink}</a>
      </p>
    </footer>

    <style>
      .skip {
        position: absolute;
        inset-inline-start: -9999px;
        padding: 0.5rem 1rem;
        background: var(--color-accent);
        color: var(--color-on-accent);
      }
      .skip:focus { inset-inline-start: 0; z-index: 10; }

      /* D-036: la navegación habla en la voz del sistema, no en Raleway. */
      nav.sitio {
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
        max-inline-size: 46rem;
        margin: 0 auto;
        padding: 1.25rem 1.25rem 0;
        border-block-end: 1px solid var(--color-border);
      }
      /* ─── Móvil primero, y esto se rehízo mirando un teléfono ──────────────
         La versión anterior era `flex-wrap: wrap`: en un móvil las seis
         secciones se partían en dos líneas y el botón de registro quedaba
         encajado al final de la segunda. Se veía roto porque lo estaba.

         Ahora las secciones son UNA fila que se desplaza en horizontal. No se
         parte, no empuja nada, y el pulgar la recorre — que es como se navega
         una app instalada. `overflow-x: auto` con `scroll-snap` para que no se
         quede a media palabra. */
      nav.sitio ul {
        list-style: none;
        display: flex;
        flex-wrap: nowrap;
        overflow-x: auto;
        overscroll-behavior-inline: contain;
        scroll-snap-type: inline mandatory;
        gap: 0 1.25rem;
        padding: 0;
        margin: 0;
        /* La barra de desplazamiento nativa robaría alto en un móvil y no
           aporta nada: la fila se ve cortada, que ya es la señal. */
        scrollbar-width: none;
      }
      nav.sitio ul::-webkit-scrollbar { display: none; }
      nav.sitio li { flex: 0 0 auto; scroll-snap-align: start; }

      /* Las dos acciones: ancho completo en un teléfono, al contenido después. */
      .acciones {
        display: flex;
        gap: 0.75rem;
        padding-block: 0.75rem;
      }
      .acciones > * {
        flex: 1 1 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-block-size: var(--tap-primaria);
        padding-inline: 1rem;
        border-radius: var(--radius);
        text-decoration: none;
        font-weight: var(--weight-subtitle);
      }
      .acciones .entrar {
        color: var(--color-text);
        border: 1px solid var(--color-border);
      }
      /* El naranja como FONDO con texto blanco da 3.03:1 — válido para un
         control, nunca para texto normal sobre claro. */
      .acciones .registro {
        background: var(--color-accent);
        color: var(--color-on-accent);
      }
      .acciones .registro:hover { background: var(--color-accent-hover); }
      .acciones [aria-current] { opacity: 0.6; pointer-events: none; }

      @media (min-width: 40rem) {
        /* A partir de aquí caben en la misma línea que las secciones. */
        nav.sitio { display: flex; align-items: center; gap: 1.25rem; }
        nav.sitio ul { flex: 1 1 auto; }
        .acciones { flex: 0 0 auto; padding-block: 0; }
        .acciones > * { flex: 0 0 auto; }
      }
      /* WCAG 2.5.8: ningún blanco táctil por debajo de 24px. */
      nav.sitio a, nav.sitio [aria-current] {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-min);
        padding-block: 0.35rem;
      }
      /* Sin esto, un enlace que no es la página actual cae al azul y
         subrayado por default del navegador — se ve como web sin diseñar,
         no como un control nativo (D-031). `nav.sitio [aria-current]` de
         abajo YA fijaba su propio color; a este le faltaba el suyo. */
      nav.sitio a {
        color: var(--color-text-muted);
        text-decoration: none;
      }
      /* El naranja de Ignia da 3.03:1 sobre blanco y NO alcanza el 4.5:1 de
         texto normal: la página actual se marca con el color de texto y una
         línea inferior, no con el naranja. El naranja se queda en el borde,
         que es gráfico y solo necesita 3:1. */
      nav.sitio [aria-current] {
        color: var(--color-text);
        box-shadow: inset 0 -3px 0 0 var(--color-accent);
      }

      /* ─── Bloque 2: encabezado compacto de pestaña de navegador ──────────
         Oculto por defecto; `plataformas.css` lo enseña solo en ios/android
         con `display-mode: browser` (D-064). */
      /* `sticky`, no estático: sin esto, al hacer scroll el encabezado
         desaparece igual que el nav de hoy — es la otra mitad de la queja
         original ("en Safari no hay menú" al bajar en la página). El botón
         de menú tiene que quedar alcanzable sin volver arriba. */
      header.compacto {
        display: none;
        position: sticky;
        inset-block-start: 0;
        z-index: 10;
        background: var(--color-surface);
      }
      header.compacto .fila {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem 1.25rem;
        border-block-end: 1px solid var(--color-border);
      }
      /* La marca habla en Raleway (D-036) — es donde se lee a Ignia, a
         diferencia de los controles de alrededor, que hablan en la voz del
         sistema. */
      header.compacto .marca {
        display: inline-flex;
        align-items: center;
        /* touch-targets.mjs marcaba este blanco como "frágil": llegaba al
           mínimo por padding + línea, no por un tamaño garantizado. */
        min-block-size: var(--tap-min);
        font-family: var(--font-marca);
        font-weight: var(--weight-subtitle);
        font-size: var(--text-base);
        color: var(--color-text);
        text-decoration: none;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      header.compacto .acciones-compactas {
        display: flex;
        gap: 0.5rem;
        margin-inline-start: auto;
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
      }
      header.compacto .acciones-compactas > * {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-min);
        padding-inline: 0.6rem;
        border-radius: var(--radius);
        text-decoration: none;
        font-weight: var(--weight-subtitle);
        white-space: nowrap;
      }
      header.compacto .entrar { color: var(--color-text); border: 1px solid var(--color-border); }
      header.compacto .registro { background: var(--color-accent); color: var(--color-on-accent); }
      header.compacto [aria-current] { opacity: 0.6; pointer-events: none; }

      /* El botón de menú y la lista que empuja el contenido — nunca un
         overlay (mc-49: iOS Safari no cierra overlays con el gesto de
         deslizar que sí funciona en Android). */
      /* `align-self: flex-start`, no el `center` heredado de `.fila`: sin
         esto, al abrirse, flexbox centra el <details> ya CRECIDO contra la
         altura completa de la fila, y la lista se ve flotando encima del
         encabezado en vez de empujarlo hacia abajo — se vio pasar en un
         navegador real. Los demás hijos de `.fila` son cortos y se quedan
         centrados sin que nadie lo note. */
      header.compacto details.menu { flex: 0 0 auto; align-self: flex-start; }
      header.compacto details.menu summary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-inline-size: var(--tap-min);
        min-block-size: var(--tap-min);
        list-style: none;
        cursor: pointer;
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
        color: var(--color-text);
      }
      header.compacto details.menu summary::-webkit-details-marker { display: none; }
      header.compacto details.menu summary::before {
        content: "";
        inline-size: 1.1rem;
        block-size: 1.1rem;
        margin-inline-end: 0.35rem;
        background: currentColor;
        -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="black" stroke-width="2" stroke-linecap="round" fill="none"/></svg>') center / contain no-repeat;
        mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18" stroke="black" stroke-width="2" stroke-linecap="round" fill="none"/></svg>') center / contain no-repeat;
      }
      header.compacto ul {
        list-style: none;
        margin: 0;
        padding: 0.5rem 1.25rem 0.75rem;
        border-block-end: 1px solid var(--color-border);
        font-family: var(--font-sistema);
        font-size: var(--text-sm, var(--text-xs));
      }
      header.compacto ul a,
      header.compacto ul [aria-current] {
        display: flex;
        align-items: center;
        min-block-size: var(--tap-primaria);
        color: var(--color-text-muted);
        text-decoration: none;
      }
      header.compacto ul [aria-current] { color: var(--color-text); font-weight: var(--weight-subtitle); }

      /* ─── Bloque 3: franja "Más" de la app instalada ──────────────────────
         Mismo <details> sin JavaScript, esta vez para las tres secciones que
         no caben en los 5 destinos de la barra inferior. */
      /* `sticky`, mismo motivo que header.compacto: sin esto, "Más" solo se
         alcanza volviendo arriba, que es el defecto que D-064 vino a
         arreglar en primer lugar. */
      .mas-instalada {
        display: none;
        position: sticky;
        inset-block-start: 0;
        z-index: 10;
        background: var(--color-surface);
      }
      .mas-instalada details { border-block-end: 1px solid var(--color-border); }
      .mas-instalada summary {
        display: flex;
        align-items: center;
        justify-content: center;
        min-block-size: var(--tap-min);
        list-style: none;
        cursor: pointer;
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
        padding-block: 0.4rem;
      }
      .mas-instalada summary::-webkit-details-marker { display: none; }
      .mas-instalada ul {
        list-style: none;
        margin: 0;
        padding: 0 1.25rem 0.75rem;
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
      }
      .mas-instalada a, .mas-instalada [aria-current] {
        display: flex;
        align-items: center;
        min-block-size: var(--tap-primaria);
        color: var(--color-text-muted);
        text-decoration: none;
      }
      .mas-instalada [aria-current] { color: var(--color-text); }

      /* ─── Bloque 3: barra inferior instalada ──────────────────────────────
         Oculta por defecto — `plataformas.css` la enseña como flex solo en
         ios/android + instalada. Sin este default se colaría en escritorio,
         donde ninguna regla de plataforma la toca. El resto de la geometría
         (posición fija, safe-area, translúcido de iOS, píldora de Android)
         vive en plataformas.css, que es donde ya vivía antes de D-064. Esto
         solo agrega el default oculto y el tamaño de ícono + etiqueta. */
      nav.barra-inferior { display: none; }
      .barra-inferior .icono { inline-size: 22px; block-size: 22px; }
      .barra-inferior .icono[data-svg] svg { inline-size: 100%; block-size: 100%; }
      .barra-inferior .etiqueta { font-size: 0.68rem; }

      /* ─── Bloque 4: riel de iPad ancho instalado ──────────────────────────
         Oculto por defecto; plataformas.css lo enseña solo en
         [data-platform="ios"] + standalone + 1024-1366px (D-041, D-064). */
      nav.riel { display: none; }
      nav.riel ul {
        list-style: none;
        margin: 0;
        padding: 1.25rem 0.75rem;
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
      }
      nav.riel a, nav.riel [aria-current] {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-block-size: var(--tap-primaria);
        padding-inline: 0.75rem;
        border-radius: var(--radius);
        text-decoration: none;
        color: var(--color-text-muted);
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
      }
      nav.riel [aria-current] { color: var(--color-text); font-weight: var(--weight-subtitle); }
      nav.riel .icono { inline-size: 22px; block-size: 22px; flex: 0 0 auto; }
      nav.riel .icono[data-svg] svg { inline-size: 100%; block-size: 100%; }
      nav.riel .separador {
        border-block-start: 1px solid var(--color-border);
        margin-block: 0.5rem;
        padding: 0;
      }

      main { max-inline-size: 46rem; margin: 0 auto; padding: 2rem 1.25rem 3rem; }

      footer {
        max-inline-size: 46rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
        border-block-start: 1px solid var(--color-border);
      }
      footer ul {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.25rem;
        padding: 0;
        margin: 0.5rem 0 1.5rem;
      }
      /* WCAG 2.5.8: ningún blanco táctil por debajo de 24px. */
      footer a, footer [aria-current] {
        display: inline-flex;
        align-items: center;
        min-block-size: var(--tap-min);
      }
      /* Mismo bug que nav.sitio: sin color/text-decoration propios, el
         azul-subrayado por default del navegador se cuela en el pie —
         el enlace al idioma y al repositorio, entre otros. */
      footer a { color: var(--color-text-muted); text-decoration: none; }
      footer [aria-current] { color: var(--color-text-muted); }

      .muted { color: var(--color-text-muted); font-size: var(--text-xs); }
    </style>
      <!-- Core Web Vitals de campo (D-037). Superficie PÚBLICA: banda "PUBLICO".
         JAMÁS se incluye en pantallas de niño; audits/telemetria-infantil.mjs
         bloquea el commit si aparece ahí. -->
    <Rum banda="PUBLICO" locale={locale} />
  </body>
</html>
