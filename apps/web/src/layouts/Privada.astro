---
import Rum from "../components/Rum.astro";
import Instalar from "../components/Instalar.astro";
import { t, type Locale } from "../i18n";
import { plataformaDe } from "../lib/plataforma";

/**
 * Layout del área privada — `/app/**` fuera de `app/kids/**`. D-065.
 *
 * ─── Por qué no es `layouts/Base.astro` ────────────────────────────────────
 *
 * `Base.astro` es el sitio público: nav de marketing (Origen, Investigación,
 * Código abierto…) y "Entrar"/"Crear cuenta" como acciones principales. Nada
 * de eso tiene sentido para alguien que YA inició sesión — y hasta D-065 era
 * exactamente lo que `app/index.astro` heredaba, sin que ningún comentario lo
 * explicara: la única superficie de `/app/**` sin una razón escrita para su
 * propio layout, en un repo donde `app/kids/**` documenta la suya tres veces.
 *
 * ─── Qué SÍ comparte con `Base.astro` ──────────────────────────────────────
 *
 * Los tokens (`tokens.css`/`fonts.css`), la detección de plataforma (D-031,
 * mismo mecanismo: servidor primero, script bloqueante de respaldo) y
 * `Instalar.astro` — esto es superficie de ADULTO, y quien vuelve aquí a
 * diario es exactamente a quien más le conviene instalar. Lo que NO comparte
 * es la navegación en sí: esta es una franja de pestañas simple, no los
 * cuatro bloques de D-064, porque aquí no hay un nav de marketing con el que
 * competir — esa complejidad existía para resolver un problema que esta
 * pantalla no tiene.
 *
 * ─── RUM: SERIO, no PUBLICO ────────────────────────────────────────────────
 *
 * `Base.astro` manda `banda="PUBLICO"`. Esto es adulto autenticado — D-037 sí
 * permite medir aquí, pero con la banda real, no con la del sitio de marketing.
 * `audits/telemetria-infantil.mjs` exige que nunca sea KINDER/PRIMARIA; SERIO
 * pasa esa regla y además evita mezclar tráfico de marketing con uso real del
 * producto en el mismo balde de métricas.
 */

/*
 * ─── Las tres hojas, importadas de VERDAD ──────────────────────────────────
 *
 * El comentario de arriba dice desde el primer día que este layout «comparte
 * los tokens (`tokens.css`/`fonts.css`) con `Base.astro`». No los compartía:
 * no había un solo `import`, y una hoja de estilo no se hereda por estar
 * documentada. Toda `/app/**` se servía con la tipografía por defecto del
 * navegador —Times, negro sobre blanco, sin franja de pestañas— mientras el
 * archivo afirmaba lo contrario.
 *
 * Ya se arregló una vez (commit `4ceae86`) y volvió al resolver un conflicto de
 * merge tomando la otra versión del archivo. Por eso la comprobación no puede
 * ser un comentario: `audits/area-privada.mjs` exige ahora los tres imports.
 *
 * `Base.astro` los importa con estas mismas tres líneas. Son globales, así que
 * importarlos en los dos layouts no los duplica en el bundle: Vite los emite
 * una vez y las dos páginas apuntan al mismo archivo con hash.
 */
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/plataformas.css";

import type { Pestana } from "../lib/pestanas-privadas";

interface Props {
  locale: Locale;
  title: string;
  description: string;
  /** Vacío = sin franja de pestañas (una sola sección no necesita menú). */
  pestanas?: Pestana[];
}

const { locale, title, description, pestanas = [] } = Astro.props;
const m = t(locale);
const plataforma = plataformaDe(Astro.request.headers);
---

<!doctype html>
<html lang={m.htmlLang} data-platform={plataforma} data-band="SERIO">
  <head>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var ua = navigator.userAgent;
        var uad = navigator.userAgentData;
        var p = "otro";
        var plat = uad && uad.platform ? String(uad.platform).toLowerCase() : "";
        var movil = uad ? !!uad.mobile : /\bMobile\b/.test(ua);
        if (plat) {
          p = plat === "android" ? "android"
            : plat === "ios" ? "ios"
            : plat === "windows" ? "windows"
            : plat === "macos" ? (movil ? "ios" : "macos")
            : "otro";
        } else if (/\bAndroid\b/i.test(ua)) p = "android";
        else if (/\b(iPhone|iPad|iPod)\b/i.test(ua)) p = "ios";
        else if (/\bMacintosh\b/i.test(ua)) p = (navigator.maxTouchPoints > 1) ? "ios" : "macos";
        else if (/\bWindows\b/i.test(ua)) p = "windows";
        d.setAttribute("data-platform", p);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {/* Autenticada, nunca indexada. */}
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#F36B1C" />
    <link rel="icon" href="/icons/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="preload" href="/fonts/raleway-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body>
    <a class="skip" href="#main">{m.skipToContent}</a>

    {pestanas.length > 1 && (
      <nav class="pestanas" aria-label={title}>
        {/*
          Solo destinos. Nada más.

          «Cerrar sesión» vivía DENTRO de esta franja, pegado a la derecha con
          `margin-inline-start: auto`, y era la única cosa aquí que no lleva a
          ninguna parte. En un teléfono se llevaba el ancho que las pestañas
          necesitaban y las empujaba fuera de la vista: el dueño vio «Tiemp»
          cortado a la mitad, sin ninguna señal de que hubiera más a la
          derecha. Ahora está en el pie, abajo — sigue en este layout, que es lo
          que D-065 punto 7 pide (es transversal, no de una pestaña), pero fuera
          de la navegación primaria.
        */}
        <ul>
          {pestanas.map((p) => (
            <li>
              <a href={p.href} aria-current={p.activa ? "page" : undefined}>
                <span class="rotulo">{p.label}</span>
                {p.proximamente && <span class="chip">{m.casaProximamenteEtiqueta}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <main id="main">
      <slot />
      <Instalar locale={locale} plataforma={plataforma} />
    </main>

    {/* Botón con JS, no una regla nueva de D-064: esa decisión restringe la
        ESTRUCTURA de la navegación (nunca dos apiladas, sin librería), no cada
        botón de una pantalla de cuenta — el passkey y el cambio de contraseña
        de esta misma superficie ya son JS-mejorados por la misma razón.
        `/api/casa?accion=salir` responde JSON, no una redirección; un <form>
        normal aterrizaría en JSON crudo.

        Se pinta SIEMPRE, también cuando no hay franja de pestañas: antes
        colgaba del mismo `pestanas.length > 1` que la navegación, así que una
        pantalla privada con una sola sección se quedaba sin forma de salir. */}
    <footer class="pie">
      <button type="button" class="salir" id="salir-privada">{m.casaSalir}</button>
    </footer>

    <style>
      .skip {
        position: absolute;
        inset-inline-start: -9999px;
        padding: 0.5rem 1rem;
        background: var(--color-accent);
        color: var(--color-on-accent);
      }
      .skip:focus { inset-inline-start: 0; z-index: 10; }

      /* D-036: la navegación habla en la voz del sistema, no en Raleway. */
      nav.pestanas {
        position: sticky;
        inset-block-start: 0;
        z-index: 10;
        background: var(--color-surface);
        border-block-end: 1px solid var(--color-border);
        font-family: var(--font-sistema);
      }

      /*
        ─── Móvil: una rejilla de columnas iguales, NUNCA un scroller ────────
        ─────────────────────────────────────────────────────────────────────

        Esto era `display: flex` con `overflow-x: auto` y `white-space: nowrap`.
        En un teléfono el scroller se comprimía, la última etiqueta visible
        quedaba cortada («Tiemp») y no había ni una señal de que hubiera más:
        se lee como una pantalla rota, no como algo desplazable. Un scroller
        horizontal sin affordance es peor que no tener el destino.

        La rejilla no puede cortar nada porque no desborda: cinco columnas de
        `1fr` reparten el ancho que haya, y `overflow-wrap: anywhere` hace que
        una palabra que no quepa BAJE de línea en vez de salirse. El peor caso
        es una pestaña de dos renglones; el peor caso de antes era una palabra
        a medias.

        Las etiquetas cortas hacen el resto — «Tiempo de pantalla» es el título
        de la pantalla, «Pantalla» es el rótulo de la pestaña
        (`casaTabLimiteCorto`, ver lib/pestanas-privadas.ts).
      */
      nav.pestanas ul {
        list-style: none;
        margin: 0 auto;
        padding: 0;
        display: grid;
        grid-auto-flow: column;
        grid-auto-columns: 1fr;
        max-inline-size: var(--measure, 46rem);
      }
      nav.pestanas a {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.1rem;
        block-size: 100%;
        min-block-size: var(--tap-primaria);
        /* 0.1rem y no 0.25: con cinco columnas en 390 px cada una mide 78, y
           «Próximamente» mide 66. Con 0.25rem a cada lado quedaban 70 px de
           hueco y la palabra entraba… hasta que aparece la barra de scroll y
           el hueco baja a 66 justos: entonces parte a la mitad
           («Próximament / e»). Se midió con `Range.getClientRects().length`,
           que cuenta renglones — `scrollWidth > clientWidth` NO detecta esto,
           porque un texto que se parte no desborda. */
        padding: 0.35rem 0.1rem;
        color: var(--color-text-muted);
        text-decoration: none;
        text-align: center;
        font-size: 0.75rem;
        line-height: 1.2;
        overflow-wrap: anywhere;
        border-block-end: 3px solid transparent;
      }
      nav.pestanas a[aria-current="page"] {
        color: var(--color-text);
        font-weight: var(--weight-subtitle);
        border-block-end-color: var(--color-accent);
      }
      nav.pestanas a:focus-visible { outline: 3px solid var(--color-text); outline-offset: -3px; }
      /* Sin borde ni píldora en móvil: la cápsula sumaba ~13 px de relleno a un
         rótulo que ya iba justo. Aquí es un subtítulo, que es lo que dice. */
      /*
        La marca de «todavía no» va debajo del rótulo, en texto pequeño y sin
        cápsula. El borde y el `padding-inline` de la píldora sumaban ~13 px a
        una columna de 74, y no cabía.

        Y el TEXTO se acortó por locale, en los siete: «Próximamente» partía a
        la mitad en 360 px —el ancho de un Android de gama media, que es el
        aparato de referencia (`mc-47` §5)— aunque cupiera justo en 390. La
        palabra corta («Pronto», «Soon») cabe con margen hasta 320.
      */
      nav.pestanas .chip {
        font-size: 0.62rem;
        line-height: 1.1;
        color: var(--color-text-muted);
      }

      /*
        ─── Desde tableta: la fila de siempre, alineada al contenido ─────────
        Con sitio de sobra, columnas iguales estiran cinco pestañas por 68ch y
        se ven flotando. Aquí vuelven a ser una fila compacta a la izquierda, y
        el «Próximamente» recupera su píldora al lado del rótulo.
      */
      @media (min-width: 40em) {
        nav.pestanas ul {
          grid-auto-columns: auto;
          justify-content: start;
          padding-inline: 1.25rem;
        }
        nav.pestanas a {
          flex-direction: row;
          gap: 0.4rem;
          padding-inline: 0.75rem;
          font-size: var(--text-sm, var(--text-xs));
        }
        nav.pestanas .chip {
          font-size: 0.65rem;
          border: 1px solid var(--color-border);
          border-radius: 999px;
          padding-inline: 0.4rem;
        }
      }

      main#main { max-inline-size: var(--measure, 46rem); margin: 0 auto; padding: 2rem 1.25rem 1rem; }

      /* El pie: una sola acción, discreta, lejos de los destinos. */
      footer.pie {
        max-inline-size: var(--measure, 46rem);
        margin: 0 auto;
        padding: 0 1.25rem 3rem;
        border-block-start: 1px solid var(--color-border);
        padding-block-start: 1rem;
      }
      footer.pie .salir {
        min-block-size: var(--tap-primaria);
        padding-inline: 0.75rem;
        margin-inline-start: -0.75rem;
        color: var(--color-text-muted);
        background: none;
        border: 0;
        font-family: var(--font-sistema);
        font-size: var(--text-sm, var(--text-xs));
        cursor: pointer;
      }
      footer.pie .salir:focus-visible { outline: 3px solid var(--color-text); outline-offset: 2px; }
    </style>

    <Rum banda="SERIO" locale={locale} />

    <script define:vars={{ portada: `/${locale}/` }}>
      document.getElementById("salir-privada")?.addEventListener("click", async (e) => {
        e.target.disabled = true;
        await fetch("/api/casa?accion=salir", { method: "POST" }).catch(() => {});
        location.href = portada;
      });
    </script>
  </body>
</html>
