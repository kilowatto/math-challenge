---
import Base from "../../../layouts/Base.astro";
import { LOCALES, isLocale, type Locale } from "../../../i18n";
import { ruta, segmento } from "../../../i18n/rutas";
import {
  loadCorpus,
  loadBodies,
  loadTranslatedRaw,
  loadTranslatedBodies,
  translatedSummaryBlocks,
  SOURCES_IDS_POR_LOCALE,
  RESUMEN_EN_IDS_POR_LOCALE,
  trimBody,
  linkCrossReferences,
  markUnverified,
  blocksText,
  leadOf,
  countWords,
  FAQ_MIN_PAIRS,
  type ResearchDoc,
  type CategoryKey,
  type SummaryBlock,
} from "../../../lib/corpus";

/**
 * /{locale}/{segmento}/{slug}/ — una de las 47 investigaciones (S1).
 * El segmento va en el idioma del locale desde D-049: `/de-DE/forschung/mc-05-…/`.
 *
 * Es la página que D-033 llama "la estrategia": se publican las investigaciones
 * completas, **incluidas las que contradicen al producto**, con sus fuentes,
 * sus limitaciones y sus marcas `[unverified]` **visibles**. `mc-48` §1
 * documenta por qué eso no es un gesto de transparencia sino el activo: la
 * credibilidad viene de declarar los límites, y prácticamente ningún
 * competidor lo hace (`mc-14`).
 *
 * ─── Las cuatro reglas con las que está escrita ────────────────────────────
 *
 * 1. **Ninguna cifra se escribe a mano.** Palabras, fuentes, marcas
 *    `[unverified]` y el total del corpus se cuentan en el build sobre los
 *    archivos reales (plan §4.9). Publicar "45 investigaciones, 152,000
 *    palabras" —lo que dicen hoy D-033 y `mc-48`— en la página que presume
 *    rigor sería el error más caro posible: el conteo real es otro.
 *
 * 2. **Todo lo que va en el JSON-LD se pinta desde la MISMA variable.**
 *    `headline` es el `<h1>`; `abstract` son los bloques del resumen;
 *    `citation[].name` es la lista de fuentes; los `name` de las migas son las
 *    migas. Las tres partes del Markdown que se duplicarían se recortan del
 *    cuerpo compilado (`trimBody`). Es la regla dura de `mc-48` §3: si el
 *    esquema no coincide con lo visible, Google puede ignorar el marcado
 *    entero — no ese campo, el marcado entero, en las 329 páginas.
 *
 * 3. **Las marcas `[unverified]` y la advertencia de método van arriba y sin
 *    JavaScript.** El plan §4.4 lo dice sin matiz: esconderlas en un acordeón
 *    gris destruye exactamente el diferenciador. Si desaparecen con el JS
 *    apagado, desaparecen para parte de los rastreadores.
 *
 * 4. **Ningún locale recibe una traducción falsa.** Los 47 documentos están
 *    escritos en inglés con resumen ejecutivo también en español. Las siete
 *    rutas existen —el resto del sitio está en siete y dejar cinco en 404
 *    partiría el `hreflang`— y cada una **declara en la página** en qué idioma
 *    está el cuerpo que está leyendo, con `inLanguage` diciendo la verdad.
 *
 *    Desde el 2026-08-01 esto ya no significa "siempre inglés": `es-MX`,
 *    `es-ES` y `fr-FR` tienen cuerpo traducido y auditado contra el original
 *    (`LOCALES_TRADUCCION_VERIFICADA` en `corpus.ts`), y esta página lo usa
 *    cuando existe, con `langNoticeTranslated` diciendo exactamente qué se
 *    verificó (cifras, URLs, citas) y qué no (prosa revisada por un hablante
 *    nativo — todavía pendiente, AGENTS.md §9). `pt-BR`, `pt-PT` y `de-DE`
 *    siguen sirviendo el original en inglés: su traducción existe en el
 *    repositorio pero su estructura de encabezados no es consistente entre
 *    los 47 archivos, y esta página nunca muestra algo que no pudo verificar
 *    de forma mecánica que coincide con la fuente.
 *
 * Tipografía: D-036 — títulos y cuerpo en `--font-marca`, migas y controles en
 * `--font-sistema`. El naranja `#F36B1C` solo aparece en el `<h1>` (2.5rem, el
 * umbral aplicable es 3:1 y da 3.03:1) y como elemento gráfico.
 */

// ---------------------------------------------------------------------------
// Datos: los 47 documentos, leídos de docs/research/ en el build.
// ---------------------------------------------------------------------------

const DOCS = loadCorpus();
const BODIES = loadBodies();
const TRANSLATED_RAW = loadTranslatedRaw();
const TRANSLATED_BODIES = loadTranslatedBodies();

/**
 * Las 329 URLs de artículo: 7 locales × 47 documentos, cada una bajo el
 * segmento de SU locale (D-049) — `/de-DE/forschung/mc-05-…/`.
 *
 * El SLUG no se traduce y esto es deliberado: `mc-05-spacing-retrieval-…` es
 * idéntico en los siete. El identificador `mc-NN` es lo que hace citable al
 * corpus (D-033), y traducirlo rompería la única forma que tiene alguien de
 * encontrar el mismo documento en otro idioma. Se traduce el camino hasta el
 * documento, nunca su nombre.
 */
export function getStaticPaths() {
  const docs = loadCorpus();
  return LOCALES.flatMap((locale) =>
    docs.map((doc) => ({
      params: { locale, seccion: segmento(locale, "investigacion"), slug: doc.slug },
    })),
  );
}

const { locale: rawLocale, slug } = Astro.params;
if (!isLocale(rawLocale)) return Astro.redirect("/en/");
const locale: Locale = rawLocale;

const doc = DOCS.find((d) => d.slug === slug);
if (!doc) return Astro.redirect(ruta(locale, "investigacion"));

const site = "https://math.kilowatto.com";
const url = `${site}${ruta(locale, "investigacion", doc.slug)}`;
const hrefFor = (s: string) => ruta(locale, "investigacion", s);

// ---------------------------------------------------------------------------
// Cuerpo compilado por el pipeline de Markdown de Astro, recortado y enlazado.
//
// Desde el 2026-08-01, `es-MX`, `es-ES` y `fr-FR` tienen el CUERPO completo
// traducido y auditado (`audits/corpus-integridad.mjs`: cifras, URLs,
// marcadores de cita y `[unverified]` verificados contra el original) — ver
// `LOCALES_TRADUCCION_VERIFICADA` en `corpus.ts`. Los demás locales (`pt-BR`,
// `pt-PT`, `de-DE`) siguen sin cuerpo verificable de forma consistente entre
// sus 47 archivos y se publican en su idioma original, inglés, como antes.
// ---------------------------------------------------------------------------

const bySlug = new Map(DOCS.map((d) => [d.id, d.slug] as const));
const UNVERIFIED_ANCHOR = "verificacion";

// `TRANSLATED_RAW` ya viene filtrado por el manifiesto del auditor: un documento
// con hallazgo no está ahí. Así que la existencia de la entrada ES la
// verificación — no hay una segunda lista que pueda desincronizarse.
const translatedRaw: string | undefined = TRANSLATED_RAW[locale]?.[doc.file];
const translatedBodyLoader = TRANSLATED_BODIES[locale]?.[doc.file];
const hasTranslation = !!translatedRaw && !!translatedBodyLoader;

/**
 * El cuerpo traducido, con red de seguridad.
 *
 * `trimBody` depende de que el HTML compilado tenga los anclajes
 * `#executive-summary-en` y `#sources`, que a su vez dependen de que el
 * encabezado en el Markdown traducido coincida con lo que el barrido del
 * 2026-08-01 verificó. Si un archivo puntual se sale de ese patrón —typo,
 * variante de encabezado que el barrido no vio—, `trimBody` lanza. En vez de
 * tumbar el build entero por un documento, se cae de vuelta al cuerpo en
 * inglés para ESE documento y se sigue: es la misma filosofía de "documento
 * sin traducción todavía es un estado válido" aplicada al cuerpo.
 */
let body: string;
let bodyIsTranslated = false;
if (hasTranslation && translatedBodyLoader) {
  try {
    const mod = await translatedBodyLoader();
    const compiled = await mod.compiledContent();
    body = trimBody(
      compiled,
      `${locale}/${doc.file}`,
      SOURCES_IDS_POR_LOCALE[locale],
      RESUMEN_EN_IDS_POR_LOCALE[locale],
    );
    bodyIsTranslated = true;
  } catch {
    const loader = BODIES[doc.file];
    if (!loader) throw new Error(`investigacion: sin cuerpo compilado para ${doc.file}`);
    const mod = await loader();
    const compiled = await mod.compiledContent();
    body = trimBody(compiled, doc.file);
  }
} else {
  const loader = BODIES[doc.file];
  if (!loader) throw new Error(`investigacion: sin cuerpo compilado para ${doc.file}`);
  const mod = await loader();
  const compiled = await mod.compiledContent();
  body = trimBody(compiled, doc.file);
}
body = linkCrossReferences(body, bySlug, doc.id, hrefFor);

// Si el cuerpo cayó de vuelta al inglés pese a haber traducción de resumen,
// el aviso de idioma tiene que hablar de ESO, no de la traducción que no se
// pudo usar — así que el resumen también cae de vuelta, para no mostrar un
// resumen traducido sobre un cuerpo en inglés sin avisarlo.
const effectiveHasTranslation = hasTranslation && bodyIsTranslated;

// ---------------------------------------------------------------------------
// El idioma del documento, y cómo se dice sin mentir.
//
// `mc-48` §3 y D-033 piden declarar el idioma, no simularlo: cuando hay
// traducción verificada Y el cuerpo se pudo recortar, `inLanguage` dice el
// locale real; cuando no la hay, sigue diciendo "en", porque eso es lo que
// hay.
// ---------------------------------------------------------------------------

const ARTICLE_LANG = effectiveHasTranslation ? locale : "en";

const SUMMARY_LANG: Record<Locale, "es" | "en"> = {
  "en": "en",
  "es-MX": "es",
  "es-ES": "es",
  "fr-FR": "en",
  "pt-BR": "en",
  "pt-PT": "en",
  "de-DE": "en",
};
const summaryLang = SUMMARY_LANG[locale];

// El resumen traducido gana sobre el resumen ES/EN genérico del original
// cuando existe, su encabezado se pudo leer, Y el cuerpo también se tradujo
// (ver `effectiveHasTranslation` arriba). `translatedSummaryBlocks` devuelve
// `null` en vez de lanzar si el archivo no tiene el encabezado esperado — esa
// es la señal para caer de vuelta al resumen del original.
const translatedSummary: SummaryBlock[] | null = effectiveHasTranslation && translatedRaw
  ? translatedSummaryBlocks(translatedRaw, locale)
  : null;
const summary = translatedSummary ?? doc.summary[summaryLang];
const abstract = blocksText(summary);
const lead = leadOf(summary);

/**
 * Los bloques del resumen agrupados en corridas del mismo tipo, para pintarlos
 * **en su orden original**.
 *
 * No es cosmética: `abstract` concatena los bloques en orden, y el auditor
 * comprueba que esa cadena aparezca en el texto visible. Pintar primero todos
 * los párrafos y luego todas las viñetas coincidiría por casualidad mientras
 * ningún resumen intercalara los dos — y dejaría de coincidir el día que uno lo
 * haga, en una página que ya nadie estaría mirando.
 */
const summaryRuns: Array<{ kind: "p" | "li"; items: string[] }> = [];
for (const b of summary) {
  const last = summaryRuns[summaryRuns.length - 1];
  if (last && last.kind === b.kind) last.items.push(b.text);
  else summaryRuns.push({ kind: b.kind, items: [b.text] });
}

// ---------------------------------------------------------------------------
// Cifras del corpus, todas contadas aquí. Ninguna es una constante escrita.
//
//   node --experimental-strip-types <script que importe corpus.ts>
//   → documentos 47 · palabras 157230 · fuentes numeradas 778
// ---------------------------------------------------------------------------

const TOTAL_DOCS = DOCS.length;
const TOTAL_WORDS = DOCS.reduce((a, d) => a + d.words, 0);
const abstractWords = countWords(abstract);

// Vecinos por número de tema: enlazado interno gratis y navegable sin JS.
const idx = DOCS.findIndex((d) => d.id === doc.id);
const prev: ResearchDoc | undefined = DOCS[idx - 1];
const next: ResearchDoc | undefined = DOCS[idx + 1];

// ---------------------------------------------------------------------------
// Textos de la página, en los siete locales.
//
// Van aquí y no en `src/i18n/paginas/` a propósito: ese directorio lo comparten
// las páginas de producto y este encargo solo escribe dos archivos. Cuando la
// ruta hub de S1 exista, estas llaves deberían mudarse ahí — están agrupadas
// para que mudarlas sea copiar un objeto.
//
// Ninguno de estos textos afirma nada sobre el producto ni sobre resultados de
// aprendizaje (D-033 lo prohíbe): describen el documento y su estado de
// verificación, que es lo único que esta página puede sostener.
// ---------------------------------------------------------------------------

interface Copy {
  breadcrumbHome: string;
  breadcrumbResearch: string;
  /** Título del `<title>`/`description` no: ver más abajo, ambos salen del documento. */
  categoryLabel: Record<CategoryKey, string>;
  metaDate: string;
  metaWords: string;
  metaSources: string;
  summaryHeading: string;
  /** Aviso de idioma. `{lang}` se sustituye por el nombre del idioma del cuerpo. */
  langNoticeSame: string;
  langNoticeSummaryEs: string;
  langNoticeOther: string;
  /** Aviso cuando el cuerpo SÍ está traducido y auditado a este locale
   *  (ver `LOCALES_TRADUCCION_VERIFICADA` en corpus.ts). Honesto sobre lo que
   *  el auditor verificó (cifras, URLs, citas) y lo que no (prosa revisada
   *  por un hablante nativo — AGENTS.md §9, todavía pendiente). */
  langNoticeTranslated: string;
  verifyHeading: string;
  verifyNone: string;
  verifyCount: string;
  verifyWhat: string;
  methodHeading: string;
  method: string;
  legal: string;
  openHeading: string;
  openIntro: string;
  sourcesHeading: string;
  sourcesNone: string;
  corpusNote: string;
  prevLabel: string;
  nextLabel: string;
  /** Nombre accesible de la navegación anterior/siguiente. Tiene que ser
   *  DISTINTO del de las migas: dos <nav> con el mismo nombre accesible es la
   *  violación `landmark-unique` de axe, y se vio fallar antes de esta llave. */
  neighboursLabel: string;
  repoLabel: string;
}

