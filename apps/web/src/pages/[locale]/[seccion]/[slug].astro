const c = COPY[locale];
const categoryLabel = CATEGORY_LABELS[locale][doc.category];

const langNotice =
  locale === "en"
    ? c.langNoticeSame
    : effectiveHasTranslation
      ? c.langNoticeTranslated
      : summaryLang === "es"
        ? c.langNoticeSummaryEs
        : c.langNoticeOther;

// El idioma real del resumen que se está pintando: el locale completo cuando
// viene de la traducción verificada, o el genérico "es"/"en" del original
// cuando no.
const summaryHtmlLang = translatedSummary ? locale : summaryLang;

const corpusNote = c.corpusNote
  .replace("{docs}", String(TOTAL_DOCS))
  .replace("{words}", TOTAL_WORDS.toLocaleString(locale));

// Las marcas [unverified] del cuerpo se vuelven visibles y apuntan al panel.
body = markUnverified(body, UNVERIFIED_ANCHOR, c.verifyHeading);

const repoUrl = `https://github.com/kilowatto/math-challenge/blob/main/docs/research/${doc.file}`;

// ---------------------------------------------------------------------------
// JSON-LD por capas.
//
// Capa 1 · ScholarlyArticle — siempre. Es el tipo que un sistema de citas
//          prefiere consumir (`mc-48` §3).
// Capa 2 · BreadcrumbList — siempre, y con migas visibles de verdad.
// Capa 3 · FAQPage — SOLO si el documento tiene pares pregunta-respuesta
//          reales. Ver `faqPairs` en corpus.ts: hoy ningún documento llega al
//          mínimo, así que hoy este nodo no se emite en ninguna de las 329
//          páginas, y eso es el comportamiento correcto. Las 47 secciones
//          "Open questions for the project owner" NO cuentan: son preguntas
//          sin respuesta, y `FAQPage` exige `acceptedAnswer`. Inventarla sería
//          exactamente el marcado que no coincide con lo visible.
//
// Estructura idéntica en los siete locales (`mc-48` §3: nada de un @type en
// alemán y otro en español). Lo único que cambia por locale es el idioma del
// contenido de los campos, que es justo lo que se pide.
//
// Ningún @id de este grafo apunta fuera de él, igual que en arquitectura.astro,
// para que el auditor `jsonld-valid` pueda resolverlos sin salir del bloque.
// ---------------------------------------------------------------------------

const article: Record<string, unknown> = {
  "@type": "ScholarlyArticle",
  "@id": `${url}#article`,
  url,
  name: doc.title,
  headline: doc.title,
  description: lead,
  abstract,
  // La verdad, no el locale de la ruta por defecto: "en" salvo que el cuerpo
  // que se está pintando de verdad sea la traducción auditada de ese locale
  // (`effectiveHasTranslation`, arriba).
  inLanguage: ARTICLE_LANG,
  datePublished: doc.date,
  dateModified: doc.date,
  wordCount: doc.words,
  keywords: [doc.id, categoryLabel],
  author: { "@type": "Organization", name: "Ignia", url: "https://ignia.cloud" },
  publisher: { "@type": "Organization", name: "Ignia", url: "https://ignia.cloud" },
};
if (doc.sources.length) {
  article.citation = doc.sources.map((s) => ({
    "@type": "CreativeWork",
    name: s.name,
    ...(s.url ? { url: s.url } : {}),
  }));
}

const graph: Array<Record<string, unknown>> = [
  article,
  {
    "@type": "BreadcrumbList",
    "@id": `${url}#breadcrumb`,
    itemListElement: [
      { "@type": "ListItem", position: 1, name: c.breadcrumbHome, item: `${site}/${locale}/` },
      { "@type": "ListItem", position: 2, name: c.breadcrumbResearch, item: `${site}${ruta(locale, "investigacion")}` },
      { "@type": "ListItem", position: 3, name: categoryLabel, item: url },
      { "@type": "ListItem", position: 4, name: doc.title, item: url },
    ],
  },
];

if (doc.faq.length >= FAQ_MIN_PAIRS) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${url}#faq`,
    inLanguage: ARTICLE_LANG,
    mainEntity: doc.faq.map((q) => ({
      "@type": "Question",
      name: q.question,
      acceptedAnswer: { "@type": "Answer", text: q.answer },
    })),
  });
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
---

<Base locale={locale} seccion="investigacion" slug={doc.slug} title={doc.title} description={lead}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <nav class="migas" aria-label={c.breadcrumbResearch}>
    <a href={`/${locale}/`}>{c.breadcrumbHome}</a>
    <span aria-hidden="true">›</span>
    <a href={ruta(locale, "investigacion")}>{c.breadcrumbResearch}</a>
    <span aria-hidden="true">›</span>
    <span>{categoryLabel}</span>
  </nav>

  <h1>{doc.title}</h1>

  <p class="meta">
    <span class="id">{doc.id}</span>
    {" · "}{c.metaDate}: <time datetime={doc.date}>{doc.date}</time>
    {" · "}{doc.words.toLocaleString(locale)}{" "}{c.metaWords}
    {doc.sources.length ? <>{" · "}{doc.sources.length}{" "}{c.metaSources}</> : null}
  </p>

  {/* El resumen ejecutivo, pintado desde los MISMOS bloques que van en
      `abstract`. Va arriba, a tamaño de cuerpo, sin acordeón. */}
  <section class="resumen" lang={summaryHtmlLang} aria-labelledby="resumen-h">
    <h2 id="resumen-h">{c.summaryHeading}</h2>
    {summaryRuns.map((run) =>
      run.kind === "li" ? (
        <ul>{run.items.map((t) => <li>{t}</li>)}</ul>
      ) : (
        run.items.map((t) => <p>{t}</p>)
      ),
    )}
    <p class="meta">{abstractWords.toLocaleString(locale)}{" "}{c.metaWords}</p>
  </section>

  {/* Aviso de idioma. Nunca hay traducción automática ni texto vacío: la página
      dice en qué idioma está lo que sigue (D-033, encargo S1). */}
  <p class="aviso">{langNotice}</p>

  {/* ─── Panel de verificación ───────────────────────────────────────────
      D-033 y plan §4.4: esto va VISIBLE y arriba. Es lo que hace citable la
      investigación en vez de sospechosa. Sin JavaScript, sin acordeón. */}
  <section class="verificacion" id={UNVERIFIED_ANCHOR} aria-labelledby="verificacion-h">
    <h2 id="verificacion-h">{c.verifyHeading}</h2>
    {doc.unverified.length === 0 ? (
      <p>{c.verifyNone}</p>
    ) : (
      <>
        <p>{c.verifyCount}</p>
        <ol class="marcas" lang={ARTICLE_LANG}>
          {doc.unverified.map((u) => <li>{u.sentence}</li>)}
        </ol>
      </>
    )}
    <p>{c.verifyWhat}</p>
    <h3>{c.methodHeading}</h3>
    <p>{c.method}</p>
    <p class="legal">{c.legal}</p>
  </section>

  {/* El cuerpo del documento, completo. `set:html` sobre HTML que produjo el
      pipeline de Markdown de Astro a partir de un archivo de este repositorio:
      no hay entrada de usuario en ninguna parte de esta ruta. */}
  <div class="documento" lang={ARTICLE_LANG} set:html={body} />

  <h2>{c.sourcesHeading}</h2>
  {doc.sources.length === 0 ? (
    <p>{c.sourcesNone}</p>
  ) : (
    <ol class="fuentes">
      {doc.sources.map((s) => (
        <li value={s.n}>
          {/* Sin `nofollow`: enlazar a la fuente primaria es lo que hace
              comprobable la cita, y `mc-48` §2 pone la verificabilidad del
              lado de la Trustworthiness. Un corpus que cita y esconde el
              enlace pide que le crean. */}
          {s.url ? <a href={s.url} rel="noopener">{s.name}</a> : <span>{s.name}</span>}
        </li>
      ))}
    </ol>
  )}

  {doc.openQuestions.length > 0 && (
    <section class="abiertas" aria-labelledby="abiertas-h">
      <h2 id="abiertas-h">{c.openHeading}</h2>
      <p>{c.openIntro}</p>
      <ul lang={ARTICLE_LANG}>
        {doc.openQuestions.map((q) => <li>{q}</li>)}
      </ul>
    </section>
  )}

  <nav class="vecinos" aria-label={c.neighboursLabel}>
    {prev ? (
      <a class="vecino" href={hrefFor(prev.slug)} rel="prev">
        <span class="dir">← {c.prevLabel}</span>
        <span class="tit">{prev.title}</span>
      </a>
    ) : <span></span>}
    {next ? (
      <a class="vecino next" href={hrefFor(next.slug)} rel="next">
        <span class="dir">{c.nextLabel} →</span>
        <span class="tit">{next.title}</span>
      </a>
    ) : <span></span>}
  </nav>

  <p class="corpus">
    {corpusNote}{" "}
    <a href={repoUrl} rel="noopener">{c.repoLabel}</a>
  </p>
</Base>

<style>
  /* Migas y navegación: voz del sistema (D-036). */
  .migas, .vecinos, .corpus {
    font-family: var(--font-sistema);
    font-size: var(--text-xs);
  }
  .migas {
    color: var(--color-text-muted);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-end: 2rem;
  }
  /* WCAG 2.5.8 */
  .migas a { display: inline-flex; align-items: center; min-block-size: var(--tap-min); }

  /* El naranja de Ignia a 2.5rem: texto grande, umbral 3:1, da 3.03:1. En un
     párrafo sería una violación de WCAG — de ahí que el token se llame
     --color-accent y no --color-text (docs/guia-de-estilo.md). */
  h1 { color: var(--color-accent); font-weight: var(--weight-subtitle); }

  .meta { color: var(--color-text-muted); font-size: var(--text-xs); }
  .meta .id {
    font-family: var(--font-mono);
    letter-spacing: normal;
  }

  .resumen { margin-block: 2rem; }
  .resumen h2 { margin-block-start: 0; }
  .resumen p, .resumen li { max-inline-size: var(--measure); }
  .resumen > p:not(.meta) { font-size: var(--text-lg); color: var(--color-text-brand); }
  .resumen ul { padding-inline-start: 1.25rem; }
  .resumen li { margin-block-end: 0.6rem; max-inline-size: var(--measure); }

  /* El aviso de idioma y el panel de verificación NO son notas al pie: son
     media razón de que esta página sea citable (mc-48 §1, plan §4.4). Se
     marcan con superficie y borde, a tamaño de cuerpo, nunca colapsados. */
  .aviso, .verificacion {
    background: var(--color-surface);
    border-inline-start: 3px solid var(--color-accent);
    border-radius: var(--radius);
    padding: 1rem 1.1rem;
    max-inline-size: var(--measure);
  }
  .aviso { margin-block: 1.5rem; }
  .verificacion { margin-block: 1.5rem 2.5rem; }
  .verificacion h2 { margin-block-start: 0; font-size: var(--text-lg); }
  .verificacion h3 { font-size: var(--text-base); margin-block-start: 1.5rem; }
  .verificacion p:last-child { margin-block-end: 0; }
  .verificacion .marcas { padding-inline-start: 1.25rem; }
  .verificacion .marcas li { margin-block-end: 0.75rem; }
  .legal { color: var(--color-text-muted); font-size: var(--text-xs); }

  /* Cuerpo del documento --------------------------------------------------- */
  .documento :global(h2) { margin-block-start: 2.75rem; font-size: var(--text-xl); }
  .documento :global(h3) { margin-block-start: 2rem; font-size: var(--text-lg); }
  .documento :global(h4) { margin-block-start: 1.5rem; font-size: var(--text-base); }
  .documento :global(p),
  .documento :global(li) { max-inline-size: var(--measure); }
  .documento :global(ul),
  .documento :global(ol) { padding-inline-start: 1.25rem; }
  .documento :global(li) { margin-block-end: 0.5rem; }

  /* Las tablas son buena parte del valor de estos documentos. El cuerpo de la
     página nunca se desplaza en horizontal: la tabla se desplaza dentro de su
     propio contenedor. */
  .documento :global(table) {
    display: block;
    overflow-x: auto;
    max-inline-size: 100%;
    border-collapse: collapse;
    font-size: var(--text-xs);
    margin-block: 1.25rem;
  }
  .documento :global(th),
  .documento :global(td) {
    border: 1px solid var(--color-border);
    padding: 0.4rem 0.6rem;
