---
/**
 * `/{locale}/app/` — **la casa del adulto.** Issue #311, D-065.
 *
 * ─── Existía la puerta y no existía la casa ────────────────────────────────
 *
 * Lo encontró el dueño entrando en su iPhone: inicias sesión y aterrizas en una
 * pantalla que no dice nada. `/api/entrar` mandaba a `/app/kids/`, esa página
 * exige la cookie `mc_h` del dispositivo de la casa (D-012), no la tienes, y te
 * rebota a `/app/signin` — que es un relleno escrito **antes** de que existiera
 * la ruta de entrada y que sigue diciendo que no existe.
 *
 * Y el fondo del problema era peor: **`marcarDispositivoDelHogar()` no la
 * llamaba nadie.** Escrita, probada, y jamás invocada. Sin ella `mc_h` no se
 * puede poner nunca, así que `/app/kids/` era inalcanzable — y con ella todo lo
 * que F3, F4 y F5 construyeron. El motor adaptativo, el programador, los 344
 * ítems: desplegados y sin ningún camino desde una cuenta real.
 *
 * ─── D-065: no todo adulto tiene hijos ─────────────────────────────────────
 *
 * Este archivo heredaba `layouts/Base.astro` — el nav de MARKETING, con
 * "Entrar"/"Crear cuenta" como acciones principales para alguien que ya iba
 * inició sesión. El dueño lo encontró en una segunda captura real. La causa de
 * fondo era más profunda que el layout equivocado: la pantalla asumía que todo
 * adulto es un padre. `users.is_learner` existe desde la migración 0001 —
 * "¿este adulto usa el producto para sí mismo?"— y nadie lo leía nunca. Un
 * adulto que se registró por `registro-aprendo` veía la misma sección "Tus
 * hijos" que un padre, vacía y sin sentido para él.
 *
 * ─── #346: y aun así seguían saliendo pestañas de familia sin familia ──────
 *
 * El primer arreglo se pasó al otro lado. `esFamilia = hijos.length > 0 ||
 * !esSolo` daba las tres pestañas de familia a toda cuenta que no se hubiera
 * registrado por la puerta «quiero aprender yo», y el dueño volvió a abrir su
 * iPhone —cero hijos— para encontrarse «Hijos · Progreso · Tiemp». La regla
 * vuelve a ser la de D-065 punto 3: **hay pestañas de familia cuando hay al
 * menos un hijo**, y el primer hijo se crea desde «Cuenta», que toda cuenta ve.
 * El detalle completo está en `lib/pestanas-privadas.ts`.
 *
 * ─── Esto es SSR, y no por gusto ───────────────────────────────────────────
 *
 * Lee cookies y consulta la base. Una página prerrenderizada no ve ni lo uno ni
 * lo otro, y este repositorio ya se llevó ese golpe tres veces. Es la excepción
 * que justifica el costo: una página por visita, detrás de sesión, que nadie
 * cachea de todas formas.
 *
 * ─── Superficie de ADULTO ──────────────────────────────────────────────────
 *
 * `layouts/Privada.astro` (D-065): tokens SERIO, blancos de 44px —no los 88 de
 * kinder—, y ni una palabra dirigida a un menor. Un niño que llegue aquí no
 * encuentra nada suyo.
 */
export const prerender = false;

import Privada from "../../../layouts/Privada.astro";
import RecordatorioPush from "../../../components/push/RecordatorioPush.astro";
import { t, isLocale, type Locale } from "../../../i18n";
import { COOKIE_ADULTO, leerCookies, leerSesionAdulto, COOKIE_HOGAR } from "../../../lib/sesiones";
import { rutaKids, rutaPerfilNuevo, rutaLimiteHijo, rutaTablero, rutaTableroHijo, rutaLiga, rutaPanel, rutaGrupos, rutaGruposNuevo } from "../../../lib/rutas-app";
import { estadoDeParticipacion } from "../../../lib/liga-membresia";
import { TEXTOS_PADRE } from "../../../components/parent/textos";
import { TEXTOS_TABLERO } from "../../../components/tablero/textos";
import { TEXTOS_GRUPOS } from "../../../components/grupos/textos";
import { f9Habilitado } from "../../../lib/grupo-flag";
import {
  pestanasPrivadas,
  clavesDePestana,
  type ClavePestana,
} from "../../../lib/pestanas-privadas";
import { ruta } from "../../../i18n/rutas";
import MenuMisiones from "../../../components/misiones/MenuMisiones.astro";
import ResumenMisiones from "../../../components/misiones/ResumenMisiones.astro";
import { leerMisionesDeHoy, cierreDeHoy, BONO_DIA_COMPLETO } from "../../../lib/misiones-dia";

// El enlace a la pausa familiar (#204). El título vive en su propio catálogo,
// como el de la racha: el copy del subsistema no se reparte entre archivos.
import enPausa from "../../../i18n/pausa/en.json";
import esMXPausa from "../../../i18n/pausa/es-MX.json";
import esESPausa from "../../../i18n/pausa/es-ES.json";
import esFRPausa from "../../../i18n/pausa/fr-FR.json";
import ptBRPausa from "../../../i18n/pausa/pt-BR.json";
import ptPTPausa from "../../../i18n/pausa/pt-PT.json";
import deDEPausa from "../../../i18n/pausa/de-DE.json";

const TEXTOS_PAUSA: Record<string, typeof enPausa> = {
  "en": enPausa,
  "es-MX": esMXPausa,
  "es-ES": esESPausa,
  "fr-FR": esFRPausa,
  "pt-BR": ptBRPausa,
  "pt-PT": ptPTPausa,
  "de-DE": deDEPausa,
};

const { locale: raw } = Astro.params;
if (!isLocale(raw)) return Astro.redirect("/en/");
const locale: Locale = raw;
const m = t(locale);
const pPausa = TEXTOS_PAUSA[locale] ?? enPausa;

const env = (Astro.locals as { runtime?: { env: { DB?: D1Database; SESSION_KV?: KVNamespace; CONFIG_KV?: KVNamespace } } })
  .runtime?.env;

const cookies = leerCookies(Astro.request.headers.get("cookie"));
const sesion = env?.SESSION_KV
  ? await leerSesionAdulto(env.SESSION_KV, cookies[COOKIE_ADULTO])
  : null;

// Sin sesión, a la puerta. **Se falla cerrado**: esta página lista a los hijos
// de alguien y lee si la cuenta practica por su cuenta.
// `?cambiar=1` y no `/entrar/` a secas: sin eso hay un bucle infinito real.
// Desde #339, `/entrar/` lleva un script que redirige a la casa si encuentra la
// pista `mc_p`. Las dos cookies caducan juntas, pero una sesión se puede
// invalidar ANTES que su cookie —cambiar la contraseña cierra las demás, y KV
// expira por su cuenta—, y en ese hueco:
//
//     /app/ → sin sesión → /entrar/ → hay mc_p → /app/ → sin sesión → …
//
// El navegador gira hasta rendirse, delante de alguien que solo quería volver a
// entrar. `?cambiar=1` es la única cadena que ese script respeta. Se vio
// probando la redirección con la pista puesta y la sesión ausente, no razonando.
if (!sesion) return Astro.redirect(`${ruta(locale, "entrar")}?cambiar=1`);

/**
 * Los hijos de esta cuenta. Solo alias y banda — lo que hace falta para
 * reconocerlos. Ni el año de nacimiento sale de la base aquí: no se pinta, así
 * que no se pide (`mc-25`, D-013).
 */
let hijos: Array<{ id: string; alias: string; theme_band: string }> = [];
if (env?.DB) {
  try {
    const rHijos = await env.DB.prepare(
      "SELECT id, alias, theme_band FROM child_profiles WHERE parent_user_id = ? AND deleted_at IS NULL ORDER BY created_at",
    )
      .bind(sesion.userId)
      .all<{ id: string; alias: string; theme_band: string }>();
    hijos = rHijos.results ?? [];
  } catch {
    // Sin base, la casa se enseña vacía en vez de dar un 500. El adulto puede
    // marcar el aparato y añadir su passkey igual.
    hijos = [];
  }
}

/*
 * La liga de cada hijo, para el interruptor de la vista «Hijos» (F7 #243,
 * D-081). El estado EFECTIVO —default de la banda más lo que el padre haya
 * decidido— lo calcula `estadoDeParticipacion`: es la misma lectura que hace
 * el alta, así que el interruptor no puede mostrar una cosa y hacer otra.
 * Sin base, todos apagados en la pantalla: el interruptor fallaría igual al
 * usarse, y un control que no obedece no debe prometer que sí.
 */
const ligaPorHijo = new Map<string, boolean>();
if (env?.DB) {
  for (const h of hijos) {
    const p = await estadoDeParticipacion(env, { id: h.id, esAdulto: false });
    ligaPorHijo.set(h.id, p !== null);
  }
}

/** ¿Ya está marcado este aparato? La cookie basta: la fila la valida `/app/kids`. */
const aparatoMarcado = Boolean(cookies[COOKIE_HOGAR]);

/**
 * ─── Una cuenta es de familia cuando TIENE hijos. Punto. (issue #346) ──────
 *
 * Esto decía `hijos.length > 0 || !esSolo`, y lo escribí yo arreglando «la casa
 * no tiene menú» (#344). El efecto fue el contrario del que D-065 punto 3 pide:
 * toda cuenta que no se hubiera registrado por la puerta «quiero aprender yo»
 * —o sea casi todas— recibía las tres pestañas del modo familia. El dueño abrió
 * su iPhone sin un solo hijo cargado y leyó:
 *
 *     Hijos    Progreso (Próximamente)    Tiemp    Cerrar sesión
 *
 * Tres destinos de familia, dos de ellos vacíos por construcción, para alguien
 * que no tiene familia en el producto.
 *
 * **Y el primer hijo se sigue pudiendo crear**, que era el motivo real de aquel
 * `|| !esSolo`: el botón se mudó a «Cuenta» (`app/perfil.astro`), que toda
 * cuenta ve siempre. En cuanto existe un hijo, las tres pestañas aparecen solas
 * — sin interruptor, sin pregunta, sin pantalla intermedia.
 *
 * `users.is_learner` ya no se lee aquí, y es a propósito: con esta regla no
 * cambia nada de lo que se pinta. Vuelve a ser una columna sin lector, y esa es
 * exactamente la deuda que cierra el interruptor de modo familia/solo que el
 * dueño pidió — ver `lib/pestanas-privadas.ts`.
 */
const tieneHijos = hijos.length > 0;

// Las pestañas, en un solo sitio para las dos rutas de esta superficie
// (`app/index.astro` y `app/perfil.astro`). Ver `lib/pestanas-privadas.ts`.
const vistasDisponibles = clavesDePestana(tieneHijos);

/*
 * ─── Qué vista se pinta ───────────────────────────────────────────────────
 *
 * Sin hijos, se aterriza en PRACTICAR. Con hijos, en Hijos.
 *
 * Antes era «la primera pestaña real», que siempre daba «Hijos», así que quien
 * no tiene un solo hijo entraba a una pantalla que le habla de sus hijos, le
 * ofrece crear uno y le pregunta si el aparato es de la casa. Es lo que el
 * dueño leyó en su teléfono, con mayúsculas: «No tengo hijos».
 *
 * Los dos modos son iguales de importantes. Quien juega solo entra a jugar.
 */
const vistaPedida = Astro.url.searchParams.get("vista") as ClavePestana | null;

/*
 * `?vista=cuenta` ya no es una vista de esta página: «Cuenta» tiene su ruta,
 * `/app/perfil/`, como D-065 punto 7 mandaba. El enlace viejo sigue existiendo
 * en marcadores, en el historial y en cualquier pestaña abierta desde ayer, así
 * que se redirige en vez de caer en el aterrizaje por defecto — que dejaría a
 * quien buscaba su contraseña mirando un reto de kinder.
 */
if (vistaPedida === "cuenta") return Astro.redirect(`/${locale}/app/perfil/`);

/*
 * `?vista=progreso` tampoco es ya una vista de esta página: «Progreso» es el
 * panel del padre (F8 #277-#285) y vive en `/app/parent/panel/`. El enlace
 * viejo sigue en marcadores e historiales — mismo motivo que «cuenta» — y la
 * tarjeta de «próximamente» que esta vista pintaba quedaría mintiendo:
 * la pantalla ya existe.
 */
if (vistaPedida === "progreso") return Astro.redirect(rutaPanel(locale));

const vista: ClavePestana =
  vistaPedida && vistasDisponibles.includes(vistaPedida)
    ? vistaPedida
    : (tieneHijos ? "hijos" : "practicar");

const pestanas = pestanasPrivadas(locale, tieneHijos, vista);

/*
 * ─── Las misiones del día del propio adulto (F7 · #211) ─────────────────────
 *
 * Se anuncian al EMPEZAR la sesión y se resumen al TERMINARLA — esta página es
 * los dos extremos: de aquí se sale hacia `/app/practicar/` y aquí se vuelve al
 * tocar «terminar» (`salirA` de la pantalla del reto). El reto activo, en
 * medio, no las conoce por ninguna vía (#221, `audits/mision-silenciosa.mjs`).
 *
 * El caso real de hoy es el adulto aprendiz: SERIO es la única banda ≥ PRIMARIA
 * con contenido (D-034). KINDER no tiene menú (#213) y el punto de montaje del
 * niño de PRIMARIA en adelante queda diferido — su única pantalla después del
 * PIN es la del reto activo, donde #221 prohíbe las misiones. Dicho en el PR,
 * no escondido aquí.
 *
 * Solo se lee en la vista «Practicar»: en las demás nadie las ve y sería una
 * consulta regalada. Si no hay base o la lectura falla, `leerMisionesDeHoy`
 * devuelve `null` y sencillamente no se pinta el bloque — nunca se le niega el
 * juego a nadie por un contador.
 */
const misionesHoy =
  vista === "practicar" && env?.DB
    ? await leerMisionesDeHoy(env, { id: sesion.userId, esAdulto: true }, "SERIO", Date.now())
    : null;
const entradasMenu = (misionesHoy?.entradas ?? []).map((e) => ({
  tipo: e.mision.tipo,
  xp: e.mision.xp,
  meta: e.mision.meta,
  progreso: e.estado.progress,
  completada: e.estado.completed === 1,
}));
const cierreHoy = misionesHoy ? cierreDeHoy(misionesHoy) : null;
const logrosHoy = (misionesHoy?.entradas ?? [])
  .filter((e) => e.estado.completed === 1)
  .map((e) => ({ tipo: e.mision.tipo, xp: e.mision.xp }));

/*
 * El título y la entradilla dependen de si HAY HIJOS, no del tipo de cuenta.
 *
 * El dueño lo leyó en su teléfono: «me sigue diciendo algo de hijos. No tengo
 * hijos». Desde #346 las dos preguntas —qué pestañas existen y qué se dice— se
 * responden con el mismo dato, que es como debió estar siempre.
 */
const titulo = tieneHijos ? m.casaTitulo : m.casaTituloSolo;
const lead = tieneHijos ? m.casaLead : m.casaLeadSolo;

/*
 * La entrada al área de grupos (F9 · #387, D-093/D-094 del reparto). Área
 * propia del adulto — no una sexta pestaña— y con la bandera de mercado
 * DELANTE: apagada, la casa no muestra ninguna entrada a F9 (criterio de
 * #387: la bandera se verifica antes de mostrar cualquier entrada). Sin
 * nagging (D-026): es un bloque más de la casa, no un aviso que empuja.
 */
const gruposHabilitados = await f9Habilitado(env?.CONFIG_KV, locale);
const gGrupos = TEXTOS_GRUPOS[locale];
---

<Privada locale={locale} title={titulo} description={lead} pestanas={pestanas}>
  <article class="casa">
    <h1>{titulo}</h1>
    <p class="lead">{lead}</p>

    {vista === "hijos" && (
      <Fragment>
        {/* ── Los hijos ───────────────────────────────────────────────────── */}
        <section class="bloque">
          <h2>{m.casaHijos}</h2>
          {hijos.length === 0 ? (
            <p class="muted">{m.casaSinHijos}</p>
          ) : (
            <ul class="hijos">
              {hijos.map((h) => (
                <li class="hijo">
                  <span class="alias">{h.alias}</span>
                  <span class="banda">{h.theme_band}</span>
                  {/*
                    La pausa familiar (#204) se declara por hijo, desde la casa.
                    Una pantalla sin enlace es una pantalla que no existe.
                  */}
                  <a class="pausa" href={`/${locale}/app/pausa/?hijo=${h.id}`}>{pPausa["pausa.titulo"]}</a>
                  {/*
                    El opt-in del tablero, por hijo (F7 #247, D-040) — y en
                    KINDER, el único lugar donde su tablero existe (D-081).
                  */}
                  <a class="pausa" href={rutaTableroHijo(locale, h.id)}>{TEXTOS_TABLERO[locale]["tablero.padre.abrir"]}</a>{/*
                    El interruptor de la liga (F7 #243, D-081): la banda más
                    chica arranca apagada y el padre la activa aquí; de PRIMARIA
                    en adelante arranca encendida y aquí se puede apagar. La
                    baja revoca, nunca borra — y saca al perfil de la tabla viva
                    en el mismo acto. Formulario de verdad, sin JavaScript: un
                    aparato de gama baja tiene que poder apagarla aunque el
                    script no cargue (mc-47 §5).
                  */}
                  <form class="ligaOptin" method="post" action="/api/optin-hijo">
                    <input type="hidden" name="hijo" value={h.id} />
                    <input type="hidden" name="locale" value={locale} />
                    <input type="hidden" name="accion" value={ligaPorHijo.get(h.id) ? "revocar" : "activar"} />
                    <span class="estado">
                      {ligaPorHijo.get(h.id) ? m.casaLigaActiva : m.casaLigaApagada}
                    </span>
                    <button type="submit" class="boton">
                      {ligaPorHijo.get(h.id) ? m.casaLigaQuitar : m.casaLigaActivar}
                    </button>
                  </form>
                </li>
              ))}
            </ul>
          )}
          {hijos.length > 0 && <p class="muted">{m.casaLigaNota}</p>}
          <a class="boton" href={rutaPerfilNuevo(locale)}>{m.casaNuevoHijo}</a>
          {aparatoMarcado && hijos.length > 0 && (
            <a class="boton primario" href={rutaKids(locale)}>{m.casaJugar}</a>
          )}
        </section>

        {/* ── El aparato de la casa (D-012) ───────────────────────────────── */}
        {!aparatoMarcado && (
          <section class="bloque">
            <h2>{m.casaAparatoTitulo}</h2>
            {/*
              El texto dice qué significa marcar, no solo pide que se marque. D-012:
              la protección real la da el dispositivo, y una decisión que protege
              solo funciona si quien la toma sabe qué está decidiendo.
            */}
            <p class="muted">{m.casaAparatoTexto}</p>
            <button type="button" class="boton primario" id="marcar">{m.casaAparatoCta}</button>
            <p class="ok" id="marcado" hidden>{m.casaAparatoListo}</p>
          </section>
        )}
      </Fragment>
    )}

    {vista === "limite" && (
      <section class="bloque">
        <h2>{m.casaTabLimite}</h2>
        {/*
          La pantalla del límite por hijo (F8 #269). Un enlace por perfil, con
          el mismo patrón de lista que la vista «Hijos». El texto del enlace
          vive en `i18n/padre/`, no en las llaves globales: es copy de esta
          superficie y no de toda la casa.
        */}
        <ul class="hijos">
          {hijos.map((h) => (
            <li class="hijo">
              <span class="alias">{h.alias}</span>
              <a class="boton" href={rutaLimiteHijo(locale, h.id)}>
                {TEXTOS_PADRE[locale]["padre.limite.abrir"]}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/*
      «Practicar» ya no es un cartel de «próximamente»: es la puerta a un reto
      de verdad. No pide marcar el aparato ni un PIN — esas dos protegen a un
      NIÑO en un aparato compartido (D-012), y quien está aquí ya demostró
      quién es con su sesión.

      El comentario va FUERA del `&& (`: dentro, es un segundo hijo del
      paréntesis y el build revienta con «Expected ) but found $$render».
    */}
    {vista === "practicar" && (
      <section class="bloque">
        <h2>{m.practicarTitulo}</h2>
        <p class="muted">{m.practicarLead}</p>
        <p class="muted">{m.practicarAviso}</p>
        <a class="boton primario" href={`/${locale}/app/practicar/`}>{m.casaPracticarCta}</a>{/*
          El mapa de progreso del propio adulto (F7, #230-#234). No es la
          pestaña «Progreso» —esa es F8 y es lo que un padre ve de sus hijos—:
          es lo que TÚ ves de tu propio aprendizaje, y hasta ahora el adulto que
          aprende solo (D-034) no tenía dónde mirar lo suyo.

          Va aquí porque una página sin enlace es una página que no existe, y
          porque «Practicar» ya es donde vive todo lo del adulto que juega solo.
        */}
        <a class="boton" href={`/${locale}/app/mapa/`}>{m.casaMapaCta}</a>{/*
          El tablero global del propio adulto (F7 #247, D-025): su banda,
          ordenada por puntos, con «tú estás aquí» aunque quede fuera del top
          100. Misma razón de sitio que el mapa: «Practicar» es donde vive
          todo lo del adulto que juega solo.
        */}
        <a class="boton" href={rutaTablero(locale)}>{TEXTOS_TABLERO[locale]["tablero.abrir"]}</a>{/*
          La liga semanal del propio adulto (F7, #237, #242): su cohorte de
          ~30 con alias generado, nunca su nombre. Mismo criterio que el mapa:
          una página sin enlace es una página que no existe.
        */}
        <a class="boton" href={rutaLiga(locale)}>{m.casaLigaCta}</a>{/*
          Y su propia pausa (#204, banda SERIO/JR/PRO): el adulto aprendiz se la
          autodeclara, mismo mecanismo y mismo tope, sin aprobación de nadie.
        */}
        <a class="boton" href={`/${locale}/app/pausa/`}>{pPausa["pausa.titulo"]}</a>
      </section>
    )}

    {/*
      ─── D-082 (#390): la cuenta nace en modo solo y CRECE desde aquí ────────

      Toda cuenta nueva aterriza en esta vista. Las dos acciones que antes eran
      una elección en la puerta («¿eres papá o maestro?») son ahora botones
      visibles y opcionales en la casa:

        · «Agregar un hijo» dispara el flujo `setup/child` de siempre, SIN
          ningún cambio a esas pantallas — lo único que cambió es CUÁNDO se
          ofrece: después de la cuenta, no en el registro.
        · «Crear un salón» dispara `owner/identity` (D-011) vía `grupos/nuevo`,
          que redirige a la identidad declarada cuando falta. Mismo principio
          de fricción-después-del-registro, extendido al papá.

      Las dos son ACTIVACIONES, no una migración de modo: `esFamilia` sigue
      derivándose de los datos reales (D-065) y nada aquí lee `signup_intent`.

      El salón se ofrece solo donde la bandera de mercado de F9 está encendida
      (#387): en los locales apagados no se nombra el área, que es lo que ese
      criterio manda — la interfaz no muestra una entrada rota, muestra nada.
    */}
    {vista === "practicar" && (
      <section class="bloque">
        <h2>{m.casaActivarTitulo}</h2>
        <p class="muted">{m.casaActivarTexto}</p>
        <a class="boton" href={rutaPerfilNuevo(locale)}>{m.casaNuevoHijo}</a>
        {gruposHabilitados && (
          <a class="boton" href={rutaGruposNuevo(locale)}>{gGrupos["grupo.indice.crear"]}</a>
        )}
      </section>
    )}

    {/*
      Las misiones del día, ANTES de entrar al reto (el anuncio del principio de
      la sesión) y el resumen de lo logrado hoy (el cierre, al volver). Ninguno
      de los dos vive dentro del reto activo: #221, §3.6 del diseño.
    */}
    {vista === "practicar" && entradasMenu.length > 0 && (
      <section class="bloque">
        <MenuMisiones
          locale={locale}
          entradas={entradasMenu}
          metaColectiva={misionesHoy?.resumenLiga.metaColectivaHoy ?? null}
        />
      </section>
    )}
    {vista === "practicar" && cierreHoy !== null && cierreHoy.logradas.length > 0 && (
      <section class="bloque">
        <ResumenMisiones
          locale={locale}
          logros={logrosHoy}
          xpTotal={cierreHoy.xp}
          diaCompleto={cierreHoy.diaCompleto}
          xpBono={BONO_DIA_COMPLETO}
        />
      </section>
    )}

    {/*
      ─── «Cuenta» ya NO se pinta aquí ────────────────────────────────────

      D-065 punto 7 dijo desde el principio que passkey y contraseña viven en
      `/app/perfil/`, una ruta propia. Se quedaron TAMBIÉN aquí porque cuando
      se escribió la pestaña ese destino no existía y llevaba a un 404 real.
      Existe desde #340 — y desde entonces hubo dos altas de passkey y dos
      cambios de contraseña, en dos archivos, con el mismo `id="passkey"` y el
      mismo `id="cambiar-clave"`. Dos copias de un formulario de credenciales
      no se mantienen sincronizadas: la de `perfil.astro` ya había ganado la
      pista de longitud de contraseña (#333) y esta no.

      La pestaña apunta a `/app/perfil/` y `?vista=cuenta` redirige allí
      (arriba, en el frontmatter), así que ningún enlace viejo se rompe.
    */}
    {/*
      El recordatorio push al padre (F7 #207, D-105). Vive en las dos vistas
      que son del propio adulto —la de sus hijos y la de su propia práctica—
      porque el recordatorio es del HOGAR: sirve igual al padre de tres que al
      adulto que aprende solo (issue #207 § banda adulta). El componente nace
      oculto y solo aparece cuando el navegador y la cuenta dicen qué estado
      toca; el soft-ask, la puerta de iOS y el silencio permanente son suyos.
    */}
    {(vista === "hijos" || vista === "practicar") && <RecordatorioPush locale={locale} />}

    {/*
      La entrada a `/app/grupos/` (F9 · #381-#383). Visible solo con la
      bandera de mercado encendida — en los locales apagados ni siquiera se
      nombra el área, que es exactamente lo que #387 pide: la interfaz no
      muestra una entrada rota, muestra nada.
    */}
    {gruposHabilitados && (
      <section class="bloque">
        <h2>{gGrupos["grupo.casa.titulo"]}</h2>
        <p class="muted">{gGrupos["grupo.casa.lead"]}</p>
        <a class="boton" href={rutaGrupos(locale)}>{gGrupos["grupo.casa.entrar"]}</a>
      </section>
    )}

  </article>

  <style>
    .casa { padding-block: calc(var(--space) * 2); }
    h1 { font-family: var(--font-marca); font-weight: var(--weight-title); font-size: var(--text-xl);
         color: var(--color-text-brand); margin-block-end: var(--space); }
    .lead { font-family: var(--font-marca); font-size: var(--text-lg); line-height: var(--leading-body);
            margin-block-end: calc(var(--space) * 2); }
    .bloque { border: 1px solid var(--color-border); border-radius: var(--radius);
              padding: var(--space); margin-block-end: calc(var(--space) * 1.5); }
    .bloque.proximamente { color: var(--color-text-muted); }
    h2 { font-family: var(--font-sistema); font-size: var(--text-base); font-weight: var(--weight-subtitle);
         margin: 0 0 calc(var(--space) * 0.5); }
    .muted { color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-body);
             margin-block-end: var(--space); }
    .hijos { list-style: none; padding: 0; margin: 0 0 var(--space); display: flex; flex-direction: column; gap: 0.5rem; }
    .hijo { display: flex; justify-content: space-between; align-items: center; gap: var(--space);
            flex-wrap: wrap;
            padding: 0.6rem 0.8rem; border: 1px solid var(--color-border); border-radius: var(--radius); }
    .alias { font-family: var(--font-sistema); font-weight: var(--weight-subtitle); }
    .banda { font-size: var(--text-xs); color: var(--color-text-muted); }
    .pausa { display: inline-flex; align-items: center; min-block-size: 24px;
             font-size: var(--text-xs); color: var(--color-text-muted); }
    /* El interruptor de la liga va dentro de la fila del hijo: estado en texto
       (nunca solo color, WCAG 2.2 §1.4.1) y botón con la vara del adulto. */
    .ligaOptin { display: flex; align-items: center; gap: 0.5rem; margin: 0; }
    .ligaOptin .estado { font-size: var(--text-xs); color: var(--color-text-muted); white-space: nowrap; }
    .ligaOptin .boton { min-height: 44px; margin-inline-end: 0; }
    /* 44px, la vara del ADULTO. Los 88 de kinder son para las superficies de niño. */
    .boton { display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
             padding-inline: 1rem; margin-inline-end: 0.5rem; border-radius: var(--radius);
             border: 1px solid var(--color-border); background: transparent; color: var(--color-text);
             font-family: var(--font-sistema); font-size: var(--text-base); text-decoration: none; cursor: pointer; }
    .boton.primario { background: var(--color-accent); color: var(--color-on-accent); border-color: transparent; }
    .boton:focus-visible { outline: 3px solid var(--color-text); outline-offset: 2px; }
    .ok { color: var(--color-text-brand); font-size: var(--text-sm); margin-block-start: 0.5rem; }
    /* Se fueron con la vista «Cuenta»: `.mal`, `.campo`, `label` e `input` solo
       vestían el formulario de contraseña, que ahora vive una vez, en
       `app/perfil.astro`. CSS de un formulario que no está es CSS que el
       siguiente cambio va a mantener sin motivo. */
  </style>

  {/*
    Un solo script, y ya solo hace UNA cosa: marcar el aparato.

    Llevaba también el alta de passkey y el cambio de contraseña, copiados de
    `app/perfil.astro` con los mismos identificadores. Se fueron con la vista
    «Cuenta»; con ellos se fue el `define:vars` de mensajes de error, que ya no
    tenía a quién servir.
  */}
  <script is:inline>
    // `is:inline` — Astro NO compila esto, así que aquí abajo va JS PURO: sin
    // `as Tipo`, sin anotaciones. Es exactamente la clase de bug que rompió el
    // login el 2026-08-02 (ver CLAUDE.md § Cloudflare), y el guardián
    // `audits/script-cliente-sin-ts.mjs` lo vigila en cada commit.

    // ── Marcar el aparato (D-012) ────────────────────────────────────────
    const bMarcar = document.getElementById("marcar");
    bMarcar?.addEventListener("click", async () => {
      bMarcar.disabled = true;
      const r = await fetch("/api/casa?accion=dispositivo", { method: "POST" })
        .then((res) => res.json())
        .catch(() => ({}));
      if (r.ok) {
        const marcado = document.getElementById("marcado");
        if (marcado) marcado.hidden = false;
        // Se recarga para que aparezca el botón de ir con los niños: la página
        // es del servidor y él es quien sabe si ya hay cookie.
        location.reload();
        return;
      }
      bMarcar.disabled = false;
    });
  </script>
</Privada>
