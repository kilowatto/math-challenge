---
/**
 * `/{locale}/app/` — **la casa del adulto.** Issue #311, D-065.
 *
 * ─── Existía la puerta y no existía la casa ────────────────────────────────
 *
 * Lo encontró el dueño entrando en su iPhone: inicias sesión y aterrizas en una
 * pantalla que no dice nada. `/api/entrar` mandaba a `/app/kids/`, esa página
 * exige la cookie `mc_h` del dispositivo de la casa (D-012), no la tienes, y te
 * rebota a `/app/signin` — que es un relleno escrito **antes** de que existiera
 * la ruta de entrada y que sigue diciendo que no existe.
 *
 * Y el fondo del problema era peor: **`marcarDispositivoDelHogar()` no la
 * llamaba nadie.** Escrita, probada, y jamás invocada. Sin ella `mc_h` no se
 * puede poner nunca, así que `/app/kids/` era inalcanzable — y con ella todo lo
 * que F3, F4 y F5 construyeron. El motor adaptativo, el programador, los 344
 * ítems: desplegados y sin ningún camino desde una cuenta real.
 *
 * ─── D-065: no todo adulto tiene hijos ─────────────────────────────────────
 *
 * Este archivo heredaba `layouts/Base.astro` — el nav de MARKETING, con
 * "Entrar"/"Crear cuenta" como acciones principales para alguien que ya iba
 * inició sesión. El dueño lo encontró en una segunda captura real. La causa de
 * fondo era más profunda que el layout equivocado: la pantalla asumía que todo
 * adulto es un padre. `users.is_learner` existe desde la migración 0001 —
 * "¿este adulto usa el producto para sí mismo?"— y nadie lo leía nunca. Un
 * adulto que se registró por `registro-aprendo` veía la misma sección "Tus
 * hijos" que un padre, vacía y sin sentido para él.
 *
 * Ahora la pantalla lee `is_learner` igual que ya leía `child_profiles`, y las
 * pestañas que se enseñan dependen de lo que la cuenta REALMENTE es — que
 * pueden ser las dos cosas a la vez (D-034 cita al propio dueño como ejemplo:
 * papá y aprendiz adulto en la misma cuenta).
 *
 * ─── Esto es SSR, y no por gusto ───────────────────────────────────────────
 *
 * Lee cookies y consulta la base. Una página prerrenderizada no ve ni lo uno ni
 * lo otro, y este repositorio ya se llevó ese golpe tres veces. Es la excepción
 * que justifica el costo: una página por visita, detrás de sesión, que nadie
 * cachea de todas formas.
 *
 * ─── Superficie de ADULTO ──────────────────────────────────────────────────
 *
 * `layouts/Privada.astro` (D-065): tokens SERIO, blancos de 44px —no los 88 de
 * kinder—, y ni una palabra dirigida a un menor. Un niño que llegue aquí no
 * encuentra nada suyo.
 */
export const prerender = false;

import Privada from "../../../layouts/Privada.astro";
import { t, isLocale, type Locale } from "../../../i18n";
import { COOKIE_ADULTO, leerCookies, leerSesionAdulto, COOKIE_HOGAR } from "../../../lib/sesiones";
import { rutaKids, rutaPerfilNuevo } from "../../../lib/rutas-app";
import { ruta } from "../../../i18n/rutas";

const { locale: raw } = Astro.params;
if (!isLocale(raw)) return Astro.redirect("/en/");
const locale: Locale = raw;
const m = t(locale);

const env = (Astro.locals as { runtime?: { env: { DB?: D1Database; SESSION_KV?: KVNamespace } } })
  .runtime?.env;

const cookies = leerCookies(Astro.request.headers.get("cookie"));
const sesion = env?.SESSION_KV
  ? await leerSesionAdulto(env.SESSION_KV, cookies[COOKIE_ADULTO])
  : null;

// Sin sesión, a la puerta. **Se falla cerrado**: esta página lista a los hijos
// de alguien y lee si la cuenta practica por su cuenta.
// `?cambiar=1` y no `/entrar/` a secas: sin eso hay un bucle infinito real.
// Desde #339, `/entrar/` lleva un script que redirige a la casa si encuentra la
// pista `mc_p`. Las dos cookies caducan juntas, pero una sesión se puede
// invalidar ANTES que su cookie —cambiar la contraseña cierra las demás, y KV
// expira por su cuenta—, y en ese hueco:
//
//     /app/ → sin sesión → /entrar/ → hay mc_p → /app/ → sin sesión → …
//
// El navegador gira hasta rendirse, delante de alguien que solo quería volver a
// entrar. `?cambiar=1` es la única cadena que ese script respeta. Se vio
// probando la redirección con la pista puesta y la sesión ausente, no razonando.
if (!sesion) return Astro.redirect(`${ruta(locale, "entrar")}?cambiar=1`);

/**
 * Los hijos de esta cuenta. Solo alias y banda — lo que hace falta para
 * reconocerlos. Ni el año de nacimiento sale de la base aquí: no se pinta, así
 * que no se pide (`mc-25`, D-013).
 */
let hijos: Array<{ id: string; alias: string; theme_band: string }> = [];
let esSolo = false;
if (env?.DB) {
  try {
    const [rHijos, rUsuario] = await Promise.all([
      env.DB.prepare(
        "SELECT id, alias, theme_band FROM child_profiles WHERE parent_user_id = ? AND deleted_at IS NULL ORDER BY created_at",
      )
        .bind(sesion.userId)
        .all<{ id: string; alias: string; theme_band: string }>(),
      env.DB.prepare("SELECT is_learner FROM users WHERE id = ?")
        .bind(sesion.userId)
        .first<{ is_learner: number }>(),
    ]);
    hijos = rHijos.results ?? [];
    esSolo = rUsuario?.is_learner === 1;
  } catch {
    // Sin base, la casa se enseña vacía en vez de dar un 500. El adulto puede
    // marcar el aparato y añadir su passkey igual.
    hijos = [];
    esSolo = false;
  }
}

/** ¿Ya está marcado este aparato? La cookie basta: la fila la valida `/app/kids`. */
const aparatoMarcado = Boolean(cookies[COOKIE_HOGAR]);

/**
 * Una cuenta es de FAMILIA por lo que es, no por lo que ya alcanzó a hacer.
 *
 * Esto decía `hijos.length > 0`, y con eso un padre que acababa de registrarse
 * —cero hijos todavía, que es el estado de TODA cuenta nueva— no era ni familia
 * ni aprendiz. Se quedaba con una sola pestaña, «Cuenta», así que:
 *
 *   · la franja de pestañas no se pintaba (`Privada.astro` la oculta con una
 *     sola: un menú de un elemento no es un menú), y el dueño lo reportó como
 *     «sin menú»;
 *   · la vista de aterrizaje era «Cuenta», o sea que entrar te dejaba en
 *     contraseñas y llaves de acceso — el mismo aterrizaje equivocado que ya se
 *     había corregido antes;
 *   · y no había **ninguna** forma de crear el primer perfil de hijo, porque el
 *     botón vive en la pestaña «Hijos», que no existía.
 *
 * Un padre recién registrado quedaba encerrado en la pantalla de ajustes de su
 * cuenta. La pantalla vacía correcta ya estaba escrita —«todavía no hay nadie»
 * más el botón de añadir— y era inalcanzable.
 *
 * `is_learner` marca a quien se registró por la puerta «quiero aprender yo»
 * (D-026). Todo lo demás es una cuenta de adulto a cargo de alguien, tenga hijos
 * cargados o no. Quien es las dos cosas ve las dos.
 */
const esFamilia = hijos.length > 0 || !esSolo;

/**
 * Las pestañas, derivadas de lo que la cuenta REALMENTE tiene — no de por
 * dónde se registró (D-065).
 *
 * "Cuenta" (passkey, contraseña) se pensó para vivir en `/app/perfil/`, una
 * ruta aparte que otra sesión está construyendo en paralelo — pero mientras
 * esa ruta no exista de verdad, apuntar la pestaña ahí es un 404 real: se
 * vio pasar en vivo, un padre probando el cambio lo encontró de inmediato.
 * Hasta que `/app/perfil/` esté desplegada, "Cuenta" se queda AQUÍ, como una
 * vista más — un callejón sin salida es peor que una página que no se ve
 * tan limpia como se planeó.
 *
 * Tope de 5 (HIG, Material 3 — mc-49). Progreso/Límite de pantalla son F8
 * (D-057, ya decidido, todavía sin construir); Practicar es F5b/F10 (D-034,
 * también sin construir). Se enseñan igual, marcadas "Próximamente": el dueño
 * prefirió dejar el hueco visible a rehacer la navegación cuando esas fases
 * lleguen.
 */
type Clave = "hijos" | "progreso" | "limite" | "practicar" | "cuenta";
// «Practicar» YA no es próximamente: `/app/practicar/` existe y sirve retos
// reales del mismo motor. Lo que sigue sin construirse son Progreso y Límite
// de pantalla (F8, D-057).
const PROXIMAMENTE = new Set<Clave>(["progreso", "limite"]);
const vistasDisponibles: Clave[] = [
  ...(esFamilia ? (["hijos", "progreso", "limite"] as Clave[]) : []),
  // **Practicar la ve TODO EL MUNDO**, no solo quien se registró por la puerta
  // «quiero aprender yo». Math Challenge tiene dos modos —familia y solo— y son
  // igual de importantes: un padre también puede querer jugar, y alguien sin
  // hijos tiene que poder jugar sin leer una palabra sobre familia.
  //
  // Estaba condicionada a `esSolo`, así que un adulto que se registró como
  // padre no tenía forma de jugar ni siquiera el contenido de kinder — que no
  // es «de niños», es el principio de la escalera y hoy es lo único autorado.
  "practicar",
  "cuenta",
];

const ETIQUETAS: Record<Clave, string> = {
  hijos: m.casaTabHijos,
  progreso: m.casaTabProgreso,
  limite: m.casaTabLimite,
  practicar: m.casaTabPracticar,
  cuenta: m.casaTabCuenta,
};

// La vista de aterrizaje es la primera pestaña REAL, no la primera de la
// lista: un aprendiz solo vería "Practicar" (próximamente) como bienvenida
// si el orden mandara, y eso es un callejón sin salida en la primera pantalla
// que ve. "Cuenta" siempre es real, así que esto nunca queda sin destino.
const vistaPedida = Astro.url.searchParams.get("vista") as Clave | null;
/*
 * Sin hijos, se aterriza en PRACTICAR. Con hijos, en Hijos.
 *
 * Antes era «la primera pestaña real», que siempre daba «Hijos», así que quien
 * no tiene un solo hijo entraba a una pantalla que le habla de sus hijos, le
 * ofrece crear uno y le pregunta si el aparato es de la casa. Es lo que el
 * dueño leyó en su teléfono, con mayúsculas: «No tengo hijos».
 *
 * Los dos modos son iguales de importantes. Quien juega solo entra a jugar.
 */
const vistaPorDefecto: Clave = hijos.length > 0
  ? "hijos"
  : (vistasDisponibles.find((c) => !PROXIMAMENTE.has(c) && c !== "hijos") ?? "practicar");
const vista: Clave =
  vistaPedida && vistasDisponibles.includes(vistaPedida) ? vistaPedida : vistaPorDefecto;

const pestanas = vistasDisponibles.map((clave) => ({
  clave,
  label: ETIQUETAS[clave],
  href: `/${locale}/app/?vista=${clave}`,
  activa: clave === vista,
  proximamente: PROXIMAMENTE.has(clave),
}));

/*
 * El título y la entradilla dependen de si HAY HIJOS, no del tipo de cuenta.
 *
 * Estaban colgados de `esFamilia`, y desde que `esFamilia` pasó a ser «no es
 * aprendiz» —el arreglo de la pantalla sin menú— eso significó que a alguien
 * SIN un solo hijo el producto le decía «Aquí está todo lo de tus hijos».
 *
 * El dueño lo leyó en su teléfono: «me sigue diciendo algo de hijos. No tengo
 * hijos». Arreglar el menú rompió la voz, y las dos cosas venían de colgar
 * demasiadas decisiones de una sola bandera.
 *
 * `esFamilia` sigue decidiendo qué PESTAÑAS existen —hay que poder crear el
 * primer hijo— y `tieneHijos` decide qué se DICE. Son preguntas distintas.
 */
const tieneHijos = hijos.length > 0;
const titulo = tieneHijos ? m.casaTitulo : m.casaTituloSolo;
const lead = tieneHijos ? m.casaLead : m.casaLeadSolo;
---

<Privada locale={locale} title={titulo} description={lead} pestanas={pestanas}>
  <article class="casa">
    <h1>{titulo}</h1>
    <p class="lead">{lead}</p>

    {vista === "hijos" && (
      <Fragment>
        {/* ── Los hijos ───────────────────────────────────────────────────── */}
        <section class="bloque">
          <h2>{m.casaHijos}</h2>
          {hijos.length === 0 ? (
            <p class="muted">{m.casaSinHijos}</p>
          ) : (
            <ul class="hijos">
              {hijos.map((h) => (
                <li class="hijo">
                  <span class="alias">{h.alias}</span>
                  <span class="banda">{h.theme_band}</span>
                </li>
              ))}
            </ul>
          )}
          <a class="boton" href={rutaPerfilNuevo(locale)}>{m.casaNuevoHijo}</a>
          {aparatoMarcado && hijos.length > 0 && (
            <a class="boton primario" href={rutaKids(locale)}>{m.casaJugar}</a>
          )}
        </section>

        {/* ── El aparato de la casa (D-012) ───────────────────────────────── */}
        {!aparatoMarcado && (
          <section class="bloque">
            <h2>{m.casaAparatoTitulo}</h2>
            {/*
              El texto dice qué significa marcar, no solo pide que se marque. D-012:
              la protección real la da el dispositivo, y una decisión que protege
              solo funciona si quien la toma sabe qué está decidiendo.
            */}
            <p class="muted">{m.casaAparatoTexto}</p>
            <button type="button" class="boton primario" id="marcar">{m.casaAparatoCta}</button>
            <p class="ok" id="marcado" hidden>{m.casaAparatoListo}</p>
          </section>
        )}
      </Fragment>
    )}

    {vista === "progreso" && (
      <section class="bloque proximamente">
        <h2>{m.casaTabProgreso}</h2>
        <p class="muted">{m.casaProgresoProximamente}</p>
      </section>
    )}

    {vista === "limite" && (
      <section class="bloque proximamente">
        <h2>{m.casaTabLimite}</h2>
        <p class="muted">{m.casaLimiteProximamente}</p>
      </section>
    )}

    {/*
      «Practicar» ya no es un cartel de «próximamente»: es la puerta a un reto
      de verdad. No pide marcar el aparato ni un PIN — esas dos protegen a un
      NIÑO en un aparato compartido (D-012), y quien está aquí ya demostró
      quién es con su sesión.

      El comentario va FUERA del `&& (`: dentro, es un segundo hijo del
      paréntesis y el build revienta con «Expected ) but found $$render».
    */}
    {vista === "practicar" && (
      <section class="bloque">
        <h2>{m.practicarTitulo}</h2>
        <p class="muted">{m.practicarLead}</p>
        <p class="muted">{m.practicarAviso}</p>
        <a class="boton primario" href={`/${locale}/app/practicar/`}>{m.casaPracticarCta}</a>
      </section>
    )}

    {vista === "cuenta" && (
      <Fragment>
        {/*
          ─── La salida de la redirección de #339 ────────────────────────────

          Desde #339, quien tiene sesión y pide `/entrar/` es redirigido aquí
          sin ver el formulario. Eso es correcto casi siempre —quien ya entró y
          pide entrar se equivocó de botón— y sería una trampa sin salida en el
          caso que el dueño nombró: **en esta casa puede haber varias sesiones
          vivas a la vez**, y un teléfono se comparte.

          Este enlace es la salida, y va a `?cambiar=1`, que es la única cadena
          que el script del `<head>` de `Base.astro` respeta para no redirigir.
          No cierra la sesión actual: lleva al formulario. Quien solo quería
          mirar su cuenta ni lo nota.
        */}
        <p class="muted">
          <a href={`${ruta(locale, "entrar")}?cambiar=1`}>{m.casaOtraCuenta}</a>
        </p>

        {/* ── La passkey, DESPUÉS del registro (D-038) ────────────────────── */}
        <section class="bloque" id="bloque-passkey" hidden>
          <h2>{m.casaPasskeyTitulo}</h2>
          <p class="muted">{m.casaPasskeyTexto}</p>
          <button type="button" class="boton" id="passkey">{m.casaPasskeyCta}</button>
          <p class="ok" id="passkey-ok" hidden>{m.casaPasskeyListo}</p>
        </section>

        {/* ── Cambiar la contraseña (#313) ────────────────────────────────── */}
        <section class="bloque">
          <h2>{m.casaClaveTitulo}</h2>
          {/*
            Se pide la ACTUAL aunque haya sesión. La sesión dura 30 días y vive en el
            teléfono: quien toma un aparato desbloqueado la tiene y no tiene la
            contraseña. Sin este campo, esa persona deja al padre fuera de su cuenta
            y de las de sus hijos. El porqué completo está en `/api/clave`.
          */}
          <div class="campo">
            <label for="clave-actual">{m.casaClaveActual}</label>
            <input type="password" id="clave-actual" autocomplete="current-password" />
          </div>
          <div class="campo">
            <label for="clave-nueva">{m.casaClaveNueva}</label>
            <input type="password" id="clave-nueva" autocomplete="new-password" minlength="8" maxlength="64" />
          </div>
          <button type="button" class="boton" id="cambiar-clave">{m.casaClaveCta}</button>
          <p class="ok" id="clave-ok" hidden>{m.casaClaveListo}</p>
          <p class="mal" id="clave-mal" hidden></p>
        </section>
      </Fragment>
    )}

  </article>

  <style>
    .casa { padding-block: calc(var(--space) * 2); }
    h1 { font-family: var(--font-marca); font-weight: var(--weight-title); font-size: var(--text-xl);
         color: var(--color-text-brand); margin-block-end: var(--space); }
    .lead { font-family: var(--font-marca); font-size: var(--text-lg); line-height: var(--leading-body);
            margin-block-end: calc(var(--space) * 2); }
    .bloque { border: 1px solid var(--color-border); border-radius: var(--radius);
              padding: var(--space); margin-block-end: calc(var(--space) * 1.5); }
    .bloque.proximamente { color: var(--color-text-muted); }
    h2 { font-family: var(--font-sistema); font-size: var(--text-base); font-weight: var(--weight-subtitle);
         margin: 0 0 calc(var(--space) * 0.5); }
    .muted { color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-body);
             margin-block-end: var(--space); }
    .hijos { list-style: none; padding: 0; margin: 0 0 var(--space); display: flex; flex-direction: column; gap: 0.5rem; }
    .hijo { display: flex; justify-content: space-between; align-items: center; gap: var(--space);
            padding: 0.6rem 0.8rem; border: 1px solid var(--color-border); border-radius: var(--radius); }
    .alias { font-family: var(--font-sistema); font-weight: var(--weight-subtitle); }
    .banda { font-size: var(--text-xs); color: var(--color-text-muted); }
    /* 44px, la vara del ADULTO. Los 88 de kinder son para las superficies de niño. */
    .boton { display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
             padding-inline: 1rem; margin-inline-end: 0.5rem; border-radius: var(--radius);
             border: 1px solid var(--color-border); background: transparent; color: var(--color-text);
             font-family: var(--font-sistema); font-size: var(--text-base); text-decoration: none; cursor: pointer; }
    .boton.primario { background: var(--color-accent); color: var(--color-on-accent); border-color: transparent; }
    .boton:focus-visible { outline: 3px solid var(--color-text); outline-offset: 2px; }
    .ok { color: var(--color-text-brand); font-size: var(--text-sm); margin-block-start: 0.5rem; }
    .mal { color: var(--color-error); font-size: var(--text-sm); margin-block-start: 0.5rem; }
    .campo { display: flex; flex-direction: column; gap: 0.35rem; margin-block-end: var(--space); }
    label { font-family: var(--font-sistema); font-size: var(--text-sm); }
    input { font-family: var(--font-sistema); font-size: var(--text-base); min-height: 44px;
            padding-inline: 0.75rem; color: var(--color-text); background: var(--color-surface);
            border: 1px solid var(--color-border); border-radius: var(--radius); }
    input:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
  </style>

  <script define:vars={{
    MSG: {
      credenciales: m.formErrCredenciales,
      rango: m.formErrClave,
      igual: m.formErrGenerico,
      generico: m.formErrGenerico,
    },
  }}>
    // `define:vars` implica `is:inline` (Astro no lo compila): JS PURO aquí
    // abajo, sin `as Tipo`, sin anotaciones — es exactamente la clase de bug
    // que rompió el login el 2026-08-02 (ver CLAUDE.md § Cloudflare). El
    // guardián `audits/script-cliente-sin-ts.mjs` vigila esto en cada commit.

    // ── Marcar el aparato (D-012) ────────────────────────────────────────
    const bMarcar = document.getElementById("marcar");
    bMarcar?.addEventListener("click", async () => {
      bMarcar.disabled = true;
      const r = await fetch("/api/casa?accion=dispositivo", { method: "POST" })
        .then((res) => res.json())
        .catch(() => ({}));
      if (r.ok) {
        const marcado = document.getElementById("marcado");
        if (marcado) marcado.hidden = false;
        // Se recarga para que aparezca el botón de ir con los niños: la página
        // es del servidor y él es quien sabe si ya hay cookie.
        location.reload();
        return;
      }
      bMarcar.disabled = false;
    });

    // ── Añadir una passkey a una cuenta que ya existe (D-038) ───────────
    //
    // El bloque nace `hidden` y solo aparece si el navegador tiene la API. Al
    // revés —pintarlo y esconderlo— enseñaría un botón muerto a quien no puede
    // usarlo.
    const bloquePasskey = document.getElementById("bloque-passkey");
    const bPasskey = document.getElementById("passkey");
    if (bloquePasskey && "PublicKeyCredential" in window) bloquePasskey.hidden = false;

    const b64urlABytes = (s) =>
      Uint8Array.from(atob(s.replace(/-/g, "+").replace(/_/g, "/")), (c) => c.charCodeAt(0));
    const bytesAB64url = (b) =>
      btoa(String.fromCharCode(...new Uint8Array(b))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");

    bPasskey?.addEventListener("click", async () => {
      bPasskey.disabled = true;
      try {
        const reto = await (await fetch("/api/passkey-reto", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ proposito: "registrar" }),
        })).json();
        if (!reto.ok) throw new Error(reto.motivo);

        const cred = await navigator.credentials.create({
          publicKey: {
            challenge: b64urlABytes(reto.reto),
            rp: { id: reto.rpId, name: "Math Challenge" },
            user: {
              id: b64urlABytes(reto.usuarioId),
              name: reto.usuarioNombre ?? "",
              displayName: reto.usuarioNombre ?? "",
            },
            pubKeyCredParams: [{ type: "public-key", alg: -7 }],
            authenticatorSelection: { userVerification: "preferred", residentKey: "preferred" },
            timeout: 60000,
          },
        });
        if (!cred) throw new Error("cancelado");

        const r = cred.response;
        const res = await (await fetch("/api/passkey-registrar", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({
            retoId: reto.id,
            credentialId: cred.id,
            clientDataJSON: bytesAB64url(r.clientDataJSON),
            attestationObject: bytesAB64url(r.attestationObject),
          }),
        })).json();

        if (res.ok) {
          document.getElementById("passkey-ok").hidden = false;
          bPasskey.hidden = true;
          return;
        }
        throw new Error(res.motivo);
      } catch {
        // Si falla —cancelada, sin autenticador, lo que sea— NO se enseña un
        // error: la contraseña sigue funcionando y el bloque entero es opcional.
        bPasskey.disabled = false;
      }
    });

    // ── Cambiar la contraseña ───────────────────────────────────────────
    const bClave = document.getElementById("cambiar-clave");
    bClave?.addEventListener("click", async () => {
      const actual = document.getElementById("clave-actual").value;
      const nueva = document.getElementById("clave-nueva").value;
      const ok = document.getElementById("clave-ok");
      const mal = document.getElementById("clave-mal");
      ok.hidden = true; mal.hidden = true;
      bClave.disabled = true;
      const r = await fetch("/api/clave", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ actual, nueva }),
      }).then((x) => x.json()).catch(() => ({}));
      bClave.disabled = false;
      if (r.ok) {
        ok.hidden = false;
        document.getElementById("clave-actual").value = "";
        document.getElementById("clave-nueva").value = "";
        return;
      }
      /*
        El mensaje sale de una tabla cerrada, igual que en `AvisoDeError`: lo que
        el servidor devuelve es una CLAVE, y pintar una clave cruda deja
        `credenciales` en pantalla.
      */
      const TEXTOS = {
        credenciales: MSG.credenciales,
        clave_fuera_de_rango: MSG.rango,
        clave_igual: MSG.igual,
      };
      mal.textContent = TEXTOS[r.error] ?? MSG.generico;
      mal.hidden = false;
    });
  </script>
</Privada>
