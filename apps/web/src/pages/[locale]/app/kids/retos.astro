---
/**
 * `/{locale}/app/kids/retos` — ya no es una pantalla: es una redirección
 * (D-201, cierre de deuda de `audits/spa-phaser.mjs`).
 *
 * ─── Qué había aquí ────────────────────────────────────────────────────────
 *
 * El selector de retos por materia/dificultad, TODAVÍA sin construir, servido
 * en HTML plano: título, cuerpo y un enlace "Volver al mapa". Vive ahora en
 * `game/scenes/RetosScene.ts` — mismo mensaje ("esto no existe todavía"),
 * mismo fondo del capítulo activo y letrero de madera que el resto de Modo
 * Historia, en vez de un `<h1>` sobre blanco.
 *
 * ─── Por qué la RUTA sobrevive ─────────────────────────────────────────────
 *
 * Igual que `kids/pin.astro`: borrar el archivo entero daría 404 a un
 * marcador guardado o a un botón viejo cacheado en un dispositivo — un 303,
 * no un 301, porque la pantalla dejó de existir aquí, no se movió para
 * siempre.
 */
import { rutaMapaKids } from "../../../../lib/mapa-kids";
import { isLocale, DEFAULT_LOCALE } from "../../../../i18n";

export const prerender = false;

const { locale: crudo } = Astro.params;
const locale = isLocale(crudo) ? crudo : DEFAULT_LOCALE;

return new Response(null, {
  status: 303,
  headers: {
    location: rutaMapaKids(locale),
    "cache-control": "no-store, private",
    vary: "cookie",
    "x-robots-tag": "noindex, nofollow",
  },
});
---
