---
/**
 * `/{locale}/app/liga/jugador` — **la liga del perfil de niño.** F7, #242, #243.
 *
 * ─── Por qué NO vive bajo `app/kids/` ────────────────────────────────────────
 *
 * Vivir ahí la convertiría en «superficie de kinder» POR RUTA para los
 * auditores (`kinder-sin-examen.mjs` §4-§5 leen la ruta, no el contenido), y
 * entonces ningún niño —de ninguna banda— podría ver la racha de sus pares,
 * que es justo lo que D-106 autorizó entre miembros de una liga. Lo que sí
 * hace ESTA página es la regla de fondo, banda por banda: a un niño de la
 * banda más chica la racha no se le pinta como cifra (#205, D-019 —
 * `pintaRacha` abajo); de ahí en adelante, sí.
 *
 * ─── Por qué no usa `layouts/Privada.astro` ni `Base.astro` ─────────────────
 *
 * Las dos son superficies de ADULTO: `Privada` monta `<Rum banda="SERIO">` y
 * la franja de pestañas de la cuenta; `Base`, el nav de marketing y
 * `<Rum banda="PUBLICO">`. D-037 permite medir solo en superficies de adulto,
 * y ésta es la pantalla de un menor por definición (línea roja #2, `mc-25`
 * impl. 6). Lo que sí se hereda son los tokens y las bandas: ni un color, ni
 * un tamaño, ni una familia tipográfica se inventa aquí.
 *
 * ─── Cero de lo que esta pantalla no puede tener ────────────────────────────
 *
 *  · **Cero texto libre** (línea roja #3): no hay campos; la liga no tiene
 *    chat y esta pantalla tampoco.
 *  · **Cero presencia** (D-081 condición 2): ni «en línea», ni «jugando
 *    ahora», ni conteo de nadie. El WebSocket del DO existe y esta página no
 *    lo abre — ver `app/liga/index.astro`.
 *  · **Cero JavaScript.** La tabla se lee al cargar y no se mueve sola.
 *  · **Cero nombre real** (línea roja #2): la fila difundida no tiene campo.
 *
 * La puerta es la sesión de niño `mc_k` (12 h, la del PIN de imágenes). Sin
 * ella se va a la rejilla de caras, que es la entrada de verdad del niño — y
 * si lo que hay es una sesión de ADULTO, a su propia pantalla de liga.
 */
import { LOCALES, isLocale, t, type Locale } from "../../../../i18n";
import {
  COOKIE_ADULTO,
  COOKIE_NINO,
  leerCookies,
  leerSesionAdulto,
  leerSesionNino,
} from "../../../../lib/sesiones";
import { rutaJugar, rutaKids, rutaLiga } from "../../../../lib/rutas-app";
import { cargarTablaDe } from "../../../../lib/liga-membresia";
import Tabla from "../../../../components/liga/Tabla.astro";
import { TEXTOS_LIGA } from "../../../../components/liga/textos";
import "../../../../styles/fonts.css";
import "../../../../styles/tokens.css";
import "../../../../styles/bandas.css";

export const prerender = false;

// Nunca en caché: esta respuesta es la liga de UN niño. `sw.js` ya se salta
// `/app/` entero; esto lo hace cumplir sobre cualquier intermediario.
Astro.response.headers.set("cache-control", "no-store, private");
Astro.response.headers.set("vary", "cookie");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
Astro.response.headers.set("referrer-policy", "same-origin");

const { locale: raw } = Astro.params;
if (!isLocale(raw)) return Astro.redirect("/en/");
const locale: Locale = raw;
const m = t(locale);
const tl = TEXTOS_LIGA[locale] ?? TEXTOS_LIGA["en"];

const env = (
  Astro.locals as {
    runtime?: { env?: { DB?: D1Database; SESSION_KV?: KVNamespace; LEAGUE_DO?: DurableObjectNamespace } };
  }
).runtime?.env;
const cookies = leerCookies(Astro.request.headers.get("cookie"));

const nino = env?.SESSION_KV
  ? await leerSesionNino(env.SESSION_KV, cookies[COOKIE_NINO])
  : null;

if (!nino) {
  // Sin sesión de niño: ¿es un adulto? A su liga. ¿Nadie? A la rejilla de
  // caras, que sabe a dónde mandar a cada quién.
  const adulto = env?.SESSION_KV
    ? await leerSesionAdulto(env.SESSION_KV, cookies[COOKIE_ADULTO])
    : null;
  return Astro.redirect(adulto ? rutaLiga(locale) : rutaKids(locale));
}

/**
 * La banda del perfil decide dos cosas: el tema visual (`data-band`, lo fija
 * el SERVIDOR como manda `bandas.css` — nunca desde JavaScript, que es el
 * destello blanco en un Android de gama baja) y si la racha se pinta como
 * cifra. Si el perfil no se puede leer, se cae al tema más cuidadoso y a no
 * pintar la cifra: degradar, no reventar.
 */
let banda = "KINDER";
if (env?.DB) {
  try {
    const fila = await env.DB.prepare(
      "SELECT theme_band FROM child_profiles WHERE id = ? AND deleted_at IS NULL",
    )
      .bind(nino.childProfileId)
      .first<{ theme_band: string }>();
    if (fila) banda = fila.theme_band;
  } catch {
    /* se queda el tema más cuidadoso */
  }
}

const tabla = await cargarTablaDe(env ?? {}, { id: nino.childProfileId, esAdulto: false }, Date.now());
---

<!doctype html>
<html lang={m.htmlLang} data-band={banda}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{tl["liga.titulo"]}</title>
    <meta name="theme-color" content="#F36B1C" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icons/icon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <link rel="preload" href="/fonts/raleway-var-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>

  <body>
    <main class="pantalla">
      <h1 class="titulo">{tl["liga.titulo"]}</h1>
      <p class="pista">{tl["liga.esta_semana"]}</p>

      {tabla.estado === "sin_liga" && <p class="aviso">{tl["liga.sin_liga"]}</p>}
      {tabla.estado === "sin_datos" && <p class="aviso">{tl["liga.sin_datos"]}</p>}
      {tabla.estado === "ok" && (
        <Tabla
          locale={locale}
          filas={tabla.filas}
          aliasPropio={tabla.aliasPropio}
          pintaRacha={banda !== "KINDER"}
        />
      )}

      <p class="volver">
        <a class="seguir" href={rutaJugar(locale)}>{tl["liga.seguir_jugando"]}</a>
      </p>
    </main>

    <style>
      .pantalla {
        min-block-size: 100svb;
        max-inline-size: var(--measure, 46rem);
        margin-inline: auto;
        padding-block: calc(var(--space) * 2) calc(var(--space) * 3);
        padding-inline: var(--space);
        /* D-041: en un iPhone o iPad instalado, el contenido no se mete bajo
           el indicador de inicio ni bajo las esquinas redondeadas. */
        padding-block-end: calc(var(--space) * 3 + env(safe-area-inset-bottom));
        padding-inline-start: calc(var(--space) + env(safe-area-inset-left));
        padding-inline-end: calc(var(--space) + env(safe-area-inset-right));
      }

      .titulo {
        font-family: var(--font-marca);
        font-weight: var(--weight-title);
        font-size: var(--text-2xl);
        line-height: 1.2;
        color: var(--color-text-brand);
        margin-block: 0 calc(var(--space) * 0.5);
      }

      .pista {
        font-family: var(--font-marca);
        font-weight: var(--weight-subtitle);
        font-size: var(--text-lg);
        color: var(--color-text);
        margin-block: 0 calc(var(--space) * 1.5);
      }

      .aviso {
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
        color: var(--color-text-muted);
      }

      /* La salida: un blanco táctil de verdad, no un enlace de texto — es la
         única acción de la pantalla y el dedo que la toca puede tener cuatro
         años (`mc-20` §201). */
      .volver {
        margin-block-start: calc(var(--space) * 2);
      }
      .seguir {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-block-size: var(--tap-kinder, var(--tap-primaria));
        padding-inline: calc(var(--space) * 1.5);
        border-radius: var(--radius);
        background: var(--color-accent);
        color: var(--color-on-accent);
        font-family: var(--font-marca);
        font-weight: var(--weight-subtitle);
        font-size: var(--text-lg);
        text-decoration: none;
      }
      .seguir:focus-visible { outline: 4px solid var(--color-text); outline-offset: 3px; }
    </style>
  </body>
</html>
