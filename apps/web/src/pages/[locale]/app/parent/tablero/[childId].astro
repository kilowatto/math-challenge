---
/**
 * `/{locale}/app/parent/tablero/[childId]` — el opt-in del tablero, por hijo,
 * y el único lugar donde el tablero de KINDER existe. F7 #247 · D-040, D-051,
 * D-081.
 *
 * ─── Qué hay aquí ────────────────────────────────────────────────────────────
 *
 *  · **El interruptor del opt-in** (D-040): activar escribe la fila
 *    `LEADERBOARD` de `child_consents` con `granted_by` y `consent_version`;
 *    desactivar la REVOCA (`revoked_at`), nunca la borra, y nunca toca
 *    `score_totals` — los puntos son del niño, no del tablero. Es el gobierno
 *    único de D-051, en `lib/padre-tablero.ts`, y el formulario funciona sin
 *    JavaScript: la escritura es siempre del servidor.
 *  · **El widget de KINDER** (D-081): con el opt-in activo, el padre ve cómo
 *    va su hijo — en TERCIOS, nunca un número de posición, y nunca el último
 *    lugar (`mc-18` implicación 7). Es el único sitio del producto donde ese
 *    tablero se pinta: dentro de `/app/kids/**` no existe (#247), y
 *    `audits/tablero-sin-kinder-publico.mjs` vigila las dos mitades.
 *
 * ─── Qué NO hay ──────────────────────────────────────────────────────────────
 *
 *  · El tablero de PRIMARIA/SECUNDARIA no se le muestra al padre aquí: esta
 *    pantalla gobierna el consentimiento, y el tablero del niño es del niño.
 *    En KINDER la excepción es el widget, porque a esa edad el único lector
 *    autorizado ES el padre (D-081).
 *  · Ninguna sombra de plan o pago (líneas rojas #4 y #5): aparecer en el
 *    tablero no se compra, y esta pantalla no conoce la palabra.
 *
 * ─── Autorización ────────────────────────────────────────────────────────────
 *
 * Línea roja #2: el padre ve a SUS hijos. `hijoDelPadre()` responde la única
 * pregunta y un `null` (inexistente o ajeno, sin distinguir) produce 404.
 * Se falla CERRADO también sin base de datos.
 */
export const prerender = false;

import Privada from "../../../../../layouts/Privada.astro";
import TableroGlobal from "../../../../../components/tablero/TableroGlobal.astro";
import { TEXTOS_TABLERO, rellenarTablero } from "../../../../../components/tablero/textos";
import { isLocale, type Locale } from "../../../../../i18n";
import { COOKIE_ADULTO, leerCookies, leerSesionAdulto } from "../../../../../lib/sesiones";
import { pestanasPrivadas } from "../../../../../lib/pestanas-privadas";
import { hijoDelPadre } from "../../../../../lib/padre-limite";
import { consentimientoTablero } from "../../../../../lib/padre-tablero";
import { vistaParaNino } from "../../../../../lib/tablero-datos";
import { rutaCasa } from "../../../../../lib/rutas-app";
import { ruta } from "../../../../../i18n/rutas";
import { formatear } from "../../../../../../../../packages/motor/src/numeros.ts";

const { locale: raw, childId = "" } = Astro.params;
if (!isLocale(raw)) return Astro.redirect("/en/");
const locale: Locale = raw;

const env = (Astro.locals as { runtime?: { env: { DB?: D1Database; SESSION_KV?: KVNamespace } } })
  .runtime?.env;
const cookies = leerCookies(Astro.request.headers.get("cookie"));
const sesion = env?.SESSION_KV
  ? await leerSesionAdulto(env.SESSION_KV, cookies[COOKIE_ADULTO])
  : null;
// `?cambiar=1` y no `/entrar/` a secas: sin eso hay un bucle infinito real.
if (!sesion) return Astro.redirect(`${ruta(locale, "entrar")}?cambiar=1`);

// Sin base no se puede comprobar la propiedad del perfil, y lo que no se
// puede comprobar se niega. A la casa, que es superficie de adulto y sabe
// degradar.
if (!env?.DB) return Astro.redirect(rutaCasa(locale));

// ─── La puerta: ¿este niño es de ESTE padre? (línea roja #2) ────────────────
const noEncontrado = () =>
  new Response("404 — perfil desconocido", {
    status: 404,
    headers: { "content-type": "text/plain; charset=utf-8", "cache-control": "no-store, private" },
  });

let hijo: Awaited<ReturnType<typeof hijoDelPadre>> = null;
try {
  hijo = await hijoDelPadre(env.DB, sesion.userId, childId);
} catch (err) {
  console.error("padre-tablero: no se pudo leer el perfil", String(err).slice(0, 200));
}
if (!hijo) return noEncontrado();

const consentimiento = await consentimientoTablero(env.DB, hijo.id);
const textos = TEXTOS_TABLERO[locale];

// ─── El widget de KINDER: tercios, nunca número, solo con opt-in ─────────────
//
// La vista llega ya escalonada del servidor (`armarVista`): la lista es el
// tercio de arriba con cada fila marcada por tercio, y `mi_posicion` es un
// tercio — el número exacto no viaja, ni para el padre (D-081, #243).
const esKinder = hijo.theme_band === "KINDER";
const widget = esKinder && consentimiento.vigente ? await vistaParaNino(env.DB, hijo) : null;

const filasWidget = (widget?.vista.lista ?? []).map((e) => ({
  alias: e.alias,
  puntos: formatear(e.total_score, locale),
  posicion:
    e.posicion.forma === "tercio" ? textos[`tablero.padre.tercio.${e.posicion.tercio}`] : "",
  soyYo: e.soy_yo,
}));
const tercioPropio =
  widget?.vista.mi_posicion?.forma === "tercio"
    ? rellenarTablero(textos["tablero.padre.tercioDe"], {
        alias: hijo.alias,
        tercio: textos[`tablero.padre.tercio.${widget.vista.mi_posicion.tercio}`],
      })
    : null;
const puntosPropios = widget
  ? rellenarTablero(textos["tablero.tusPuntos"], {
      puntos: formatear(widget.vista.mi_total, locale),
    })
  : null;

const estado = consentimiento.vigente
  ? rellenarTablero(textos["tablero.padre.estadoSi"], { alias: hijo.alias })
  : rellenarTablero(textos["tablero.padre.estadoNo"], { alias: hijo.alias });
const lead = rellenarTablero(textos["tablero.padre.lead"], { alias: hijo.alias });
const explica = rellenarTablero(textos["tablero.padre.explica"], { alias: hijo.alias });
const apagadoKinder = rellenarTablero(textos["tablero.padre.apagadoKinder"], { alias: hijo.alias });

const guardado = Astro.url.searchParams.get("guardado") === "1";
const errorEnPantalla =
  Astro.url.searchParams.get("e") !== null ? textos["tablero.padre.errGenerico"] : null;

// La franja de pestañas del área privada, con «Hijos» activa: de ahí se llega.
const pestanas = pestanasPrivadas(locale, true, "hijos");

Astro.response.headers.set("cache-control", "no-store, private");
Astro.response.headers.set("vary", "cookie");
Astro.response.headers.set("x-robots-tag", "noindex, nofollow");
---

<Privada locale={locale} title={textos["tablero.padre.titulo"]} description={lead} pestanas={pestanas}>
  <article class="tablero-padre">
    <h1>{textos["tablero.padre.titulo"]} · {hijo.alias}</h1>
    <p class="lead">{lead}</p>

    <section class="bloque">
      <p class="estado">{estado}</p>
      <p class="muted">{explica}</p>
      {esKinder && <p class="muted">{textos["tablero.padre.explicaKinder"]}</p>}
      {esKinder && !consentimiento.vigente && <p class="muted">{apagadoKinder}</p>}

      {/* El interruptor. Un formulario de verdad: la escritura es del servidor
          con o sin JavaScript (el aparato de referencia es un Android de gama
          baja, `mc-47` §5), y la acción es un conjunto cerrado de dos. */}
      <form method="post" action="/api/padre-tablero">
        <input type="hidden" name="hijo" value={hijo.id} />
        <input type="hidden" name="locale" value={locale} />
        <input type="hidden" name="accion" value={consentimiento.vigente ? "desactivar" : "activar"} />

        {guardado && <p class="ok">{textos["tablero.padre.guardado"]}</p>}
        {errorEnPantalla !== null && <p class="mal" role="alert">{errorEnPantalla}</p>}

        <button type="submit" class={consentimiento.vigente ? "boton" : "boton primario"}>
          {consentimiento.vigente
            ? textos["tablero.padre.desactivar"]
            : textos["tablero.padre.activar"]}
        </button>
      </form>
    </section>

    {/* ── El widget de KINDER (D-081): tercios, nunca número, solo con
        opt-in vigente y solo para el padre. */}
    {widget !== null && (
      <section class="bloque">
        <h2>{rellenarTablero(textos["tablero.padre.widgetTitulo"], { alias: hijo.alias })}</h2>
        {widget.vista.mi_total > 0 && <p class="cifra">{puntosPropios}</p>}
        {tercioPropio !== null && <p class="tercio">{tercioPropio}</p>}
        {filasWidget.length === 0 ? (
          <p class="muted">{textos["tablero.padre.sinTablero"]}</p>
        ) : (
          <TableroGlobal
            filas={filasWidget}
            textos={{
              colPosicion: textos["tablero.colPosicion"],
              colJugador: textos["tablero.colJugador"],
              colPuntos: textos["tablero.colPuntos"],
              tu: textos["tablero.tu"],
            }}
          />
        )}
      </section>
    )}
  </article>

  <style>
    .tablero-padre { max-width: 34rem; margin-inline: auto; padding-block: calc(var(--space) * 2); }
    h1 { font-family: var(--font-marca); font-weight: var(--weight-title); font-size: var(--text-xl);
         color: var(--color-text-brand); margin-block-end: var(--space); }
    h2 { font-family: var(--font-sistema); font-size: var(--text-base);
         font-weight: var(--weight-subtitle); margin: 0 0 calc(var(--space) * 0.5); }
    .lead { font-family: var(--font-marca); font-size: var(--text-lg); line-height: var(--leading-body);
            margin-block-end: calc(var(--space) * 2); }
    .bloque { border: 1px solid var(--color-border); border-radius: var(--radius);
              padding: var(--space); margin-block-end: calc(var(--space) * 1.5); }
    .estado { font-family: var(--font-marca); font-weight: var(--weight-subtitle);
              font-size: var(--text-base); margin-block-start: 0; }
    .cifra { font-family: var(--font-marca); font-weight: var(--weight-subtitle);
             font-size: var(--text-lg); margin: 0; }
    .tercio { font-family: var(--font-marca); font-size: var(--text-base);
              color: var(--color-text-brand); margin-block: 0.35rem var(--space); }
    .muted { color: var(--color-text-muted); font-size: var(--text-sm); line-height: var(--leading-body); }
    /* 44px, la vara del ADULTO. Los 88 de kinder son para superficies de niño. */
    .boton { display: inline-flex; align-items: center; justify-content: center; min-height: 44px;
             padding-inline: 1rem; border-radius: var(--radius); border: 1px solid var(--color-border);
             background: transparent; color: var(--color-text); font-family: var(--font-sistema);
             font-size: var(--text-base); cursor: pointer; }
    .boton.primario { background: var(--color-accent); color: var(--color-on-accent);
                      border-color: transparent; }
    .boton:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 2px; }
    .ok { color: var(--color-text-brand); font-size: var(--text-sm); }
    .mal { color: var(--color-error); font-size: var(--text-sm); }
  </style>
</Privada>
