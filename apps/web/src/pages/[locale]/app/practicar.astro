---
/**
 * `/{locale}/app/practicar/` — **un adulto juega. Sin hijos, sin familia.**
 *
 * ─── Por qué existe ────────────────────────────────────────────────────────
 *
 * Math Challenge tiene dos modos y son igual de importantes: **familia** y
 * **solo**. Hasta hoy solo se podía jugar en el primero, y no por una decisión
 * de producto sino por accidente: la pantalla del reto vivía dentro de
 * `/app/kids/jugar/`, detrás de cinco puertas que son todas del modo familia —
 * tener un hijo creado, haber marcado el aparato como de la casa, elegir una
 * cara y teclear un PIN de imágenes.
 *
 * Quien no tiene hijos no podía jugar **nada**. Ni siquiera el contenido de
 * kinder, que no es «de niños»: es el principio de la escalera y hoy es lo
 * único que el banco tiene autorado (653 ítems, 14 habilidades).
 *
 * ─── El motor nunca fue el problema ────────────────────────────────────────
 *
 * `/api/jugar` ya aceptaba una sesión de adulto y ya usaba `userId` como
 * identidad del modelo, en un espacio de identificadores separado del de
 * cualquier hijo. Comprobado en producción **antes** de escribir esta página:
 *
 *     POST /api/jugar?accion=siguiente   (solo con la cookie de adulto)
 *     → 200 · formato "flash" · «¿Cuántos patitos viste?» · 2 opciones
 *
 * Lo único que faltaba era esto: una URL a la que llegar.
 *
 * ─── Lo que esta pantalla NO pide ──────────────────────────────────────────
 *
 * Ni `mc_h` ni PIN. Las dos protegen a un NIÑO en un aparato compartido
 * (D-012): el PIN existe para que el hermano pequeño no entre al perfil del
 * mayor. Un adulto ya demostró quién es con su sesión; pedirle un PIN de
 * imágenes encima sería fricción sin nada detrás.
 *
 * Tampoco dice «tus hijos», ni «tu casa», ni «marca este aparato». Quien juega
 * solo no tiene por qué leer una palabra sobre familia.
 *
 * ─── Lo que sí avisa, y por qué ────────────────────────────────────────────
 *
 * Que el banco hoy es de kinder. Decirlo por adelantado es la diferencia entre
 * «esto es lo que hay por ahora» y «este producto es un juguete»: alguien que
 * espera álgebra y recibe patitos sin aviso concluye lo segundo. Los niveles de
 * adulto están decididos (D-034) y no construidos.
 */
import { LOCALES, isLocale, t, type Locale } from "../../../i18n";
import { ruta } from "../../../i18n/rutas";
import { rutaCasa } from "../../../lib/rutas-app";
import { leerSesionAdulto, COOKIE_ADULTO, leerCookies } from "../../../lib/sesiones";
import { leerProgreso, textoDeXp } from "../../../lib/progreso";
import Pantalla from "../../../components/reto/Pantalla.astro";
import { ETIQUETA_DE_VOZ } from "../../../../../../packages/tutor/src/voz.ts";
import "../../../styles/reto.css";

import en from "../../../i18n/reto/en.json";
import esMX from "../../../i18n/reto/es-MX.json";
import esES from "../../../i18n/reto/es-ES.json";
import frFR from "../../../i18n/reto/fr-FR.json";
import ptBR from "../../../i18n/reto/pt-BR.json";
import ptPT from "../../../i18n/reto/pt-PT.json";
import deDE from "../../../i18n/reto/de-DE.json";

// Lee cookies, así que la sirve el Worker en cada petición.
export const prerender = false;

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: rawLocale } = Astro.params;
if (!isLocale(rawLocale)) return Astro.redirect("/en/");
const locale: Locale = rawLocale;
const m = t(locale);

const env = (Astro.locals as any).runtime?.env;
const sesion = env?.SESSION_KV
  ? await leerSesionAdulto(
      env.SESSION_KV,
      leerCookies(Astro.request.headers.get("cookie"))[COOKIE_ADULTO],
    )
  : null;

// `?cambiar=1` para no chocar con la redirección de #339: sin eso,
// /practicar/ → /entrar/ → (hay pista) → /app/ → … y el navegador gira.
if (!sesion) return Astro.redirect(`${ruta(locale, "entrar")}?cambiar=1`);

const CATALOGOS: Record<string, Record<string, unknown>> = {
  en, "es-MX": esMX, "es-ES": esES, "fr-FR": frFR, "pt-BR": ptBR, "pt-PT": ptPT, "de-DE": deDE,
};
const c = CATALOGOS[locale] ?? en;
const texto = (clave: string, respaldo: string) =>
  typeof c[clave] === "string" ? (c[clave] as string) : respaldo;

// Los mismos rótulos que el niño: es el mismo reto. Solo cambia «terminar»,
// que aquí devuelve a la casa y no a la reja de caras.
const rotulos = {
  bien: texto("juego.bien", "That's it!"),
  otra: texto("juego.otra", "Not this time. Have another go."),
  siguiente: texto("juego.siguiente", "Next"),
  salir: texto("juego.salir", "Done for now"),
  cargando: texto("juego.cargando", "Here it comes…"),
  mirar: texto("juego.mirar", "Look!"),
  // Los del destello y los del ciclo de respuesta (#345, #348).
  verlo: texto("juego.verlo", "I'm ready"),
  otraVez: texto("juego.otraVez", "See it again"),
  confirmar: texto("juego.confirmar", "Ready!"),
  reintentar: texto("juego.reintentar", "Try it again"),
  elige: texto("juego.elige", "Tap one, then Ready."),
  // Los tres de «dónde estoy» (#361).
  practicando: texto("juego.practicando", "You're practising: {habilidad}"),
  llevas: texto("juego.llevas", "{n} so far"),
  ubicando: texto("juego.ubicando", "Still working out where to start you."),
  // La voz (#135, D-078). `sinVoz` solo se pinta si ESTE aparato no tiene
  // ninguna voz de este idioma instalada — la comprobación es del cliente,
  // porque la cobertura es del sistema operativo y no del build.
  escuchar: texto("juego.escuchar", "Listen"),
  vozActivada: texto("juego.vozActivada", "Voice on"),
  vozDesactivada: texto("juego.vozDesactivada", "Voice off"),
  sinVoz: texto("juego.sinVoz", "This device has no voice installed for this language, so Larry can\u2019t read out loud here."),
};

/**
 * El nombre de cada habilidad, resuelto en el SERVIDOR.
 *
 * Los identificadores son los del banco (`K01`…`K14`) y **no se enseñan**: lo
 * que se pinta es «Estás practicando: contar del 1 al 10». La lista se arma
 * desde el catálogo del locale, así que una habilidad nueva sin nombre autorado
 * sencillamente no se anuncia — mejor callar que enseñar `K15`, que sería el
 * mismo defecto de #349 en otra superficie.
 */
const habilidades: Record<string, string> = {};
for (const clave of Object.keys(c)) {
  if (clave.startsWith("habilidad.") && typeof c[clave] === "string") {
    habilidades[clave.slice("habilidad.".length)] = c[clave] as string;
  }
}

/**
 * La racha y el XP de este adulto, leídos en el SERVIDOR (#201, #192, #206).
 *
 * Esta pantalla es del modo SOLO: quien juega aquí es una persona adulta con su
 * propia cuenta, y su racha vive en `child_streak` por `user_id` — la tabla es
 * polimórfica desde la migración 0007 precisamente porque D-034 dice que el
 * adulto aprendiz es un caso de primera clase y no un niño sin padre.
 *
 * Se pasa a `Pantalla` y **no se pasa en `/app/kids/jugar/`**: ahí el jugador es
 * de KINDER, donde #206 y #205 piden el camino de Larry en la Sabana sin ningún
 * número, y D-060 más el criterio #100 prohíben que el niño vea una cuenta
 * corriendo. La pregunta —si en KINDER se enseña la racha con número mientras
 * ese camino no exista— está en `docs/dudas.md` §23.1 y se contesta que NO
 * hasta que el dueño diga otra cosa.
 *
 * Si no hay base de datos o la lectura falla, `leerProgreso` devuelve `null` y
 * la pantalla sencillamente no pinta el bloque. Nunca se le niega el juego a
 * nadie por un contador.
 */
const progresoLeido = env?.DB
  ? await leerProgreso(env, { id: sesion.userId, esAdulto: true })
  : null;
const progreso = progresoLeido
  ? {
      rachaActual: progresoLeido.racha.actual,
      rachaMaxima: progresoLeido.racha.mejor,
      xpTexto: textoDeXp(texto("juego.xp", "{n} XP earned"), progresoLeido.xp.total, locale),
    }
  : null;
---

<!doctype html>
<html lang={locale} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{m.practicarTitulo}</title>
    {/* Detrás de sesión: un buscador no debe tener nunca esta URL. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/icons/icon-192.png" sizes="192x192" />
  </head>
  <body class="jugar-body">
    <p class="aviso-banco">{m.practicarAviso}</p>
    {/* `mostrarContexto` SOLO aquí, nunca en la pantalla del niño: ver la
       propiedad en `Pantalla.astro`. Un adulto que practica y no sabe dónde
       está no puede juzgar si el producto le sirve; un niño que lee «llevas 3»
       está haciendo un examen (D-060, criterio #100). */}
    <Pantalla
      locale={locale}
      rotulos={rotulos}
      salirA={rutaCasa(locale)}
      habilidades={habilidades}
      mostrarContexto={true}
      etiquetaVoz={ETIQUETA_DE_VOZ[locale]}
      progreso={progreso}
    />

    <style>
      /* Va arriba y en voz del sistema: es una nota del producto, no parte del
         reto. Discreta a propósito — se lee una vez y deja de importar. */
      .aviso-banco {
        max-inline-size: var(--measure, 46rem);
        margin: 0 auto;
        padding: 0.75rem 1.25rem;
        font-family: var(--font-sistema);
        font-size: var(--text-xs);
        line-height: var(--leading-body);
        color: var(--color-text-muted);
        text-align: center;
      }
    </style>
  </body>
</html>
