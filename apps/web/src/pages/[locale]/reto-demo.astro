---
/**
 * /{locale}/reto-demo/ — los cinco formatos táctiles, visibles y tocables.
 *
 * Es una superficie de DEMOSTRACIÓN, no el reto real: no hay sesión, no se
 * puntúa nada y no se registra ningún intento. Existe porque el criterio #39 de
 * F3 pide que los cinco formatos «respondan de verdad», y eso no se puede
 * comprobar leyendo código — hacen falta `audits/touch-targets.mjs` en 88 px y
 * `audits/axe-a11y.mjs` limpio sobre una página que exista.
 *
 * **Sin telemetría** (D-037, línea roja #2): esta página no incluye el beacon.
 * `audits/telemetria-infantil.mjs` bloquea si aparece.
 *
 * **Sin texto libre** (línea roja #3): los cinco formatos son tocar o elegir.
 * No hay ni un `<input type="text">`.
 */
import Base from "../../layouts/Base.astro";
import Formatos from "../../components/reto/Formatos.astro";
import { LOCALES, isLocale, type Locale } from "../../i18n";
import "../../styles/reto.css";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const { locale: raw } = Astro.params;
if (!isLocale(raw)) return Astro.redirect("/en/");
const locale: Locale = raw;

/**
 * Los números se escriben con la convención del locale y con nada más.
 *
 * Se calcula en el SERVIDOR y viaja como texto ya formateado: el módulo del
 * motor no cruza al cliente, que es lo que `audits/puntaje-servidor.mjs` exige.
 */
import { formatear } from "../../../../../packages/motor/src/numeros.ts";
const opciones = (ns: number[]) => ns.map((n) => formatear(n, locale));

/**
 * Copy de la página, por locale. `titulo`/`descripcion`/`h1`/`lema` alimentan
 * el `<title>`, `<meta description>` y el JSON-LD de `Base.astro`, que exige
 * que ambos aparezcan literalmente en el `<body>` (mc-48 §3) — por eso
 * `descripcion` está compuesta de las mismas frases que los títulos de cada
 * ítem, no de un resumen libre: así la cobertura léxica nunca se rompe al
 * traducir uno de los dos por separado.
 */
const COPY: Record<Locale, {
  h1: string; lema: string;
  qMas: string; qPato: string; qCompleta: string; qCuantos: string;
}> = {
  "en": {
    h1: "The five formats", lema: "Demo. No session, no score, and nothing is recorded.",
    qMas: "Which group has more?", qPato: "Tap each duck", qCompleta: "Complete to 7", qCuantos: "How many were there?",
  },
  "es-MX": {
    h1: "Los cinco formatos", lema: "Demostración. No hay sesión, no se puntúa y no se registra nada.",
    qMas: "¿Cuál grupo tiene más?", qPato: "Toca cada pato", qCompleta: "Completa hasta 7", qCuantos: "¿Cuántos eran?",
  },
  "es-ES": {
    h1: "Los cinco formatos", lema: "Demostración. No hay sesión, no se puntúa y no se registra nada.",
    qMas: "¿Cuál grupo tiene más?", qPato: "Toca cada pato", qCompleta: "Completa hasta 7", qCuantos: "¿Cuántos eran?",
  },
  "fr-FR": {
    h1: "Les cinq formats", lema: "Démonstration. Pas de session, pas de score, rien n'est enregistré.",
    qMas: "Quel groupe en a le plus ?", qPato: "Touche chaque canard", qCompleta: "Complète jusqu'à 7", qCuantos: "Combien y en avait-il ?",
  },
  "pt-BR": {
    h1: "Os cinco formatos", lema: "Demonstração. Sem sessão, sem pontuação, nada é registrado.",
    qMas: "Qual grupo tem mais?", qPato: "Toque em cada pato", qCompleta: "Complete até 7", qCuantos: "Quantos eram?",
  },
  "pt-PT": {
    h1: "Os cinco formatos", lema: "Demonstração. Sem sessão, sem pontuação, nada fica registado.",
    qMas: "Que grupo tem mais?", qPato: "Toca em cada pato", qCompleta: "Completa até 7", qCuantos: "Quantos eram?",
  },
  "de-DE": {
    h1: "Die fünf Formate", lema: "Demo. Keine Sitzung, keine Wertung, nichts wird gespeichert.",
    qMas: "Welche Gruppe hat mehr?", qPato: "Tippe jede Ente an", qCompleta: "Ergänze bis 7", qCuantos: "Wie viele waren es?",
  },
};
const c = COPY[locale];
const paginaTitulo = c.h1;
const paginaDescripcion = `${c.h1}: 3 + 4, ${c.qMas} ${c.qPato}. ${c.qCompleta} ${c.qCuantos} ${c.lema}`;

/**
 * Los ítems son del BANCO REAL, con su id, para que la respuesta se pueda
 * calificar de verdad contra `POST /api/reto`. Las opciones se ordenan de forma
 * estable —no al azar— para que la posición del acierto no cambie entre
 * despliegues: un niño que aprende «la de la esquina» no está aprendiendo a
 * sumar, pero un niño al que la respuesta le SALTA de sitio en cada visita
 * tampoco puede confiar en la pantalla.
 */
const DEMOS = [
  { itemId: "k11-3-4", formato: "toca_la_respuesta" as const, titulo: "3 + 4", opciones: opciones([1, 7, 8, 12]) },
  { itemId: "k07-2-8", formato: "cual_sobra" as const, titulo: c.qMas, opciones: opciones([2, 8]) },
  { itemId: "k03-6", formato: "toca_para_contar" as const, titulo: c.qPato, opciones: opciones([5, 6, 7]), cantidad: 6 },
  { itemId: "k10-7-3", formato: "arma_el_numero" as const, titulo: c.qCompleta, opciones: opciones([3, 4, 7, 10]), cantidad: 10 },
  { itemId: "k02-4", formato: "flash" as const, titulo: c.qCuantos, opciones: opciones([3, 4, 5]), cantidad: 4 },
];

/** La retroalimentación del locale. Sin texto, no hay nada que mostrar. */
import retro from "../../i18n/reto/en.json";
import retroEsMX from "../../i18n/reto/es-MX.json";
import retroEsES from "../../i18n/reto/es-ES.json";
import retroFr from "../../i18n/reto/fr-FR.json";
import retroPtBR from "../../i18n/reto/pt-BR.json";
import retroPtPT from "../../i18n/reto/pt-PT.json";
import retroDe from "../../i18n/reto/de-DE.json";
const RETRO: Record<Locale, typeof retro> = {
  "en": retro, "es-MX": retroEsMX as any, "es-ES": retroEsES as any, "fr-FR": retroFr as any,
  "pt-BR": retroPtBR as any, "pt-PT": retroPtPT as any, "de-DE": retroDe as any,
};
---

<Base
  locale={locale}
  seccion={null}
  title={paginaTitulo}
  description={paginaDescripcion}
>
  <div class="reto">
    <h1>{c.h1}</h1>
    <p class="muted">
      {c.lema}
    </p>

    {DEMOS.map((d) => (
      <section data-item={d.itemId}>
        <h2>{d.titulo}</h2>
        <Formatos
          formato={d.formato}
          opciones={d.opciones}
          cantidad={d.cantidad}
          etiquetaGrupo={d.titulo}
        />
        {/* `aria-live="polite"` y no `assertive`: el veredicto se anuncia cuando
            el lector termine lo que está diciendo, no interrumpiéndolo. */}
        <div class="veredicto" hidden aria-live="polite">
          <p class="causa"></p>
          <p class="siguiente"></p>
        </div>
      </section>
    ))}
  </div>

  <script is:inline define:vars={{ RETRO: RETRO[locale] }}>
    // Alternar `aria-pressed`. Sin marco, sin dependencias, y con delegación:
    // 26 blancos táctiles con un solo escuchador.
    //
    // `aria-pressed` y no una clase: un lector de pantalla anuncia el estado, y
    // una clase de CSS no le dice nada a nadie.
    document.querySelectorAll(".opciones, .contables, .marco").forEach((grupo) => {
      grupo.addEventListener("click", (e) => {
        const b = (e.target).closest("button");
        if (!b || !grupo.contains(b)) return;
        const unaSola = grupo.classList.contains("opciones");
        if (unaSola) {
          grupo.querySelectorAll("button").forEach((o) => o.setAttribute("aria-pressed", "false"));
        }
        b.setAttribute("aria-pressed", b.getAttribute("aria-pressed") === "true" ? "false" : "true");
      });
    });

    // El flash: exposición del estímulo, NO un reloj. Se esconde una vez y no
    // vuelve; no cuenta hacia atrás, no se muestra y no puntúa (D-024).
    document.querySelectorAll(".flash").forEach((f) => {
      const ms = Number(f.dataset.ms ?? 500);
      setTimeout(() => f.setAttribute("data-visible", "false"), ms);
    });

    // Calificar contra el SERVIDOR. El cliente manda una elección y recibe un
    // veredicto; la fórmula de D-010 no viaja hasta aquí, y por eso
    // `audits/puntaje-servidor.mjs` puede afirmar que no está en el bundle.
    document.querySelectorAll("section[data-item]").forEach((seccion) => {
      const itemId = seccion.dataset.item;
      const caja = seccion.querySelector(".veredicto");
      if (!caja) return;

      seccion.addEventListener("click", async (e) => {
        const b = e.target.closest("button[data-valor]");
        if (!b) return;

        let r;
        try {
          const res = await fetch("/api/reto", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ itemId, eleccion: Number(b.dataset.valor) }),
          });
          r = await res.json();
        } catch {
          // Sin conexión no se inventa un veredicto: el servidor califica, y si
          // no está, la respuesta espera. Es lo que la cola de D-047 recogerá.
          return;
        }

        const clave = r.acc === 1 ? "acierto" : r.causa ?? "inesperada";
        const texto = RETRO[clave];
        caja.dataset.acierto = String(r.acc);
        caja.hidden = false;
        caja.querySelector(".causa").textContent = Array.isArray(texto) ? texto[0] : texto;
        caja.querySelector(".siguiente").textContent = Array.isArray(texto) ? texto[1] : "";
      });
    });
  </script>
</Base>
