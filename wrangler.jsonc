{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Regla de CLAUDE.md § Cloudflare: TODO objeto lleva prefijo
  // `math-challenge-`, sin excepción, ni en pruebas (ahí se sufija: -dev).
  // El auditor `audits/cf-prefix.mjs` lo hace cumplir en el gancho pre-commit,
  // cruzando contra
  // el inventario de docs/infrastructure.md.
  "name": "math-challenge-web",
  "main": "apps/web/dist/_worker.js/index.js",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  },

  // D-033: mismo host. El sitio abierto vive en la raíz y la app en rutas
  // autenticadas, para que la autoridad de dominio se concentre en un solo
  // lugar en vez de repartirse (mc-48).
  "routes": [
    {
      "pattern": "math.kilowatto.com",
      "custom_domain": true
    }
  ],

  // NOTA SOBRE BINDINGS: wrangler propone al crear un objeto un binding
  // derivado del nombre (math_challenge_session_kv). No se usa. Los bindings
  // los fija docs/infrastructure.md en UPPER_SNAKE_CASE corto, y el auditor
  // cf-prefix verifica que no se separen.

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "math-challenge-db",
      "database_id": "25276cac-2d48-4771-87c1-f58bc8722b4e",
      "migrations_dir": "migrations"
    }
  ],

  "kv_namespaces": [
    // Tokens de sesión de corta vida. No van a D1 a propósito.
    // ADVERTENCIA: mc-25 NO pudo confirmar la residencia de datos de Workers
    // KV. Hasta verificarlo con Cloudflare, aquí solo van tokens efímeros —
    // nunca datos personales de un menor de la UE o el Reino Unido.
    {
      "binding": "SESSION_KV",
      "id": "c7157f96cd7d478ca8bd0190ef396239"
    },
    // Feature flags y caché del catálogo de contenido.
    {
      "binding": "CONFIG_KV",
      "id": "76bfad78247544bbb8fbd447a06ad933"
    }
  ],

  "r2_buckets": [
    // Arte de la Sabana, imágenes y audio de los ítems.
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "math-challenge-media"
    },
    // Archivo frío de intentos vencidos y exportaciones COPPA/GDPR.
    {
      "binding": "EXPORTS_BUCKET",
      "bucket_name": "math-challenge-exports"
    }
  ],

  // Telemetría por intento. NO va a D1: D1 topa en 10 GB por base y sería la
  // primera pared que golpeamos (mc-32, riesgo #1). El dataset no se crea con
  // comando: aparece la primera vez que un Worker le escribe.
  // Service binding hacia math-challenge-ingest. Esto es el RPC nativo de
  // D-030: el Worker llamado corre en el MISMO hilo del mismo servidor y la
  // llamada normalmente ni siquiera cruza una red. Latencia añadida: cero.
  "services": [
    {
      "binding": "INGEST",
      "service": "math-challenge-ingest",
      "entrypoint": "Ingest"
    }
  ],

  // ── El limitador de tasa (criterio #113) ─────────────────────────────────
  //
  // Un contador necesita leer y escribir sin carrera. KV es eventualmente
  // consistente y admite UNA escritura por segundo por llave: dos peticiones
  // simultáneas leerían el mismo valor y el contador subiría de uno en uno
  // mientras el atacante manda diez. Un Durable Object serializa, y es la única
  // primitiva de Cloudflare que da un contador que no miente.
  //
  // UNA instancia por (acción, IP), jamás una global: un objeto global
  // serializaría todo el tráfico del producto en un solo hilo (mc-32, D-030).
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      },
      {
        // math-challenge-learner-do — el estado vivo del modelo adaptativo,
        // UN OBJETO POR NIÑO (`idFromName(child_profile_id)`). Ver
        // `apps/web/src/lib/aprendiz.ts` y docs/infrastructure.md.
        "name": "LEARNER_DO",
        "class_name": "Aprendiz"
      },
      {
        // math-challenge-league-do — el estado vivo de UNA liga de ~30,
        // UN OBJETO POR COHORTE (`idFromName(cohort_id)`). Ver
        // `apps/web/src/lib/liga-do.ts` y docs/infrastructure.md.
        //
        // Guarda estado DERIVADO —puntos de la semana, días activos— y jamás el
        // intento crudo, que va a `math-challenge-attempts-ae` (mc-32 riesgo #1).
        "name": "LEAGUE_DO",
        "class_name": "Liga"
      },
      {
        // math-challenge-classroom-do — el estado vivo de UN grupo infantil,
        // UN OBJETO POR GRUPO (`idFromName(group_id)`). F9, D-098. Ver
        // `apps/web/src/lib/classroom-do.ts` y docs/infrastructure.md.
        //
        // Misma regla que la liga: estado derivado (puntos y racha YA
        // calculados, alias y avatar para difundir sin ir a D1), jamás el
        // intento crudo. La vista ordenada excluye a los miembros sin
        // `leaderboard_opt_in` (D-087) y el filtro vive dentro del objeto.
        "name": "CLASSROOM_DO",
        "class_name": "Salon"
      },
      {
        // math-challenge-missions-do — las misiones del día de UN niño,
        // UN OBJETO POR NIÑO (`idFromName(child_profile_id)`), separado del de
        // F4 por el argumento estructural de D-027 (#224). Ver
        // `apps/web/src/lib/missions-do.ts` y docs/infrastructure.md.
        //
        // Guarda el estado DERIVADO del día —misiones, progreso, XP otorgado—
        // y jamás el intento crudo, que va a `math-challenge-attempts-ae`
        // (mc-32 riesgo #1). D1 (`mission_daily_summary`) es su rollup de
        // lectura, no un segundo escritor.
        "name": "MISSIONS_DO",
        "class_name": "Misiones"
      }
    ]
  },

  // Las migraciones de Durable Objects NO son las de D1: declaran qué clases
  // existen. Sin esta entrada el despliegue falla con «class not found».
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    },
    {
      // Una migración de DO es INMUTABLE una vez desplegada: no se edita la v1
      // para añadir una clase, se agrega una etiqueta nueva. Editar la v1 deja
      // el despliegue rechazado con «migration tag mismatch».
      "tag": "v2",
      "new_sqlite_classes": ["Aprendiz"]
    },
    {
      // F7 #242. Etiqueta nueva, no una edición de la v2: una migración de DO
      // ya desplegada es inmutable y editarla deja el despliegue rechazado con
      // «migration tag mismatch».
      "tag": "v3",
      "new_sqlite_classes": ["Liga"]
    },
    {
      // F7 #224. Etiqueta nueva por la misma razón que la v3: jamás se edita
      // una migración de DO ya desplegada.
      "tag": "v4",
      "new_sqlite_classes": ["Misiones"]
    },
    {
      // F9 #379. La v4 es de `Misiones` y ya está desplegada (inmutable): el
      // salón entra como etiqueta NUEVA v5, nunca una edición de la v4.
      "tag": "v5",
      "new_sqlite_classes": ["Salon"]
    }
  ],

  // ─── Correo saliente (issue #313) ─────────────────────────────────────────
  //
  // `mail.kilowatto.com`, dado de alta en Cloudflare Email Service el
  // 2026-08-02: envía a CUALQUIER destinatario, no solo a direcciones
  // verificadas. Email Routing —que es otra cosa— solo recibiría.
  //
  // **La reputación ya está «At Risk» y eso condiciona quién puede usar este
  // binding.** Con 10 envíos de prueba y 1 rebote, la tasa está en 10% contra
  // un umbral de riesgo del 5%, y Cloudflare **pausa el envío de la cuenta**
  // si no baja. Un endpoint que mande a la dirección que alguien tecleó es una
  // máquina de generar rebotes: el reseteo de contraseña SOLO puede escribir a
  // direcciones que ya estén en `users`, y aun así tiene que responder lo mismo
  // exista o no la cuenta. El razonamiento completo está en el issue #313.
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ],

  "analytics_engine_datasets": [
    {
      "binding": "ATTEMPTS_AE",
      "dataset": "math-challenge-attempts-ae"
    },
    {
      // Core Web Vitals de campo, medidos por nosotros (D-037). Nunca desde una
      // superficie de niño: el script no se carga ahí y el endpoint lo rechaza.
      "binding": "VITALS_AE",
      "dataset": "math-challenge-vitals-ae"
    },
    {
      // El embudo de activación (criterio #122). Mide al ADULTO: registro,
      // primer perfil, primer dispositivo marcado. NUNCA a un niño — D-037 y
      // línea roja #2, y `audits/telemetria-infantil.mjs` lo hace cumplir.
      "binding": "FUNNEL_AE",
      "dataset": "math-challenge-funnel-ae"
    },
    {
      // Uso y costo del tutor en vivo (F6 #136). Índice `banda|locale|modelo`,
      // y NUNCA el perfil — ni siquiera hasheado.
      //
      // El inventario decía literalmente «per-child, per-model» y era falso de
      // dos maneras a la vez: contradice la línea roja #2, y Analytics Engine
      // retiene tres meses y **no borra bajo demanda** (`mc-32` riesgo #7), así
      // que lo que entrara ahí no saldría cuando un padre ejerciera su derecho.
      // El renglón está corregido en docs/infrastructure.md en este mismo PR.
      // El contador POR perfil vive en el Durable Object, siete días, y sí se
      // borra.
      "binding": "TUTOR_AE",
      "dataset": "math-challenge-tutor-usage-ae"
    }
  ],

  // ── Workers AI (F6 #136, D-035) ──────────────────────────────────────────
  //
  // D-035 movió toda la inferencia a Workers AI y el dueño la amplió el mismo
  // día: «solo vamos a trabajar con Cloudflare, es una decisión tomada». No
  // queda ningún camino a la API de Claude, y por eso este binding sustituye a
  // la `ANTHROPIC_BASE_URL` que el inventario todavía nombraba.
  //
  // El binding NO crea ningún objeto de cuenta: Workers AI se factura por uso.
  // Lo que sí es un objeto y **todavía no está creado** es el AI Gateway
  // `math-challenge-tutor-gateway`, que es la red de seguridad en DÓLARES. El
  // Worker lo usa solo si `AI_GATEWAY_ID` está definido; sin él llama directo,
  // y el tope por perfil lo sigue haciendo cumplir el Durable Object, que es
  // donde el plan de F6 §5.1 lo puso. Ver docs/infrastructure.md.
  //
  // `TUTOR_PD_SECRET` es un SECRETO (`wrangler secret put`), jamás una var:
  // es la sal del HMAC con el que se deriva el seudónimo diario del perfil. Sin
  // él no se llama al modelo en absoluto — sin `pd` no hay contador por perfil,
  // y un camino en vivo sin tope no se enciende.
  "ai": {
    "binding": "AI"
  },

  // ── Los crones del padre: recordatorio push (F7) y reportes (F8) ─────────
  //
  // `*/30 * * * *` — el recordatorio push (F7 #207, D-105). La hora exacta la
  // decide el motor puro (`packages/motor/src/recordatorio.ts`) por hogar y en
  // la zona de `users.timezone`: la primera pasada a partir del inicio de la
  // ventana de pantalla —o de las 17:00 locales si no hay— y nunca fuera de
  // 07:00-20:00. El tope de UN push al día por hogar se persiste en D1
  // (`push_recordatorio.last_sent_local_date`), así que la frecuencia del cron
  // no puede convertirse en más de un empujón al día aunque falle el reloj.
  //
  // `0 * * * *` — los reportes por correo (F8 #289). Cada hora, porque la hora
  // de envío es LOCAL del hogar (`parent_report_settings.send_hour_local`,
  // 7..20, en `users.timezone`): un disparo semanal fijo en UTC golpearía
  // distinto a cada mercado. La decisión la toma el motor puro
  // (`packages/motor/src/reportes.ts::decidirEnvioReporte`); este handler solo
  // enumera y encola, nunca renderiza ni envía inline.
  //
  // Los dos viven aquí y no en `math-challenge-ingest` (que ya tiene el cron
  // semanal del ciclo de liga): la suscripción, el copy, la clave pública
  // VAPID, la preferencia de cadencia y el binding `EMAIL` son todos de la
  // superficie del padre, que es ESTE Worker. Justificación completa en
  // `apps/web/src/worker.ts` y en los PR de #207 y #289.
  //
  // Sin `VAPID_PRIVATE_KEY` (secreto, `wrangler secret put`) y
  // `VAPID_PUBLIC_KEY` (var, la instala el orquestador) el ciclo de push corre
  // y no envía nada; sin la cola de reportes creada, el ciclo de correo corre
  // y no encola nada. Degradación silenciosa: el estado seguro por defecto.
  "triggers": { "crons": ["*/30 * * * *", "0 * * * *"] },

  // ── La cola de los reportes por correo (F8 #289) ─────────────────────────
  //
  // Fan-out por hogar: un mensaje por cuenta de adulto elegible. El consumidor
  // construye el reporte, renderiza la plantilla del locale del padre y envía
  // con el binding `EMAIL`. Lote de 10, tres reintentos, y lo que agota los
  // tres va a `math-challenge-reports-dlq` — una dirección suprimida NO se
  // reintenta (el consumidor la detecta y apaga la cadencia del hogar: la
  // reputación del remitente ya está «At Risk», insistir sobre un rebote es
  // cómo se hunde del todo).
  //
  // **Las colas se crean a mano antes del primer despliegue con este config:**
  //
  //     npx wrangler queues create math-challenge-reports-queue
  //     npx wrangler queues create math-challenge-reports-dlq
  //
  // Sin ellas, el ciclo degrada en silencio (enumera, no encola, no rompe) —
  // el estado seguro por defecto hasta que el orquestador las cree.
  "queues": {
    "producers": [
      {
        "binding": "REPORTES_QUEUE",
        "queue": "math-challenge-reports-queue"
      }
    ],
    "consumers": [
      {
        "queue": "math-challenge-reports-queue",
        "max_batch_size": 10,
        "max_retries": 3,
        "dead_letter_queue": "math-challenge-reports-dlq"
      }
    ]
  },

  "vars": {
    // Los siete locales. No cinco: es-MX y es-ES no comparten separador
    // decimal, pt-BR y pt-PT no comparten escala numérica (mc-34, D-022).
    "SUPPORTED_LOCALES": "en,es-MX,es-ES,fr-FR,pt-BR,pt-PT,de-DE",
    "DEFAULT_LOCALE": "en",
    // F6 #136: cinturón de seguridad en dólares delante de Workers AI. El
    // límite pedagógico por perfil sigue en el Durable Object; este Gateway
    // autentica la llamada, no conserva prompts ni respuestas y no cachea
    // explicaciones de menores.
    "AI_GATEWAY_ID": "math-challenge-tutor-gateway",
    // La llave PÚBLICA VAPID del recordatorio push (#207). Es pública por
    // diseño — viaja al navegador al suscribirse—; la privada vive en
    // `wrangler secret` (VAPID_PRIVATE_KEY) y jamás en este archivo.
    "VAPID_PUBLIC_KEY": "BOqS4OJe3jRq20yVRfAMRO6HI-h3EmD_aXLAq60r7dvk-q8V_QLrlD3unX9ITIXmm86d663-RqDDimsXowePaqg"
  }

  // Pendientes de fases posteriores, deliberadamente ausentes para que wrangler
  // no falle contra objetos que no existen todavía:
  //   F6  math-challenge-tutor-gateway   (AI Gateway — red de seguridad en
  //                                       dólares del tutor. NO es «delante de
  //                                       Claude»: D-035 quitó ese camino. El
  //                                       tope por perfil ya no depende de él,
  //                                       vive en el Durable Object)
  //
  // Quien cree cualquiera de ellos escribe su renglón en la bitácora de
  // docs/infrastructure.md EN EL MISMO PR (CLAUDE.md § Cloudflare).
}
